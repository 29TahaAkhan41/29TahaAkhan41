# Nehir kod üreticisi — Nehir ile yazılmış.
#
# nehir.py içindeki `KodÜretici` sınıfının karşılığıdır: ayrıştırıcının kurduğu
# sözdizimi ağacından x86-64 assembly üretir. Kendi kendini derleyen derleyicinin
# üçüncü aşaması. Ürettiği assembly, Python'daki derleyicinin ürettiğiyle bayt bayt
# aynıdır.
#
# Taşıma parça parça yapılıyor. Henüz taşınmamış bir yapıyla karşılaşınca
# "henüz desteklenmiyor" der ve 3 koduyla çıkar. Şu an desteklenenler:
#   - sayılar, metinler, doğru/yanlış, değişkenler (sayı ve metin türünde)
#   - + - * / % ve karşılaştırmalar, ve / veya / değil, tekli eksi; metin + metin
#   - hedefler: yazdır, değişken, ortak, eğer/değilse, iken, çatal; dur, devam
#   - işlevler: parametreler, yerel değişkenler, döndür, özyineleme; dönüş türü
#     çıkarımı ve "sonuna değer döndürmeden ulaşılabiliyor" denetimi
#   - listeler: yazım, dizin, elemana yazma, her, + ve ==; metin üzerinde her
#   - sözlükler: yazım, okuma, yazma, her, var/sil/anahtarlar/değerler/uzunluk
#   - bütün yerleşik işlevler
#   - kayıtlar: tanım (alan türü yazımları dahil), kurma, alan okuma ve yazma, yok
# Henüz yok: modüller, işlev değerleri; derleyici uyarıları.
#
#   kullan "kod_uretici.nehir"
#   l_dosya -> dosya_oku -> sözcükle
#   program() -> üret(çalışma_zamanı_metni) -> dosya_yaz("program.s")

kullan "ayristirici.nehir"

# Yerleşik işlevler: her yazımın (Türkçe, ASCII, İngilizce) asıl adı. Bu adlara akan
# değer işleve argüman olur. nehir.py'deki YERLEŞİKLER ile aynı olmalı.
{
    "uzunluk": "uzunluk", "len": "uzunluk", "ekle": "ekle", "push": "ekle", "aralık": "aralık",
    "aralik": "aralık", "range": "aralık", "metne": "metne", "str": "metne", "sayıya": "sayıya",
    "sayiya": "sayıya", "num": "sayıya", "dilim": "dilim", "slice": "dilim", "bul": "bul",
    "find": "bul", "sil": "sil", "remove": "sil", "böl": "böl", "bol": "böl", "split": "böl",
    "birleş": "birleş", "birles": "birleş", "join": "birleş", "var": "var", "has": "var",
    "anahtarlar": "anahtarlar", "keys": "anahtarlar", "değerler": "değerler",
    "degerler": "değerler", "values": "değerler", "dosya_oku": "dosya_oku",
    "read_file": "dosya_oku", "dosya_yaz": "dosya_yaz", "write_file": "dosya_yaz",
    "dosya_ekle": "dosya_ekle", "append_file": "dosya_ekle", "dosya_var": "dosya_var",
    "file_exists": "dosya_var", "dosya_sil": "dosya_sil", "delete_file": "dosya_sil",
    "argümanlar": "argümanlar", "argumanlar": "argümanlar", "args": "argümanlar", "çık": "çık",
    "cik": "çık", "exit": "çık", "uyar": "uyar", "warn": "uyar", "baytlar": "baytlar",
    "bytes": "baytlar", "oku": "oku", "read": "oku", "girdi_var": "girdi_var",
    "has_input": "girdi_var"
} -> YERLEŞİK_ADLAR

# Çalışma zamanında hata verebilen işlemler; öncesinde r15'e kaynak satırı yüklenir.
# nehir.py'deki RİSKLİ ile aynı olmalı.
{
    "call __aralik": 1, "call __argumanlar": 1, "call __ayir": 1, "call __dosya_oku": 1,
    "call __dosya_sil": 1, "call __dosya_yaz": 1, "call __liste_al": 1,
    "call __liste_birles": 1, "call __liste_birlestir": 1, "call __liste_dilim": 1,
    "call __liste_ekle": 1, "call __liste_koy": 1, "call __liste_sil": 1,
    "call __liste_yeni": 1, "call __metin_al": 1, "call __metin_baytlar": 1,
    "call __metin_birlestir": 1, "call __metin_bol": 1, "call __metin_dilim": 1,
    "call __metin_karakter": 1, "call __metinden_sayi": 1, "call __oku": 1,
    "call __sayidan_metin": 1, "call __sozluk_al": 1, "call __sozluk_koy": 1,
    "call __sozluk_liste": 1, "call __sozluk_sil": 1, "call __sozluk_yeni": 1,
    "jz __sifira_bolme": 1, "jz __yok_hatasi": 1
} -> RİSKLİ

{"==": "sete", "!=": "setne", "<": "setl", ">": "setg", "<=": "setle", ">=": "setge"} -> KARŞILAŞTIRMA

# Yığın için ayrılan bellek (bayt). nehir.py'deki YIĞIN_BOYUTU ile aynı olmalı.
"268435456" -> YIĞIN_BOYUTU

# ── türler ──
# Türler metin olarak tutulur: "sayı", "metin", listeler için "[sayı]", "[[metin]]",
# sözlükler için "{metin:sayı}", kayıtlar için "@Nokta" (ada göre) ve henüz bilinmeyen
# bir tür için "?1", "?2", ... `yok` değerinin türü, yalnızca bir kayıt türüne
# bağlanabilen bir bilinmeyendir (k_yok'ta işaretli). Bilinmeyen bir tür öğrenildiğinde
# k_bağ'a yazılır (birleştirme); "[?5]" gibi bir tür de böylece kendiliğinden
# "[sayı]"ya çözülür. Bilinmeyenler boş listelerde ve özyinelemeli işlevlerin dönüş
# türünde doğar.

{} -> k_bağ
{} -> k_yok                 # yalnızca kayıt olabilen bilinmeyenler
0 -> ortak k_tür_no

işlev yeni_tür_değişkeni() {
    k_tür_no + 1 -> k_tür_no
    "?" + metne(k_tür_no) -> döndür
}

işlev bilinmeyen_mi(t) { dilim(t, 0, 1) == "?" -> döndür }
işlev liste_mi(t) { dilim(t, 0, 1) == "[" -> döndür }
işlev kayıt_mı(t) { dilim(t, 0, 1) == "@" -> döndür }
işlev kayıt_adı(t) { dilim(t, 1, uzunluk(t)) -> döndür }
işlev yok_mu(t) { var(k_yok, t) -> döndür }
# Bir kayıt ya da `yok` mu? (t çözülmüş olmalı)
işlev kayıtsı(t) { kayıt_mı(t) veya (bilinmeyen_mi(t) ve yok_mu(t)) -> döndür }
işlev eleman_türü(t) { dilim(t, 1, uzunluk(t) - 1) -> döndür }
işlev liste_türü(t) { "[" + t + "]" -> döndür }

işlev sözlük_mi(t) { dilim(t, 0, 1) == "{" -> döndür }
işlev sözlük_türü(anahtar, değer) { "{" + anahtar + ":" + değer + "}" -> döndür }

# "{K:V}" içinde anahtarı değerden ayıran ':'in yeri; iç içe türlerdeki ':'ler atlanır.
işlev sözlük_ayracı(t) {
    0 -> derinlik
    0 -> i
    t -> her (k) {
        i > 0 -> eğer {
            k == "[" veya k == "{" -> eğer { derinlik + 1 -> derinlik }
            k == "]" veya k == "}" -> eğer { derinlik - 1 -> derinlik }
            k == ":" ve derinlik == 0 -> eğer { i -> döndür }
        }
        i + 1 -> i
    }
}
işlev anahtar_kısmı(t) { dilim(t, 1, sözlük_ayracı(t)) -> döndür }
işlev değer_kısmı(t) { dilim(t, sözlük_ayracı(t) + 1, uzunluk(t) - 1) -> döndür }

işlev sözlük_içerir(t) {
    çöz(t) -> t
    sözlük_mi(t) -> eğer { doğru -> döndür }
    liste_mi(t) -> eğer { sözlük_içerir(eleman_türü(t)) -> döndür }
    yanlış -> döndür
}

# Bilinmeyen v, t'nin içinde geçiyor mu? (Bir liste kendi elemanı olamaz.)
işlev içerir(t, v) {
    çöz(t) -> t
    t == v -> eğer { doğru -> döndür }
    liste_mi(t) -> eğer { içerir(eleman_türü(t), v) -> döndür }
    sözlük_mi(t) -> eğer { içerir(anahtar_kısmı(t), v) veya içerir(değer_kısmı(t), v) -> döndür }
    yanlış -> döndür
}

işlev çöz(t) {
    bilinmeyen_mi(t) ve var(k_bağ, t) -> iken { k_bağ[t] -> t }
    t -> döndür
}

işlev birleştir(a, b) {
    çöz(a) -> a
    çöz(b) -> b
    a == b -> eğer { doğru -> döndür }
    bilinmeyen_mi(a) veya bilinmeyen_mi(b) -> eğer {
        # Bağlanacak bilinmeyen: önce b; ikisi de bilinmeyense ve a yalnızca kayıt
        # olabiliyorsa a (kısıt korunur).
        b -> bağlanan
        a -> öteki
        değil bilinmeyen_mi(b) veya (bilinmeyen_mi(a) ve yok_mu(a)) -> eğer {
            a -> bağlanan
            b -> öteki
        }
        yok_mu(bağlanan) -> eğer {
            bilinmeyen_mi(öteki) -> eğer { 1 -> k_yok[öteki] } değilse {
                değil kayıt_mı(öteki) -> eğer { yanlış -> döndür }
            }
        }
        içerir(öteki, bağlanan) -> eğer { yanlış -> döndür }
        öteki -> k_bağ[bağlanan]
        doğru -> döndür
    }
    liste_mi(a) ve liste_mi(b) -> eğer { birleştir(eleman_türü(a), eleman_türü(b)) -> döndür }
    sözlük_mi(a) ve sözlük_mi(b) -> eğer {
        birleştir(anahtar_kısmı(a), anahtar_kısmı(b)) ve birleştir(değer_kısmı(a), değer_kısmı(b)) -> döndür
    }
    yanlış -> döndür
}

# Hata mesajlarındaki yazımı. nehir.py'de bilinmeyen bir tür, bağlanmış olsa da
# kendi adıyla yazılır; ham_ad bunu, tür_adı çözülmüş hâlini verir.
işlev ham_ad(t) {
    bilinmeyen_mi(t) -> eğer {
        yok_mu(t) -> eğer { "yok" -> döndür }
        "henüz bilinmeyen tür" -> döndür
    }
    kayıt_mı(t) -> eğer { kayıt_adı(t) -> döndür }
    liste_mi(t) -> eğer {
        çöz(eleman_türü(t)) -> el
        bilinmeyen_mi(el) -> eğer { "boş liste" -> döndür }
        ham_ad(el) + " listesi" -> döndür
    }
    sözlük_mi(t) -> eğer {
        çöz(anahtar_kısmı(t)) -> a
        çöz(değer_kısmı(t)) -> v
        bilinmeyen_mi(a) veya bilinmeyen_mi(v) -> eğer { "boş sözlük" -> döndür }
        ham_ad(a) + " → " + ham_ad(v) + " sözlüğü" -> döndür
    }
    t -> döndür
}

# nehir.py'de kabın içindeki henüz bilinmeyen tür "None" diye yazılır.
işlev bilinen_adı(t) {
    çöz(t) -> t
    bilinmeyen_mi(t) -> eğer { "None" -> döndür }
    ham_ad(t) -> döndür
}
işlev tür_adı(t) { ham_ad(çöz(t)) -> döndür }

işlev tür_listesi(türler) {
    [] -> adlar
    türler -> her (t) { adlar -> ekle(tür_adı(t)) }
    birleş(adlar, ", ") -> döndür
}
işlev ham_listesi(türler) {
    [] -> adlar
    türler -> her (t) { adlar -> ekle(ham_ad(t)) }
    birleş(adlar, ", ") -> döndür
}

# ── durum ──

[] -> ortak k_kod           # o anda derlenen gövdenin assembly satırları
[] -> k_işlev_kodu          # derlenmiş işlevlerin satırları, derlenme sırasıyla
[] -> k_metinler            # programdaki metinler, ilk görülme sırasıyla
{} -> k_metin_no            # metin -> k_metinler'deki sırası
[] -> k_küreseller          # üst düzey değişkenlerin adları, toplanma sırasıyla
{} -> k_küresel_etiket      # ad -> bellekteki yerinin etiketi (g0, g1, ...)
{} -> k_küresel_tür         # ad -> tür ("" henüz değer akmadı)
{} -> k_ortaklar            # işlevlerin de atayabildiği üst düzey değişkenler
[] -> k_tür_tanımları       # çalışma zamanı tür tanımları (yazdırma için)
{} -> k_tür_etiketi         # tanım alanları -> etiketi (t0, t1, ...)
0 -> ortak k_etiket_no      # son üretilen .L etiketinin numarası
0 -> ortak k_çatal          # o anda yığında bekleyen çatal değerlerinin sayısı

# İç içe döngüler (koşut listeler): devam ve çıkış etiketleri, girildiği andaki çatal derinliği
[] -> ortak k_döngü_devam
[] -> ortak k_döngü_son
[] -> ortak k_döngü_çatal

# İşlevler. Her işlev ilk çağrıldığı yerde, o çağrının argüman türleriyle derlenir.
{} -> k_işlev               # ad -> işlev düğümü
[] -> k_işlev_adları        # tanım sırasıyla
{} -> k_işlev_etiket        # ad -> f0, f1, ...
{} -> k_işlev_türler        # ad -> parametre türleri (ilk çağrıda belirlenir)
{} -> k_işlev_dönüş         # ad -> dönüş türü ("" henüz belli değil)
{} -> k_işlev_durum         # ad -> 0 derlenmedi, 1 derleniyor, 2 derlendi
{} -> k_işlev_sona          # ad -> gövdenin sonuna ulaşılabiliyor mu
{} -> k_dönmeyen            # hiç geri dönmeyen işlevler (her yolu çık'a varır)

# Kayıtlar: alan adları ve türleri (tanımdan ya da kullanımdan öğrenilir)
{} -> k_kayıt_alanları      # ad -> [alan adları]
{} -> k_kayıt_türleri       # ad -> [alan türleri]
{} -> k_kayıt_etiketi       # ad ("" yok için) -> çalışma zamanı tanımının etiketi (kt0, ...)

# Derlenmekte olan işlev ("" ise en üst düzey) ve onun yerel değişkenleri
"" -> ortak k_geçerli
{} -> ortak k_yerel_yer     # ad -> bellek adresi ([rbp+16], [rbp-8], ...)
{} -> ortak k_yerel_tür     # ad -> tür
0 -> ortak k_yerel_sayısı
{} -> ortak k_okunan        # bu işlevde okunan üst düzey değişkenler

# ── yardımcılar ──

işlev k_hata(mesaj, d) { hata_yer(mesaj, d.satır, d.sütun) }

işlev desteklenmiyor(ne, d) {
    l_dosya + ":" + metne(d.satır) + ":" + metne(d.sütun) + ": henüz desteklenmiyor: " + ne -> uyar
    çık(3)
}

işlev yaz(satır) { k_kod -> ekle("    " + satır) }
işlev etiket_koy(etiket) { k_kod -> ekle(etiket + ":") }

# Türü sonradan belli olabilecek bir değerin tür tanımının adresi yazmaca (rsi ya
# da rdx) yüklenir. Etiket derlemenin sonunda konur; o zamana dek satırda işaret durur.
işlev tür_satırı(yazmaç, tür) { k_kod -> ekle("§TÜR§" + yazmaç + tür) }

# Hata verebilen çalışma zamanı işlemlerinden önce r15'e d'nin kaynak satırı yüklenir.
işlev komut(satır, d) {
    RİSKLİ -> var(satır) -> eğer { yaz("mov r15, " + metne(d.satır)) }
    yaz(satır)
}

işlev yeni_etiket() {
    k_etiket_no + 1 -> k_etiket_no
    ".L" + metne(k_etiket_no) -> döndür
}

işlev metin_etiketi(m) {
    değil var(k_metin_no, m) -> eğer {
        uzunluk(k_metinler) -> k_metin_no[m]
        k_metinler -> ekle(m)
    }
    "m" + metne(k_metin_no[m]) -> döndür
}

# Türün çalışma zamanı tanımı: {kod, 1. parametre, 2. parametre}; kod 0 sayı, 1 metin,
# 2 liste (eleman), 3 sözlük (anahtar, değer).
# Hiç belli olmamış tür (boş listenin elemanı) sayı sayılır.
işlev tür_etiketi(tür) {
    çöz(tür) -> tür
    kayıtsı(tür) -> eğer { kayıt_etiketi(tür) -> döndür }
    "0, 0, 0" -> alanlar
    tür == "metin" -> eğer { "1, 0, 0" -> alanlar }
    liste_mi(tür) -> eğer { "2, " + tür_etiketi(eleman_türü(tür)) + ", 0" -> alanlar }
    sözlük_mi(tür) -> eğer {
        tür_etiketi(anahtar_kısmı(tür)) -> a
        "3, " + a + ", " + tür_etiketi(değer_kısmı(tür)) -> alanlar
    }
    değil var(k_tür_etiketi, alanlar) -> eğer {
        "t" + metne(uzunluk(k_tür_etiketi)) -> etiket       # kayıt tanımları (kt) ayrı sayılır
        etiket -> k_tür_etiketi[alanlar]
        k_tür_tanımları -> ekle(etiket + ": .quad " + alanlar)
    }
    k_tür_etiketi[alanlar] -> döndür
}

# Kaydın tanımı: {4, ad, alan sayısı, (alan adı, alan türü tanımı)...}. Etiket, alan
# türleri işlenmeden önce verilir ki kendine gönderme yapan kayıtlar onu bulabilsin;
# tanım satırı alanlarınkinden sonra eklenir. Türü hiç belli olmamış `yok` alansızdır.
işlev kayıt_etiketi(tür) {
    "" -> ad
    kayıt_mı(tür) -> eğer { kayıt_adı(tür) -> ad }
    değil var(k_kayıt_etiketi, ad) -> eğer {
        "kt" + metne(uzunluk(k_kayıt_etiketi)) -> etiket    # "k0" bir yazmaç adıdır
        etiket -> k_kayıt_etiketi[ad]
        "yok" -> görünen
        ad != "" -> eğer { ad -> görünen }
        ["4", metin_etiketi(görünen)] -> parçalar
        ad == "" -> eğer { parçalar -> ekle("0") } değilse {
            k_kayıt_alanları[ad] -> alanlar
            parçalar -> ekle(metne(uzunluk(alanlar)))
            0 -> i
            i < uzunluk(alanlar) -> iken {
                parçalar -> ekle(metin_etiketi(alanlar[i]))
                parçalar -> ekle(tür_etiketi(k_kayıt_türleri[ad][i]))
                i + 1 -> i
            }
        }
        k_tür_tanımları -> ekle(etiket + ": .quad " + birleş(parçalar, ", "))
    }
    k_kayıt_etiketi[ad] -> döndür
}

işlev sayı_olmalı(tür, ne, d) {
    çöz(tür) -> tür
    bilinmeyen_mi(tür) ve değil yok_mu(tür) -> eğer { "sayı" -> k_bağ[tür] } değilse {     # burada sayı olarak kullanılıyor
        tür != "sayı" -> eğer { k_hata(ne + " sayı olmalı, " + ham_ad(tür) + " bulundu", d) }
    }
}

# Anahtarın türünü sözlüğünkiyle eşitler ve tür kodunu edx'e yükler.
işlev anahtarı_denetle(sözlük, anahtar, d) {
    anahtar != "sayı" ve anahtar != "metin" -> eğer {
        k_hata("sözlük anahtarı sayı ya da metin olmalı, " + ham_ad(anahtar) + " bulundu", d)
    }
    değil birleştir(anahtar_kısmı(sözlük), anahtar) -> eğer {
        k_hata("bu sözlüğün anahtarları " + bilinen_adı(anahtar_kısmı(sözlük)) + "; " + anahtar + " verildi", d)
    }
    anahtar == "sayı" -> eğer { yaz("mov edx, 0") } değilse { yaz("mov edx, 1") }
}

işlev yerleşik_mi(ad) { var(YERLEŞİK_ADLAR, ad) -> döndür }
işlev çağrılabilir(ad) {
    var(k_işlev, ad) veya var(k_kayıt_alanları, ad) veya var(YERLEŞİK_ADLAR, ad) -> döndür
}

# ── kayıtlar ──

# Kayıt tanımındaki tür yazımını türe çevirir.
işlev tür_çöz(t) {
    t.tür == "tür_liste" -> eğer { liste_türü(tür_çöz(t.çocuklar[0])) -> döndür }
    t.tür == "tür_sözlük" -> eğer {
        tür_çöz(t.çocuklar[0]) -> anahtar
        anahtar != "sayı" ve anahtar != "metin" -> eğer {
            k_hata("sözlük anahtarı sayı ya da metin olmalı, " + ham_ad(anahtar) + " bulundu", t.çocuklar[0])
        }
        sözlük_türü(anahtar, tür_çöz(t.çocuklar[1])) -> döndür
    }
    t.ad == "sayı" veya t.ad == "sayi" veya t.ad == "number" -> eğer { "sayı" -> döndür }
    t.ad == "metin" veya t.ad == "text" -> eğer { "metin" -> döndür }
    var(k_kayıt_alanları, t.ad) -> eğer { "@" + t.ad -> döndür }
    k_hata("'" + t.ad + "' adında bir tür yok", t)
}

# Alanın kayıttaki sırası; tür çözülmüş olmalı.
işlev alan_sırası(tür, alan, d) {
    bilinmeyen_mi(tür) -> eğer { k_hata("'." + alan + "' alanına erişilen değerin türü henüz belli değil", d) }
    değil kayıt_mı(tür) -> eğer {
        k_hata("'." + alan + "': alanlara yalnızca kayıtlarda erişilir, " + ham_ad(tür) + " bulundu", d)
    }
    k_kayıt_alanları[kayıt_adı(tür)] -> alanlar
    0 -> i
    i < uzunluk(alanlar) -> iken {
        alanlar[i] == alan -> eğer { i -> döndür }
        i + 1 -> i
    }
    k_hata("'" + kayıt_adı(tür) + "' kaydında '" + alan + "' adında bir alan yok", d)
}

işlev alan_türü(tür, sıra) { k_kayıt_türleri[kayıt_adı(tür)][sıra] -> döndür }

işlev parametre_sayısı(f) { uzunluk(f.çocuklar) - 1 -> döndür }
işlev gövdesi(f) { f.çocuklar[uzunluk(f.çocuklar) - 1] -> döndür }
işlev hedefleri(d) { dilim(d.çocuklar, 1, uzunluk(d.çocuklar)) -> döndür }

# ── değişkenler ──

işlev yerel_mi(ad) { k_geçerli != "" ve var(k_yerel_yer, ad) -> döndür }
işlev değişken_var_mı(ad) { yerel_mi(ad) veya var(k_küresel_etiket, ad) -> döndür }

işlev değişken_adresi(ad) {
    yerel_mi(ad) -> eğer { k_yerel_yer[ad] -> döndür }
    "[rip+" + k_küresel_etiket[ad] + "]" -> döndür
}

işlev değişken_türü(ad) {
    yerel_mi(ad) -> eğer { k_yerel_tür[ad] -> döndür }
    k_küresel_tür[ad] -> döndür
}

işlev yerel_ekle(ad) {
    k_yerel_sayısı + 1 -> k_yerel_sayısı
    "[rbp-" + metne(8 * k_yerel_sayısı) + "]" -> k_yerel_yer[ad]
    "" -> k_yerel_tür[ad]
}

# İşlev içindeki atama yerel değişken oluşturur; tek istisna `ortak` ile tanımlanmış
# üst düzey değişkenlerdir.
işlev ata(ad, tür, d) {
    k_geçerli != "" ve değil var(k_yerel_yer, ad) ve değil var(k_ortaklar, ad) -> eğer {
        k_okunan -> var(ad) -> eğer {
            k_hata("'" + ad + "' bu işlevde üst düzey değişken olarak okundu; ona burada atanamaz", d)
        }
        yerel_ekle(ad)
    }
    değil değişken_var_mı(ad) -> eğer { yerel_ekle(ad) }
    değişken_türü(ad) -> önceki
    önceki == "" -> eğer {
        yerel_mi(ad) -> eğer { tür -> k_yerel_tür[ad] } değilse { tür -> k_küresel_tür[ad] }
    } değilse {
        değil birleştir(önceki, tür) -> eğer {
            k_hata("'" + ad + "' değişkeni " + ham_ad(önceki) + " türünde; " + tür_adı(tür) + " atanamaz", d)
        }
    }
    yaz("mov " + değişken_adresi(ad) + ", rax")
}

# ── üst düzey değişkenler ──
# En üst düzeyde (iç içe bloklar dahil) atanan her ad küresel değişkendir;
# kod üretilmeden önce hepsi toplanır.

işlev küresel(ad) {
    değil var(k_küresel_etiket, ad) -> eğer {
        "g" + metne(uzunluk(k_küreseller)) -> k_küresel_etiket[ad]
        "" -> k_küresel_tür[ad]
        k_küreseller -> ekle(ad)
    }
}

işlev küreselleri_topla(deyimler) {
    deyimler -> her (d) {
        d.tür == "akış" -> eğer { hedeflerden_topla(hedefleri(d)) }
    }
}

işlev hedeflerden_topla(hedefler) {
    hedefler -> her (h) {
        h.tür == "hedef_ad" ve uzunluk(h.çocuklar) == 0 ve değil çağrılabilir(h.ad) -> eğer {
            küresel(h.ad)
        }
        h.tür == "eğer" -> eğer { h.çocuklar -> her (b) { küreselleri_topla(b.çocuklar) } }
        h.tür == "iken" -> eğer { küreselleri_topla(h.çocuklar[0].çocuklar) }
        h.tür == "ortak" -> eğer {
            küresel(h.ad)
            1 -> k_ortaklar[h.ad]
        }
        h.tür == "her" -> eğer {
            küresel(h.ad)
            küreselleri_topla(h.çocuklar[0].çocuklar)
        }
        h.tür == "çatal" -> eğer { h.çocuklar -> her (dal) { hedeflerden_topla(dal.çocuklar) } }
    }
}

# ── akış çözümlemesi ──
# Sözdizimine bakarak denetimin bir bloğun sonuna ulaşıp ulaşamayacağını bulur.
# Temkinlidir: emin olamadığı her yerde "ulaşabilir" der.

işlev dönmez(ad) {
    var(k_işlev, ad) -> eğer { var(k_dönmeyen, ad) -> döndür }
    (ad == "çık" veya ad == "cik" veya ad == "exit") ve değil var(k_kayıt_alanları, ad) -> döndür
}

işlev tamamlanır(deyimler) {
    deyimler -> her (d) { değil deyim_tamamlanır(d) -> eğer { yanlış -> döndür } }
    doğru -> döndür
}

işlev deyim_tamamlanır(d) {
    d.tür != "akış" -> eğer { yanlış -> döndür }       # dur, devam
    d.çocuklar[0] -> kaynak
    kaynak.tür == "çağrı" ve dönmez(kaynak.ad) -> eğer { yanlış -> döndür }
    hedefler_tamamlanır(hedefleri(d), kaynak) -> döndür
}

# `kaynak` zincirin başındaki ifadedir; çatal kollarında yoktur.
işlev hedefler_tamamlanır(hedefler, kaynak) {
    hedefler -> her (h) {
        h.tür == "döndür" -> eğer { yanlış -> döndür }
        h.tür == "hedef_ad" ve dönmez(h.ad) -> eğer { yanlış -> döndür }
        h.tür == "eğer" ve uzunluk(h.çocuklar) > 1 -> eğer {
            değil tamamlanır(h.çocuklar[0].çocuklar) ve değil tamamlanır(h.çocuklar[1].çocuklar) -> eğer {
                yanlış -> döndür
            }
        }
        h.tür == "iken" -> eğer {
            # `doğru -> iken { }` yalnızca içindeki bir 'dur' ile biter.
            kaynak != yok ve uzunluk(hedefler) == 1 -> eğer {
                kaynak.tür == "sayı" ve kaynak.sayı != 0 -> eğer {
                    değil içerir_mi(h.çocuklar[0].çocuklar, "dur", yanlış) -> eğer { yanlış -> döndür }
                }
            }
        }
        h.tür == "çatal" -> eğer {
            h.çocuklar -> her (dal) {
                değil hedefler_tamamlanır(dal.çocuklar, yok) -> eğer { yanlış -> döndür }
            }
        }
    }
    doğru -> döndür
}

# Blokta (iç içe bloklar dahil) 'döndür' hedefi ya da 'dur' deyimi var mı?
# 'dur' aranırken iç döngülere girilmez: oradaki 'dur' o döngüye aittir.
işlev içerir_mi(deyimler, aranan, döngülere_gir) {
    deyimler -> her (d) {
        d.tür == aranan -> eğer { doğru -> döndür }
        d.tür == "akış" -> eğer {
            hedefte_var(hedefleri(d), aranan) -> eğer { doğru -> döndür }
            alt_bloklarda_var(hedefleri(d), aranan, döngülere_gir) -> eğer { doğru -> döndür }
        }
    }
    yanlış -> döndür
}

işlev hedefte_var(hedefler, aranan) {
    hedefler -> her (h) {
        h.tür == aranan -> eğer { doğru -> döndür }
        h.tür == "çatal" -> eğer {
            h.çocuklar -> her (dal) { hedefte_var(dal.çocuklar, aranan) -> eğer { doğru -> döndür } }
        }
    }
    yanlış -> döndür
}

işlev alt_bloklarda_var(hedefler, aranan, döngülere_gir) {
    hedefler -> her (h) {
        h.tür == "eğer" -> eğer {
            h.çocuklar -> her (b) { içerir_mi(b.çocuklar, aranan, döngülere_gir) -> eğer { doğru -> döndür } }
        }
        (h.tür == "iken" veya h.tür == "her") ve döngülere_gir -> eğer {
            içerir_mi(h.çocuklar[0].çocuklar, aranan, döngülere_gir) -> eğer { doğru -> döndür }
        }
        h.tür == "çatal" -> eğer {
            h.çocuklar -> her (dal) {
                alt_bloklarda_var(dal.çocuklar, aranan, döngülere_gir) -> eğer { doğru -> döndür }
            }
        }
    }
    yanlış -> döndür
}

# Hiç dönmeyen işlevler: gövdesinin sonuna ulaşılamayan ve hiç 'döndür' içermeyen
# işlevler. Birbirlerini çağırabildikleri için küme, değişmeyene dek yeniden hesaplanır.
işlev dönmeyenleri_bul() {
    doğru -> değişti
    değişti -> iken {
        yanlış -> değişti
        k_işlev_adları -> her (ad) {
            gövdesi(k_işlev[ad]).çocuklar -> gövde
            değil var(k_dönmeyen, ad) ve değil içerir_mi(gövde, "döndür", doğru) ve değil tamamlanır(gövde) -> eğer {
                1 -> k_dönmeyen[ad]
                doğru -> değişti
            }
        }
    }
}

# ── işlevler ──

işlev çağır(ad, arg_düğümleri, d, akan) {
    # Akan değer (varsa) çağıran tarafından zaten yığına itilmiştir ve ilk argümandır.
    [] -> türler
    akan != "" -> eğer { türler -> ekle(akan) }
    arg_düğümleri -> her (a) {
        türler -> ekle(ifade_üret(a))
        yaz("push rax")
    }
    değişken_var_mı(ad) -> eğer {
        değişken_türü(ad) -> dt
        dt != "" -> eğer {
            çöz(dt) -> dt
            bilinmeyen_mi(dt) ve değil yok_mu(dt) -> eğer { desteklenmiyor("işlev değeri üzerinden çağrı", d) }
            k_hata("'" + ad + "' bir değişken (" + ham_ad(dt) + "), işlev değil", d)
        }
    }
    var(k_kayıt_alanları, ad) -> eğer {
        k_kayıt_alanları[ad] -> alanlar
        k_kayıt_türleri[ad] -> alan_türleri
        uzunluk(alanlar) != uzunluk(türler) -> eğer {
            k_hata("'" + ad + "' kaydının " + metne(uzunluk(alanlar)) + " alanı var, "
                   + metne(uzunluk(türler)) + " değer verildi", d)
        }
        0 -> i
        i < uzunluk(türler) -> iken {
            değil birleştir(alan_türleri[i], türler[i]) -> eğer {
                k_hata("'" + ad + "." + alanlar[i] + "' alanı " + tür_adı(alan_türleri[i]) + " türünde; "
                       + ham_ad(türler[i]) + " verildi", d)
            }
            i + 1 -> i
        }
        uzunluk(türler) -> boy
        boy < 1 -> eğer { 1 -> boy }
        yaz("mov edi, " + metne(8 * boy))
        komut("call __ayir", d)
        uzunluk(türler) - 1 -> sıra
        sıra >= 0 -> iken {
            yaz("pop rcx")
            yaz("mov [rax+" + metne(8 * sıra) + "], rcx")
            sıra - 1 -> sıra
        }
        "@" + ad -> döndür
    }
    değil var(k_işlev, ad) -> eğer {
        YERLEŞİK_ADLAR -> var(ad) -> eğer { yerleşik_çağır(ad, türler, d) -> döndür }
        değişken_var_mı(ad) -> eğer { k_hata("'" + ad + "' bir değişken, işlev değil", d) }
        k_hata("'" + ad + "' adında bir işlev yok", d)
    }
    parametre_sayısı(k_işlev[ad]) -> beklenen
    uzunluk(türler) != beklenen -> eğer {
        k_hata("'" + ad + "' işlevi " + metne(beklenen) + " argüman bekliyor, "
               + metne(uzunluk(türler)) + " verildi", d)
    }
    değil var(k_işlev_türler, ad) -> eğer { türler -> k_işlev_türler[ad] } değilse {
        k_işlev_türler[ad] -> önceki
        0 -> i
        i < uzunluk(türler) -> iken {
            değil birleştir(önceki[i], türler[i]) -> eğer {
                k_hata("'" + ad + "' işlevi (" + tür_listesi(önceki) + ") ile çağrılmıştı; şimdi ("
                       + tür_listesi(türler) + ") veriliyor", d)
            }
            i + 1 -> i
        }
    }
    k_işlev_durum[ad] == 0 -> eğer { işlevi_derle(ad) }
    yaz("call " + k_işlev_etiket[ad])
    uzunluk(türler) > 0 -> eğer { yaz("add rsp, " + metne(8 * uzunluk(türler))) }
    k_işlev_dönüş[ad] == "" -> eğer {
        # Özyineleme: işlev hâlâ derleniyor ve henüz bir şey döndürmedi. Dönüş türü,
        # ilk 'döndür'de ya da sonucun kullanıldığı yerde belli olacak bir bilinmeyendir.
        yeni_tür_değişkeni() -> k_işlev_dönüş[ad]
    }
    k_işlev_dönüş[ad] -> döndür
}

# Yerleşik işlevler; argümanları yığına itilmiştir. `ad` yazıldığı hâlidir.
işlev yerleşik_çağır(ad, türler, d) {
    YERLEŞİK_ADLAR[ad] -> asıl
    uzunluk(türler) -> n
    "" -> t0
    "" -> t1
    "" -> t2
    n > 0 -> eğer { türler[0] -> t0 }
    n > 1 -> eğer { türler[1] -> t1 }
    n > 2 -> eğer { türler[2] -> t2 }
    liste_mi(t0) -> ilk_liste
    sözlük_mi(t0) -> ilk_sözlük
    (asıl == "var" veya asıl == "sil") ve ilk_sözlük ve n == 2 -> eğer {
        yaz("pop rsi")
        yaz("pop rdi")
        anahtarı_denetle(t0, t1, d)
        asıl == "var" -> eğer {
            komut("call __sozluk_ara", d)
            yaz("not rax")              # dizin >= 0 ise 1, -1 ise 0
            yaz("shr rax, 63")
            "sayı" -> döndür
        }
        komut("call __sozluk_sil", d)
        çöz(değer_kısmı(t0)) -> döndür
    }
    asıl == "var" -> eğer { yanlış_argüman(ad, "sözlük, anahtar", türler, d) }
    asıl == "anahtarlar" veya asıl == "değerler" -> eğer {
        n != 1 veya değil ilk_sözlük -> eğer { yanlış_argüman(ad, "sözlük", türler, d) }
        yaz("pop rdi")
        asıl == "anahtarlar" -> eğer {
            yaz("mov esi, 16")
            komut("call __sozluk_liste", d)
            liste_türü(anahtar_kısmı(t0)) -> döndür
        }
        yaz("mov esi, 24")
        komut("call __sozluk_liste", d)
        liste_türü(değer_kısmı(t0)) -> döndür
    }
    asıl == "uzunluk" -> eğer {
        n != 1 veya değil (ilk_liste veya ilk_sözlük veya t0 == "metin") -> eğer {
            yanlış_argüman(ad, "liste, sözlük ya da metin", türler, d)
        }
        ilk_liste veya ilk_sözlük -> eğer {
            yaz("pop rax")
            yaz("mov rax, [rax]")
        } değilse {
            yaz("pop rdi")
            komut("call __metin_uzunluk", d)
        }
        "sayı" -> döndür
    }
    asıl == "oku" -> eğer {
        # Akan ya da verilen metin, satır sonu eklenmeden istem olarak yazılır.
        değil (n == 0 veya (n == 1 ve t0 == "metin")) -> eğer {
            yanlış_argüman(ad, "argümansız ya da istem metni", türler, d)
        }
        n == 1 -> eğer {
            yaz("pop rsi")
            yaz("mov rdx, [rsi-8]")
            komut("call __ham_yaz", d)
        }
        komut("call __oku", d)
        "metin" -> döndür
    }
    asıl == "dosya_oku" veya asıl == "dosya_var" veya asıl == "dosya_sil" -> eğer {
        n != 1 veya t0 != "metin" -> eğer { yanlış_argüman(ad, "dosya yolu", türler, d) }
        yaz("pop rdi")
        komut("call __" + asıl, d)
        asıl == "dosya_oku" -> eğer { "metin" -> döndür }
        "sayı" -> döndür
    }
    asıl == "dosya_yaz" veya asıl == "dosya_ekle" -> eğer {
        n != 2 veya t0 != "metin" veya t1 != "metin" -> eğer { yanlış_argüman(ad, "içerik, dosya yolu", türler, d) }
        yaz("pop rsi")
        yaz("pop rdi")
        # O_WRONLY | O_CREAT ve üstüne yazmak için O_TRUNC, eklemek için O_APPEND
        asıl == "dosya_yaz" -> eğer { yaz("mov edx, 577") } değilse { yaz("mov edx, 1089") }
        komut("call __dosya_yaz", d)
        "metin" -> döndür
    }
    asıl == "baytlar" veya asıl == "uyar" -> eğer {
        n != 1 veya t0 != "metin" -> eğer { yanlış_argüman(ad, "metin", türler, d) }
        yaz("pop rdi")
        asıl == "baytlar" -> eğer {
            komut("call __metin_baytlar", d)
            "[sayı]" -> döndür
        }
        komut("call __uyar", d)
        "metin" -> döndür
    }
    asıl == "argümanlar" -> eğer {
        n != 0 -> eğer { yanlış_argüman(ad, "argümansız", türler, d) }
        komut("call __argumanlar", d)
        "[metin]" -> döndür
    }
    asıl == "çık" -> eğer {
        n != 1 veya t0 != "sayı" -> eğer { yanlış_argüman(ad, "çıkış kodu", türler, d) }
        yaz("pop rdi")
        yaz("mov eax, 60")
        yaz("syscall")
        "sayı" -> döndür
    }
    asıl == "girdi_var" -> eğer {
        n != 0 -> eğer { yanlış_argüman(ad, "argümansız", türler, d) }
        komut("call __girdi_var", d)
        "sayı" -> döndür
    }
    asıl == "metne" -> eğer {
        n != 1 veya (t0 != "sayı" ve t0 != "metin") -> eğer { yanlış_argüman(ad, "sayı", türler, d) }
        t0 == "sayı" -> eğer {
            yaz("pop rdi")
            komut("call __sayidan_metin", d)
        } değilse { yaz("pop rax") }
        "metin" -> döndür
    }
    asıl == "sayıya" -> eğer {
        n != 1 veya (t0 != "sayı" ve t0 != "metin") -> eğer { yanlış_argüman(ad, "metin", türler, d) }
        t0 == "metin" -> eğer {
            yaz("pop rdi")
            komut("call __metinden_sayi", d)
        } değilse { yaz("pop rax") }
        "sayı" -> döndür
    }
    asıl == "ekle" -> eğer {
        n != 2 veya değil ilk_liste -> eğer { yanlış_argüman(ad, "liste, eleman", türler, d) }
        # nehir.py türlerin kimliğine bakar; burada aynı yazılmış türler aynı liste sayılır.
        t1 == t0 -> eğer { k_hata("bir liste kendi içine eklenemez", d) }
        değil birleştir(t0, liste_türü(t1)) -> eğer {
            k_hata(ham_ad(t0) + " içine " + ham_ad(t1) + " eklenemez", d)
        }
        yaz("pop rsi")
        yaz("pop rdi")
        komut("call __liste_ekle", d)
        t0 -> döndür
    }
    asıl == "dilim" -> eğer {
        n != 3 veya t1 != "sayı" veya t2 != "sayı" veya değil (ilk_liste veya t0 == "metin") -> eğer {
            yanlış_argüman(ad, "liste ya da metin, baş, son", türler, d)
        }
        yaz("pop rdx")
        yaz("pop rsi")
        yaz("pop rdi")
        ilk_liste -> eğer {
            komut("call __liste_dilim", d)
            t0 -> döndür
        }
        komut("call __metin_dilim", d)
        "metin" -> döndür
    }
    asıl == "bul" -> eğer {
        n == 2 ve t0 == "metin" ve t1 == "metin" -> eğer {
            yaz("pop rsi")
            yaz("pop rdi")
            komut("call __metin_bul", d)
            "sayı" -> döndür
        }
        n != 2 veya değil ilk_liste -> eğer {
            yanlış_argüman(ad, "metin, aranan metin  ya da  liste, aranan eleman", türler, d)
        }
        değil birleştir(t0, liste_türü(t1)) veya sözlük_içerir(t1) -> eğer {
            k_hata(ham_ad(t0) + " içinde " + ham_ad(t1) + " aranamaz", d)
        }
        yaz("pop rsi")
        yaz("pop rdi")
        tür_satırı("rdx", t1)
        komut("call __liste_bul", d)
        "sayı" -> döndür
    }
    asıl == "sil" -> eğer {
        n != 2 veya değil ilk_liste veya t1 != "sayı" -> eğer {
            yanlış_argüman(ad, "liste, dizin  ya da  sözlük, anahtar", türler, d)
        }
        yaz("pop rsi")
        yaz("pop rdi")
        komut("call __liste_sil", d)
        çöz(eleman_türü(t0)) -> döndür
    }
    asıl == "böl" -> eğer {
        n != 2 veya t0 != "metin" veya t1 != "metin" -> eğer { yanlış_argüman(ad, "metin, ayraç", türler, d) }
        yaz("pop rsi")
        yaz("pop rdi")
        komut("call __metin_bol", d)
        "[metin]" -> döndür
    }
    asıl == "birleş" -> eğer {
        n != 2 veya değil ilk_liste veya t1 != "metin" -> eğer { yanlış_argüman(ad, "metin listesi, ayraç", türler, d) }
        değil birleştir(t0, "[metin]") -> eğer { yanlış_argüman(ad, "metin listesi, ayraç", türler, d) }
        yaz("pop rsi")
        yaz("pop rdi")
        komut("call __liste_birles", d)
        "metin" -> döndür
    }
    # aralık
    n != 2 veya t0 != "sayı" veya t1 != "sayı" -> eğer { yanlış_argüman(ad, "sayı, sayı", türler, d) }
    yaz("pop rsi")
    yaz("pop rdi")
    komut("call __aralik", d)
    "[sayı]" -> döndür
}

işlev yanlış_argüman(ad, beklenen, türler, d) {
    k_hata("'" + ad + "' (" + beklenen + ") bekliyor; (" + ham_listesi(türler) + ") verildi", d)
}

# İşlevi, parametre türleri belli olduktan sonra ayrı bir tampona derler. Çağıranın
# derleme durumu saklanır ve sonra geri yüklenir.
işlev işlevi_derle(ad) {
    1 -> k_işlev_durum[ad]
    k_işlev[ad] -> f
    parametre_sayısı(f) -> n

    k_kod -> s_kod
    k_geçerli -> s_geçerli
    k_yerel_yer -> s_yerel_yer
    k_yerel_tür -> s_yerel_tür
    k_yerel_sayısı -> s_yerel_sayısı
    k_okunan -> s_okunan
    k_döngü_devam -> s_döngü_devam
    k_döngü_son -> s_döngü_son
    k_döngü_çatal -> s_döngü_çatal
    k_çatal -> s_çatal

    [] -> k_kod
    ad -> k_geçerli
    {} -> k_yerel_yer
    {} -> k_yerel_tür
    0 -> k_yerel_sayısı
    {} -> k_okunan
    [] -> k_döngü_devam
    [] -> k_döngü_son
    [] -> k_döngü_çatal
    0 -> k_çatal
    # Argümanlar soldan sağa itilir: ilk argüman en derinde durur.
    0 -> i
    i < n -> iken {
        f.çocuklar[i].ad -> p
        "[rbp+" + metne(16 + 8 * (n - 1 - i)) + "]" -> k_yerel_yer[p]
        k_işlev_türler[ad][i] -> k_yerel_tür[p]
        i + 1 -> i
    }
    gövdesi(f) -> gövde
    blok_üret(gövde)
    k_kod -> gövde_kodu
    k_yerel_sayısı -> yerel_sayısı

    s_kod -> k_kod
    s_geçerli -> k_geçerli
    s_yerel_yer -> k_yerel_yer
    s_yerel_tür -> k_yerel_tür
    s_yerel_sayısı -> k_yerel_sayısı
    s_okunan -> k_okunan
    s_döngü_devam -> k_döngü_devam
    s_döngü_son -> k_döngü_son
    s_döngü_çatal -> k_döngü_çatal
    s_çatal -> k_çatal

    k_işlev_dönüş[ad] == "" -> eğer { "sayı" -> k_işlev_dönüş[ad] }    # hiç 'döndür' yok: 0 döner
    tamamlanır(gövde.çocuklar) -> k_işlev_sona[ad]
    2 -> k_işlev_durum[ad]

    k_işlev_kodu -> ekle("§BAŞLIK§" + ad)
    k_işlev_kodu -> ekle("    push rbp")
    k_işlev_kodu -> ekle("    mov rbp, rsp")
    yerel_sayısı > 0 -> eğer { k_işlev_kodu -> ekle("    sub rsp, " + metne(8 * yerel_sayısı)) }
    gövde_kodu -> her (s) { k_işlev_kodu -> ekle(s) }
    k_işlev_kodu -> ekle("    xor eax, eax")
    k_işlev_kodu -> ekle("    leave")
    k_işlev_kodu -> ekle("    ret")
}

# İşlevin etiket satırı; türler derlemenin sonunda kesinleşmiş olur.
işlev işlev_başlığı(ad) {
    k_işlev_etiket[ad] + ":    # işlev " + ad + "(" + tür_listesi(k_işlev_türler[ad]) + ") -> "
        + tür_adı(k_işlev_dönüş[ad]) -> döndür
}

# Bütün program derlendikten sonra dönüş türleri kesinleşir. Sonuna değer
# döndürmeden ulaşılabilen bir işlev 0 döndürür; bu yalnızca sayı için geçerlidir.
işlev dönüşleri_denetle() {
    k_işlev_adları -> her (ad) {
        k_işlev_durum[ad] == 2 -> eğer {
            çöz(k_işlev_dönüş[ad]) -> dönüş
            bilinmeyen_mi(dönüş) ve değil yok_mu(dönüş) -> eğer {   # yalnızca kendi sonucunu döndüren özyineleme
                "sayı" -> k_bağ[dönüş]
                "sayı" -> dönüş
            }
            k_işlev_sona[ad] ve dönüş != "sayı" ve değil kayıtsı(dönüş) -> eğer {
                k_hata("'" + ad + "' işlevi " + ham_ad(dönüş)
                       + " döndürüyor ama sonuna değer döndürmeden ulaşılabiliyor", k_işlev[ad])
            }
        }
    }
}

# ── deyimler ──

işlev blok_üret(b) { b.çocuklar -> her (d) { deyim_üret(d) } }

işlev döngü_gövdesi(b, devam_etiketi, son_etiketi) {
    k_döngü_devam -> ekle(devam_etiketi)
    k_döngü_son -> ekle(son_etiketi)
    k_döngü_çatal -> ekle(k_çatal)
    blok_üret(b)
    uzunluk(k_döngü_son) - 1 -> s
    k_döngü_devam -> sil(s)
    k_döngü_son -> sil(s)
    k_döngü_çatal -> sil(s)
}

işlev deyim_üret(d) {
    d.tür == "dur" veya d.tür == "devam" -> eğer {
        uzunluk(k_döngü_son) == 0 -> eğer { k_hata("'" + d.tür + "' yalnızca döngü içinde kullanılabilir", d) }
        uzunluk(k_döngü_son) - 1 -> s
        k_çatal > k_döngü_çatal[s] -> eğer {      # çatalların yığında bıraktıklarını at
            yaz("add rsp, " + metne(8 * (k_çatal - k_döngü_çatal[s])))
        }
        d.tür == "dur" -> eğer { yaz("jmp " + k_döngü_son[s]) } değilse { yaz("jmp " + k_döngü_devam[s]) }
    } değilse {
        d.tür != "akış" -> eğer { desteklenmiyor("'" + d.tür + "' deyimi", d) }
        d.çocuklar -> c
        uzunluk(c) -> n
        "" -> döngü_başı
        c[n - 1].tür == "iken" -> eğer {
            # Koşul her turda yeniden aktığı için tüm zincir döngünün içindedir.
            yeni_etiket() -> döngü_başı
            etiket_koy(döngü_başı)
        }
        ifade_üret(c[0]) -> tür
        1 -> i
        i < n -> iken {
            hedef_üret(c[i], tür, döngü_başı) -> tür
            i + 1 -> i
        }
    }
}

işlev hedef_üret(h, tür, döngü_başı) { hedef_iç(h, çöz(tür), döngü_başı) -> döndür }

işlev hedef_iç(h, tür, döngü_başı) {
    h.tür == "yazdır" -> eğer {
        yaz("push rax")
        yaz("mov rdi, rax")
        tür_satırı("rsi", tür)
        yaz("call __yaz_deger")
        yaz("pop rax")              # değer akmaya devam eder
        tür -> döndür
    }
    h.tür == "döndür" -> eğer {
        k_geçerli == "" -> eğer { k_hata("'döndür' yalnızca işlev içinde kullanılabilir", h) }
        k_işlev_dönüş[k_geçerli] -> önceki
        önceki == "" -> eğer { tür -> k_işlev_dönüş[k_geçerli] } değilse {
            değil birleştir(önceki, tür) -> eğer {
                k_hata("'" + k_geçerli + "' işlevi hem " + ham_ad(önceki) + " hem " + tür_adı(tür)
                       + " döndürüyor", h)
            }
        }
        yaz("leave")
        yaz("ret")
        tür -> döndür
    }
    h.tür == "eğer" -> eğer {
        sayı_olmalı(tür, "'eğer' koşulu", h)
        yeni_etiket() -> öteki
        yeni_etiket() -> son
        yaz("test rax, rax")
        yaz("jz " + öteki)
        blok_üret(h.çocuklar[0])
        yaz("jmp " + son)
        etiket_koy(öteki)
        uzunluk(h.çocuklar) > 1 -> eğer { blok_üret(h.çocuklar[1]) }
        etiket_koy(son)
        tür -> döndür
    }
    h.tür == "iken" -> eğer {
        sayı_olmalı(tür, "'iken' koşulu", h)
        yeni_etiket() -> son
        yaz("test rax, rax")
        yaz("jz " + son)
        döngü_gövdesi(h.çocuklar[0], döngü_başı, son)
        yaz("jmp " + döngü_başı)
        etiket_koy(son)
        tür -> döndür
    }
    h.tür == "her" -> eğer {
        yeni_etiket() -> baş
        yeni_etiket() -> artır
        yeni_etiket() -> son
        tür == "metin" -> eğer {      # her karakter sırayla değişkene akar
            yaz("push rax")                 # [rsp+8] = metin
            yaz("push 0")                   # [rsp]   = sıradaki karakterin bayt konumu
            etiket_koy(baş)
            yaz("mov rsi, [rsp]")
            yaz("mov rdi, [rsp+8]")
            yaz("cmp rsi, [rdi-8]")
            yaz("jge " + son)
            komut("call __metin_karakter", h)
            yaz("mov [rsp], rdx")
            ata(h.ad, "metin", h)
        } değilse {
            sözlük_mi(tür) -> eğer {      # anahtarların o anki listesi üzerinde dönülür
                yaz("mov rdi, rax")
                yaz("mov esi, 16")
                komut("call __sozluk_liste", h)
                liste_türü(anahtar_kısmı(tür)) -> tür
            }
            değil liste_mi(tür) -> eğer {
                k_hata("'her' içine bir liste, sözlük ya da metin akmalı, " + ham_ad(tür) + " bulundu", h)
            }
            yaz("push rax")                 # [rsp+8] = liste
            yaz("push 0")                   # [rsp]   = dizin
            etiket_koy(baş)
            yaz("mov rsi, [rsp]")
            yaz("mov rdi, [rsp+8]")
            yaz("cmp rsi, [rdi]")
            yaz("jge " + son)
            komut("call __liste_al", h)
            ata(h.ad, çöz(eleman_türü(tür)), h)     # henüz bilinmiyorsa kullanımdan öğrenilir
        }
        döngü_gövdesi(h.çocuklar[0], artır, son)
        etiket_koy(artır)
        tür == "metin" -> eğer { yaz("jmp " + baş) } değilse {
            yaz("inc qword ptr [rsp]")
            yaz("jmp " + baş)
        }
        etiket_koy(son)
        yaz("add rsp, 16")
        tür -> döndür
    }
    h.tür == "eleman" -> eğer {
        yaz("push rax")                     # [rsp] = yazılacak değer
        ifade_üret(h.çocuklar[0]) -> kap
        değil (liste_mi(kap) veya sözlük_mi(kap)) -> eğer {
            k_hata("'[ ]' ile yalnızca liste ve sözlüklere yazılabilir, " + ham_ad(kap) + " bulundu", h)
        }
        yaz("push rax")
        ifade_üret(h.çocuklar[1]) -> dizin_türü
        yaz("mov rsi, rax")
        yaz("pop rdi")
        liste_mi(kap) -> eğer {
            sayı_olmalı(dizin_türü, "liste dizini", h)
            değil birleştir(kap, liste_türü(tür)) -> eğer { k_hata(ham_ad(kap) + " içine " + ham_ad(tür) + " akamaz", h) }
            yaz("mov rdx, [rsp]")
            komut("call __liste_koy", h)
        } değilse {
            anahtarı_denetle(kap, dizin_türü, h)
            değil birleştir(değer_kısmı(kap), tür) -> eğer {
                k_hata(ham_ad(kap) + " içine değer olarak " + ham_ad(tür) + " akamaz", h)
            }
            yaz("mov rcx, [rsp]")
            komut("call __sozluk_koy", h)
        }
        yaz("pop rax")
        tür -> döndür
    }
    h.tür == "alan_yaz" -> eğer {
        yaz("push rax")                     # [rsp] = yazılacak değer
        ifade_üret(h.çocuklar[0]) -> kt
        alan_sırası(kt, h.ad, h) -> sıra
        alan_türü(kt, sıra) -> at
        değil birleştir(at, tür) -> eğer {
            k_hata("'" + h.ad + "' alanı " + tür_adı(at) + " türünde; " + ham_ad(tür) + " atanamaz", h)
        }
        yaz("test rax, rax")
        komut("jz __yok_hatasi", h)
        yaz("mov rcx, [rsp]")
        yaz("mov [rax+" + metne(8 * sıra) + "], rcx")
        yaz("pop rax")
        tür -> döndür
    }
    h.tür == "çatal" -> eğer {
        # Aynı değer her kola ayrı ayrı akar; sonra olduğu gibi yoluna devam eder.
        h.çocuklar -> her (dal) {
            yaz("push rax")
            k_çatal + 1 -> k_çatal
            tür -> kol_türü
            dal.çocuklar -> her (alt) { hedef_üret(alt, kol_türü, "") -> kol_türü }
            k_çatal - 1 -> k_çatal
            yaz("pop rax")
        }
        tür -> döndür
    }
    h.tür == "ortak" -> eğer {
        k_geçerli != "" -> eğer { k_hata("'ortak' yalnızca en üst düzeyde, değişken tanımlanırken yazılır", h) }
        çağrılabilir(h.ad) -> eğer { k_hata("'" + h.ad + "' bir işlev ya da kayıt adı; değişken adı olamaz", h) }
        ata(h.ad, tür, h)
        tür -> döndür
    }
    h.tür == "hedef_ad" -> eğer {
        # İşlevse akan değer ilk argüman olur, değilse değişkene atanır. Parametreler
        # ve yerel değişkenler aynı adlı işlevleri gölgeler.
        uzunluk(h.çocuklar) > 0 veya (değil yerel_mi(h.ad) ve çağrılabilir(h.ad)) -> eğer {
            yaz("push rax")
            [] -> arg_düğümleri
            uzunluk(h.çocuklar) > 0 -> eğer { h.çocuklar[0].çocuklar -> arg_düğümleri }
            çağır(h.ad, arg_düğümleri, h, tür) -> döndür
        }
        ata(h.ad, tür, h)
        tür -> döndür
    }
    desteklenmiyor("'" + h.tür + "' hedefi", h)
}

# ── ifadeler ──
# Her ifadenin sonucu rax'te kalır; işlev, ifadenin (çözülmüş) türünü verir.

işlev ifade_üret(e) { çöz(ifade_iç(e)) -> döndür }

işlev ifade_iç(e) {
    e.tür == "sayı" -> eğer {
        yaz("mov rax, " + metne(e.sayı))
        "sayı" -> döndür
    }
    e.tür == "metin" -> eğer {
        yaz("lea rax, [rip+" + metin_etiketi(e.ad) + "]")
        "metin" -> döndür
    }
    e.tür == "değişken" -> eğer {
        değişken_var_mı(e.ad) -> eğer {
            değişken_türü(e.ad) == "" -> eğer {
                k_hata("'" + e.ad + "' değişkenine henüz bir değer akmadı", e)
            }
            k_geçerli != "" ve değil yerel_mi(e.ad) -> eğer { 1 -> k_okunan[e.ad] }
            yaz("mov rax, " + değişken_adresi(e.ad))
            değişken_türü(e.ad) -> döndür
        }
        k_işlev -> var(e.ad) -> eğer { desteklenmiyor("işlev değeri", e) }
        k_kayıt_alanları -> var(e.ad) -> eğer { k_hata("'" + e.ad + "' bir kayıt; kayıtlar değer olarak verilemez", e) }
        YERLEŞİK_ADLAR -> var(e.ad) -> eğer {
            k_hata("'" + e.ad + "' yerleşik bir işlev; yerleşik işlevler değer olarak verilemez", e)
        }
        k_hata("'" + e.ad + "' adında bir değişken yok", e)
    }
    e.tür == "çağrı" -> eğer { çağır(e.ad, e.çocuklar, e, "") -> döndür }
    e.tür == "yok" -> eğer {
        yaz("xor eax, eax")
        yeni_tür_değişkeni() -> t
        1 -> k_yok[t]
        t -> döndür
    }
    e.tür == "alan" -> eğer {
        ifade_üret(e.çocuklar[0]) -> kt
        alan_sırası(kt, e.ad, e) -> sıra
        yaz("test rax, rax")
        komut("jz __yok_hatasi", e)
        yaz("mov rax, [rax+" + metne(8 * sıra) + "]")
        alan_türü(kt, sıra) -> döndür
    }
    e.tür == "liste" -> eğer {
        uzunluk(e.çocuklar) -> n
        n < 4 -> eğer { 4 -> n }
        yaz("mov edi, " + metne(n))
        komut("call __liste_yeni", e)
        yaz("push rax")
        liste_türü(yeni_tür_değişkeni()) -> tür
        e.çocuklar -> her (eleman) {
            ifade_üret(eleman) -> et
            değil birleştir(tür, liste_türü(et)) -> eğer {
                k_hata("listenin elemanları aynı türde olmalı: " + bilinen_adı(eleman_türü(tür)) + " ve "
                       + ham_ad(et) + " karışmış", e)
            }
            yaz("mov rsi, rax")
            yaz("mov rdi, [rsp]")
            komut("call __liste_ekle", e)
        }
        yaz("pop rax")
        tür -> döndür
    }
    e.tür == "sözlük" -> eğer {
        komut("call __sozluk_yeni", e)
        yaz("push rax")
        sözlük_türü(yeni_tür_değişkeni(), yeni_tür_değişkeni()) -> tür
        0 -> i
        i < uzunluk(e.çocuklar) -> iken {
            e.çocuklar[i] -> anahtar
            e.çocuklar[i + 1] -> değer
            ifade_üret(anahtar) -> at
            yaz("push rax")
            ifade_üret(değer) -> vt
            yaz("mov rcx, rax")
            yaz("pop rsi")
            yaz("mov rdi, [rsp]")
            anahtarı_denetle(tür, at, anahtar)
            değil birleştir(değer_kısmı(tür), vt) -> eğer {
                k_hata("sözlüğün değerleri aynı türde olmalı: " + bilinen_adı(değer_kısmı(tür)) + " ve "
                       + ham_ad(vt) + " karışmış", değer)
            }
            komut("call __sozluk_koy", e)
            i + 2 -> i
        }
        yaz("pop rax")
        tür -> döndür
    }
    e.tür == "dizin" -> eğer {
        ifade_üret(e.çocuklar[0]) -> kap
        kap == "sayı" -> eğer { k_hata("'[ ]' ile yalnızca liste, sözlük ve metinlere erişilebilir", e) }
        yaz("push rax")
        ifade_üret(e.çocuklar[1]) -> dizin_türü
        yaz("mov rsi, rax")
        yaz("pop rdi")
        sözlük_mi(kap) -> eğer {
            anahtarı_denetle(kap, dizin_türü, e)
            komut("call __sozluk_al", e)
            değer_kısmı(kap) -> döndür       # henüz bilinmiyorsa kullanıldığı yerden anlaşılır
        }
        değil liste_mi(kap) ve kap != "metin" -> eğer {
            k_hata("'[ ]' ile yalnızca liste, sözlük ve metinlere erişilebilir, " + ham_ad(kap) + " bulundu", e)
        }
        sayı_olmalı(dizin_türü, "dizin", e)
        kap == "metin" -> eğer {
            komut("call __metin_al", e)
            "metin" -> döndür
        }
        komut("call __liste_al", e)
        eleman_türü(kap) -> döndür
    }
    e.tür == "tekli" -> eğer {
        sayı_olmalı(ifade_üret(e.çocuklar[0]), "'" + e.ad + "' işlecinin işleneni", e)
        e.ad == "-" -> eğer { yaz("neg rax") } değilse {
            yaz("test rax, rax")
            yaz("sete al")
            yaz("movzx eax, al")
        }
        "sayı" -> döndür
    }
    e.tür == "ikili" -> eğer { ikili_üret(e) -> döndür }
    desteklenmiyor("'" + e.tür + "' ifadesi", e)
}

işlev ikili_üret(e) {
    e.ad -> iş
    e.çocuklar[0] -> sol
    e.çocuklar[1] -> sağ
    iş == "ve" veya iş == "veya" -> eğer {
        # Kısa devre: sonuç her zaman 0 veya 1.
        yeni_etiket() -> son
        sayı_olmalı(ifade_üret(sol), "'" + iş + "' işlecinin sol tarafı", e)
        yaz("test rax, rax")
        yaz("setne al")
        yaz("movzx eax, al")
        iş == "ve" -> eğer { yaz("jz " + son) } değilse { yaz("jnz " + son) }
        sayı_olmalı(ifade_üret(sağ), "'" + iş + "' işlecinin sağ tarafı", e)
        yaz("test rax, rax")
        yaz("setne al")
        yaz("movzx eax, al")
        etiket_koy(son)
        "sayı" -> döndür
    }
    ifade_üret(sol) -> sol_türü
    yaz("push rax")
    ifade_üret(sağ) -> sağ_türü
    yaz("mov rcx, rax")
    yaz("pop rax")
    (iş == "==" veya iş == "!=") ve (kayıtsı(sol_türü) veya kayıtsı(sağ_türü)) -> eğer {
        # Kayıtlar kimlikleriyle karşılaştırılır: aynı kayıt mı (ya da ikisi de yok mu)?
        değil birleştir(sol_türü, sağ_türü) -> eğer {
            k_hata(ham_ad(sol_türü) + " ile " + ham_ad(sağ_türü) + " karşılaştırılamaz", e)
        }
        yaz("cmp rax, rcx")
        yaz(KARŞILAŞTIRMA[iş] + " al")
        yaz("movzx eax, al")
        "sayı" -> döndür
    }
    # Türü henüz bilinmeyen bir işlenen türünü öbür işlenenden ya da işleçten alır.
    bilinmeyen_mi(sol_türü) veya bilinmeyen_mi(sağ_türü) -> eğer {
        iş == "+" veya var(KARŞILAŞTIRMA, iş) -> eğer {
            bilinmeyen_mi(sol_türü) ve bilinmeyen_mi(sağ_türü) -> eğer {
                k_hata("'" + iş + "' işlecinin iki tarafının da türü henüz belli değil", e)
            }
            birleştir(sol_türü, sağ_türü)
            çöz(sol_türü) -> sol_türü
            çöz(sağ_türü) -> sağ_türü
        }
    }
    sol_türü == "metin" ve sağ_türü == "metin" ve (iş == "+" veya var(KARŞILAŞTIRMA, iş)) -> eğer {
        yaz("mov rdi, rax")
        yaz("mov rsi, rcx")
        iş == "+" -> eğer {
            komut("call __metin_birlestir", e)
            "metin" -> döndür
        }
        yaz("call __metin_karsilastir")
        yaz("test rax, rax")        # işaretli sonuç 0 ile karşılaştırılır
        yaz(KARŞILAŞTIRMA[iş] + " al")
        yaz("movzx eax, al")
        "sayı" -> döndür
    }
    liste_mi(sol_türü) ve liste_mi(sağ_türü) ve (iş == "+" veya iş == "==" veya iş == "!=") -> eğer {
        değil birleştir(sol_türü, sağ_türü) veya (iş != "+" ve sözlük_içerir(sol_türü)) -> eğer {
            " karşılaştırılamaz" -> ne
            iş == "+" -> eğer { " birleştirilemez" -> ne }
            k_hata(ham_ad(sol_türü) + " ile " + ham_ad(sağ_türü) + ne, e)
        }
        yaz("mov rdi, rax")
        yaz("mov rsi, rcx")
        iş == "+" -> eğer {
            komut("call __liste_birlestir", e)
            sol_türü -> döndür
        }
        tür_satırı("rdx", sol_türü)
        yaz("call __deger_esit")
        iş == "!=" -> eğer { yaz("xor eax, 1") }
        "sayı" -> döndür
    }
    sözlük_mi(sol_türü) ve sözlük_mi(sağ_türü) ve (iş == "==" veya iş == "!=") -> eğer {
        k_hata("sözlükler '==' ve '!=' ile karşılaştırılamaz", e)
    }
    liste_mi(sol_türü) ve iş == "+" -> eğer { k_hata("listeye '+' ile eleman eklenemez", e) }
    iş == "+" ve (sol_türü == "metin" veya sağ_türü == "metin")
        ve (sol_türü == "sayı" veya sağ_türü == "sayı") -> eğer {
        k_hata("metin ile sayı doğrudan toplanamaz", e)
    }
    sayı_olmalı(sol_türü, "'" + iş + "' işlecinin sol tarafı", e)
    sayı_olmalı(sağ_türü, "'" + iş + "' işlecinin sağ tarafı", e)
    iş == "+" -> eğer { yaz("add rax, rcx")   "sayı" -> döndür }
    iş == "-" -> eğer { yaz("sub rax, rcx")   "sayı" -> döndür }
    iş == "*" -> eğer { yaz("imul rax, rcx")   "sayı" -> döndür }
    iş == "/" veya iş == "%" -> eğer {
        yaz("test rcx, rcx")
        komut("jz __sifira_bolme", e)
        yaz("cqo")
        yaz("idiv rcx")
        iş == "%" -> eğer { yaz("mov rax, rdx") }
        "sayı" -> döndür
    }
    yaz("cmp rax, rcx")
    yaz(KARŞILAŞTIRMA[iş] + " al")
    yaz("movzx eax, al")
    "sayı" -> döndür
}

# ── program ──

# Metnin UTF-8 baytları ve sonundaki sıfır, assembly'nin `.byte` yazımıyla.
işlev bayt_satırı(m) {
    [] -> parçalar
    m -> baytlar -> her (b) { parçalar -> ekle(metne(b)) }
    parçalar -> ekle("0")
    "    .byte " + birleş(parçalar, ", ") -> döndür
}

# Ağacın kökünden bütün assembly metnini üretir. `çalışma_zamanı`, calisma_zamani.s
# dosyasının içeriğidir.
işlev üret(kök, çalışma_zamanı) {
    # Önce bütün kayıt türleri oluşturulur, sonra alan türleri çözülür; böylece
    # kayıtlar kendilerine ve birbirlerine gönderme yapabilir.
    kök.çocuklar -> her (d) {
        d.tür == "kayıt" -> eğer {
            [] -> alanlar
            [] -> türler
            d.çocuklar -> her (a) {
                alanlar -> ekle(a.ad)
                türler -> ekle(yeni_tür_değişkeni())
            }
            alanlar -> k_kayıt_alanları[d.ad]
            türler -> k_kayıt_türleri[d.ad]
        }
    }
    kök.çocuklar -> her (d) {
        d.tür == "kayıt" -> eğer {
            0 -> i
            d.çocuklar -> her (a) {
                uzunluk(a.çocuklar) > 0 -> eğer { tür_çöz(a.çocuklar[0]) -> k_bağ[k_kayıt_türleri[d.ad][i]] }
                i + 1 -> i
            }
        }
    }
    kök.çocuklar -> her (d) {
        d.tür == "kullan" -> eğer { desteklenmiyor("'" + d.tür + "'", d) }
        d.tür == "işlev" -> eğer {
            d -> k_işlev[d.ad]
            "f" + metne(uzunluk(k_işlev_adları)) -> k_işlev_etiket[d.ad]
            "" -> k_işlev_dönüş[d.ad]
            0 -> k_işlev_durum[d.ad]
            k_işlev_adları -> ekle(d.ad)
        }
    }
    dönmeyenleri_bul()
    küreselleri_topla(kök.çocuklar)

    k_kod -> ekle("nehir_ana:")
    yaz("push rbp")
    yaz("mov rbp, rsp")
    kök.çocuklar -> her (d) { d.tür != "işlev" ve d.tür != "kayıt" -> eğer { deyim_üret(d) } }
    yaz("leave")
    yaz("ret")
    dönüşleri_denetle()

    # Ertelenen satırlar (tür tanımları, işlev başlıkları) son sırayla çözülür.
    [".intel_syntax noprefix", ".global _start", ".section .text"] -> satırlar
    k_kod + k_işlev_kodu -> her (s) {
        dilim(s, 0, 5) == "§TÜR§" -> eğer {
            satırlar -> ekle("    lea " + dilim(s, 5, 8) + ", [rip+" + tür_etiketi(dilim(s, 8, uzunluk(s))) + "]")
        } değilse {
            dilim(s, 0, 8) == "§BAŞLIK§" -> eğer {
                satırlar -> ekle(işlev_başlığı(dilim(s, 8, uzunluk(s))))
            } değilse {
                satırlar -> ekle(s)
            }
        }
    }
    çalışma_zamanı -> böl("YIGIN_BOYUTU") -> birleş(YIĞIN_BOYUTU) -> çz
    satırlar -> ekle(çz)
    satırlar -> ekle("    .section .rodata")
    satırlar -> ekle("    .balign 8")
    satırlar -> ekle("__dosyalar: .quad " + metin_etiketi(l_dosya))

    satırlar -> ekle("    .section .rodata")
    0 -> i
    k_metinler -> her (m) {
        satırlar -> ekle("    .balign 8")
        satırlar -> ekle("    .quad " + metne(uzunluk(baytlar(m))))
        satırlar -> ekle("m" + metne(i) + ":")
        satırlar -> ekle(bayt_satırı(m))
        i + 1 -> i
    }
    uzunluk(k_küreseller) > 0 -> eğer {
        satırlar -> ekle("    .section .bss")
        k_küreseller -> her (ad) { satırlar -> ekle(k_küresel_etiket[ad] + ": .skip 8    # " + ad) }
    }
    uzunluk(k_tür_tanımları) > 0 -> eğer {
        satırlar -> ekle("    .section .rodata")
        satırlar -> ekle("    .balign 8")
        satırlar + k_tür_tanımları -> satırlar
    }
    birleş(satırlar, "\n") + "\n" -> döndür
}
