# ── gözetleme deliği eniyilemesi ──
# Üretilen kod her ara değeri yığına iter. Ardışık birkaç satırlık kalıplar daha kısa ve eşdeğer
# satırlarla değiştirilir. nehir.py'deki gözetle ile birebir aynı olmalıdır.

işlev başlar_mı(m, ön) { dilim(m, 0, uzunluk(ön)) == ön -> döndür }

işlev adı_geçer(m, adlar) {
    yanlış -> sonuç
    adlar -> her (a) { bul(m, a) >= 0 -> eğer { doğru -> sonuç } }
    sonuç -> döndür
}

# j'den sonra, bir çağrıdan önce bu yazmaçlar (adlarının geçtiği bir satır) okunmuyor mu?
# Etiket, sıçrama ya da dönüşte bilinemez sayılır.
işlev ölü_mü(satırlar, j, yazmaçlar) {
    j < uzunluk(satırlar) -> iken {
        satırlar[j] -> l
        başlar_mı(l, "    call ") -> eğer { değil adı_geçer(l, yazmaçlar) -> döndür }
        değil başlar_mı(l, "    ") veya başlar_mı(l, "    j") veya l == "    ret" veya adı_geçer(l, yazmaçlar) -> eğer {
            yanlış -> döndür
        }
        j + 1 -> j
    }
    yanlış -> döndür
}

["rax", "eax", "al", "ah"] -> RAX_ADLARI
["rax", "eax", "al", "ah", "rcx", "ecx", "cl", "ch"] -> RAX_RCX_ADLARI

işlev gözetle(satırlar) {
    doğru -> değişti
    değişti -> iken {
        yanlış -> değişti
        [] -> yeni
        0 -> i
        uzunluk(satırlar) -> n
        i < n -> iken {
            satırlar[i] -> a
            a == "    push rax" ve i + 3 < n -> eğer {
                satırlar[i + 3] -> d
                satırlar[i + 2] == "    mov rcx, rax" ve (d == "    pop rax" veya d == "    pop rsi")
                    ve (başlar_mı(satırlar[i + 1], "    mov rax, ") veya başlar_mı(satırlar[i + 1], "    lea rax, ")) -> eğer {
                    # push rax / mov rax, X / mov rcx, rax / pop rax  ->  mov rcx, X
                    dilim(satırlar[i + 1], 13, uzunluk(satırlar[i + 1])) -> x
                    bul(x, "rax") < 0 ve bul(x, "rsp") < 0 ve bul(x, "rcx") < 0
                        ve (d == "    pop rax" veya ölü_mü(satırlar, i + 4, RAX_ADLARI)) -> eğer {
                        d == "    pop rsi" -> eğer { yeni -> ekle("    mov rsi, rax") }
                        yeni -> ekle(dilim(satırlar[i + 1], 0, 8) + "rcx, " + x)
                        i + 4 -> i
                        doğru -> değişti
                        devam
                    }
                }
            }
            a == "    mov rcx, rax" ve i + 3 < n -> eğer {
                satırlar[i + 1] == "    pop rax" ve satırlar[i + 2] == "    mov rdi, rax" ve satırlar[i + 3] == "    mov rsi, rcx"
                    ve ölü_mü(satırlar, i + 4, RAX_RCX_ADLARI) -> eğer {
                    # mov rcx, rax / pop rax / mov rdi, rax / mov rsi, rcx  ->  mov rsi, rax / pop rdi
                    yeni -> ekle("    mov rsi, rax")
                    yeni -> ekle("    pop rdi")
                    i + 4 -> i
                    doğru -> değişti
                    devam
                }
            }
            a == "    push rax" ve i + 1 < n -> eğer {
                başlar_mı(satırlar[i + 1], "    pop ") -> eğer {
                    # push rax / pop r  ->  mov r, rax
                    satırlar[i + 1] != "    pop rax" -> eğer {
                        yeni -> ekle("    mov " + dilim(satırlar[i + 1], 8, uzunluk(satırlar[i + 1])) + ", rax")
                    }
                    i + 2 -> i
                    doğru -> değişti
                    devam
                }
            }
            yeni -> ekle(a)
            i + 1 -> i
        }
        yeni -> satırlar
    }
    satırlar -> döndür
}

# Yan etkisi olmayan yerleşikler (nehir.py'deki SAF_YERLEŞİKLER ile aynı)
{} -> SAF_YERLEŞİKLER
["uzunluk", "aralık", "metne", "sayıya", "dilim", "bul", "böl", "birleş", "var", "anahtarlar",
 "değerler", "baytlar", "karakter", "işletim_sistemi", "uçbirim_mi", "ortam_var", "dosya_hatası",
 "dosya_var", "girdi_var", "zaman", "uçbirim_boyutu", "ondalığa", "yuvarla", "taban", "tavan",
 "karekök", "mutlak", "sin", "cos", "atan2", "pi", "bit_ve", "bit_veya", "bit_yada", "bit_değil",
 "sola_kaydır", "sağa_kaydır", "en_küçük", "en_büyük", "sınırla", "işaret", "üs", "tan", "atan",
 "asin", "acos", "üstel", "ln", "rgb", "sırala", "ters_çevir", "argümanlar",
 "metin_genişliği", "dizin_listele"] -> her (a) { 1 -> SAF_YERLEŞİKLER[a] }

# Ekran işlevleri: [kısa biçim, uzun biçim, açıklama, yordam]. Biçim, argüman türlerinin virgülle
# birleşimidir; kısa biçimde eksik kalan renkler -1 olarak itilir. nehir.py'deki EKRAN_İŞLEVLERİ ile aynı.
{
    "ekran_aç": ["sayı,sayı", "sayı,sayı", "genişlik, yükseklik", "__ekran_ac"],
    "ekran_kapat": ["", "", "argümansız", "__ekran_kapat"],
    "ekran_temizle": ["", "sayı", "arka plan rengi", "__ekran_temizle"],
    "ekran_yaz": ["sayı,sayı,metin", "sayı,sayı,metin,sayı,sayı",
                  "x, y, metin, yazı rengi, arka plan rengi", "__ekran_yaz"],
    "ekran_doldur": ["sayı,sayı,sayı,sayı,metin", "sayı,sayı,sayı,sayı,metin,sayı,sayı",
                     "x, y, genişlik, yükseklik, karakter, yazı rengi, arka plan rengi", "__ekran_doldur"],
    "ekran_çiz": ["", "", "argümansız", "__ekran_ciz"]
} -> EKRAN_İŞLEVLERİ

{"==": "sete", "!=": "setne", "<": "setl", ">": "setg", "<=": "setle", ">=": "setge"} -> KARŞILAŞTIRMA

# Yığın için ayrılan bellek (bayt). nehir.py'deki YIĞIN_BOYUTU ile aynı olmalı.
"268435456" -> YIĞIN_BOYUTU

# ── türler ──
# Türler metin olarak tutulur: "sayı", "metin", listeler için "[sayı]", "[[metin]]",
# sözlükler için "{metin:sayı}", kayıtlar için "@Nokta" (ada göre), işlevler için
# "&(sayı,metin)sayı" (parametreler ve dönüş) ve henüz bilinmeyen
# bir tür için "?1", "?2", ... `yok` değerinin türü, yalnızca bir kayıt türüne
# bağlanabilen bir bilinmeyendir (k_yok'ta işaretli). Bilinmeyen bir tür öğrenildiğinde
# k_bağ'a yazılır (birleştirme); "[?5]" gibi bir tür de böylece kendiliğinden
# "[sayı]"ya çözülür. Bilinmeyenler boş listelerde ve özyinelemeli işlevlerin dönüş
# türünde doğar.

{} -> k_bağ
{} -> k_yok                 # yalnızca kayıt olabilen bilinmeyenler
0 -> ortak k_tür_no

işlev yeni_tür_değişkeni() {
    k_tür_no + 1 -> k_tür_no
    "?" + metne(k_tür_no) -> döndür
}

işlev bilinmeyen_mi(t) { dilim(t, 0, 1) == "?" -> döndür }
işlev liste_mi(t) { dilim(t, 0, 1) == "[" -> döndür }
işlev kayıt_mı(t) { dilim(t, 0, 1) == "@" -> döndür }
işlev işlev_türü_mü(t) { dilim(t, 0, 1) == "&" -> döndür }
işlev işlev_türü(parametreler, dönüş) { "&(" + birleş(parametreler, ",") + ")" + dönüş -> döndür }

# İşlev türünün parçaları: önce parametre türleri, en sonda dönüş türü. Parametreler
# de iç içe tür olabildiği için ayraçlar parantez derinliği sayılarak bulunur.
işlev işlev_parçaları(t) {
    [] -> parçalar
    "" -> parça
    0 -> derinlik
    0 -> i
    -1 -> kapanış
    t -> her (k) {
        i >= 2 ve kapanış < 0 -> eğer {
            k == "[" veya k == "{" veya k == "(" -> eğer { derinlik + 1 -> derinlik }
            k == "]" veya k == "}" veya k == ")" -> eğer { derinlik - 1 -> derinlik }
            derinlik < 0 -> eğer {          # parametre listesinin sonu
                parça != "" -> eğer { parçalar -> ekle(parça) }
                i -> kapanış
            } değilse {
                k == "," ve derinlik == 0 -> eğer {
                    parçalar -> ekle(parça)
                    "" -> parça
                } değilse { parça + k -> parça }
            }
        }
        i + 1 -> i
    }
    parçalar -> ekle(dilim(t, kapanış + 1, uzunluk(t)))
    parçalar -> döndür
}
işlev kayıt_adı(t) { dilim(t, 1, uzunluk(t)) -> döndür }
işlev yok_mu(t) { var(k_yok, t) -> döndür }
# Bir kayıt ya da `yok` mu? (t çözülmüş olmalı)
işlev kayıtsı(t) { kayıt_mı(t) veya (bilinmeyen_mi(t) ve yok_mu(t)) -> döndür }
işlev eleman_türü(t) { dilim(t, 1, uzunluk(t) - 1) -> döndür }
işlev liste_türü(t) { "[" + t + "]" -> döndür }

işlev sözlük_mi(t) { dilim(t, 0, 1) == "{" -> döndür }
işlev sözlük_türü(anahtar, değer) { "{" + anahtar + ":" + değer + "}" -> döndür }

# "{K:V}" içinde anahtarı değerden ayıran ':'in yeri; iç içe türlerdeki ':'ler atlanır.
işlev sözlük_ayracı(t) {
    0 -> derinlik
    0 -> i
    t -> her (k) {
        i > 0 -> eğer {
            k == "[" veya k == "{" veya k == "(" -> eğer { derinlik + 1 -> derinlik }
            k == "]" veya k == "}" veya k == ")" -> eğer { derinlik - 1 -> derinlik }
            k == ":" ve derinlik == 0 -> eğer { i -> döndür }
        }
        i + 1 -> i
    }
}
işlev anahtar_kısmı(t) { dilim(t, 1, sözlük_ayracı(t)) -> döndür }
işlev değer_kısmı(t) { dilim(t, sözlük_ayracı(t) + 1, uzunluk(t) - 1) -> döndür }

işlev sözlük_içerir(t) {
    çöz(t) -> t
    sözlük_mi(t) -> eğer { doğru -> döndür }
    liste_mi(t) -> eğer { sözlük_içerir(eleman_türü(t)) -> döndür }
    yanlış -> döndür
}

# Bilinmeyen v, t'nin içinde geçiyor mu? (Bir liste kendi elemanı olamaz.)
işlev içerir(t, v) {
    çöz(t) -> t
    t == v -> eğer { doğru -> döndür }
    liste_mi(t) -> eğer { içerir(eleman_türü(t), v) -> döndür }
    sözlük_mi(t) -> eğer { içerir(anahtar_kısmı(t), v) veya içerir(değer_kısmı(t), v) -> döndür }
    işlev_türü_mü(t) -> eğer {
        işlev_parçaları(t) -> her (p) { içerir(p, v) -> eğer { doğru -> döndür } }
    }
    yanlış -> döndür
}

işlev çöz(t) {
    bilinmeyen_mi(t) ve var(k_bağ, t) -> iken { k_bağ[t] -> t }
    t -> döndür
}

işlev birleştir(a, b) {
    çöz(a) -> a
    çöz(b) -> b
    a == b -> eğer { doğru -> döndür }
    bilinmeyen_mi(a) veya bilinmeyen_mi(b) -> eğer {
        # Bağlanacak bilinmeyen: önce b; ikisi de bilinmeyense ve a yalnızca kayıt
        # olabiliyorsa a (kısıt korunur).
        b -> bağlanan
        a -> öteki
        değil bilinmeyen_mi(b) veya (bilinmeyen_mi(a) ve yok_mu(a)) -> eğer {
            a -> bağlanan
            b -> öteki
        }
        yok_mu(bağlanan) -> eğer {
            bilinmeyen_mi(öteki) -> eğer { 1 -> k_yok[öteki] } değilse {
                değil kayıt_mı(öteki) -> eğer { yanlış -> döndür }
            }
        }
        içerir(öteki, bağlanan) -> eğer { yanlış -> döndür }
        öteki -> k_bağ[bağlanan]
        doğru -> döndür
    }
    liste_mi(a) ve liste_mi(b) -> eğer { birleştir(eleman_türü(a), eleman_türü(b)) -> döndür }
    sözlük_mi(a) ve sözlük_mi(b) -> eğer {
        birleştir(anahtar_kısmı(a), anahtar_kısmı(b)) ve birleştir(değer_kısmı(a), değer_kısmı(b)) -> döndür
    }
    işlev_türü_mü(a) ve işlev_türü_mü(b) -> eğer {
        işlev_parçaları(a) -> pa
        işlev_parçaları(b) -> pb
        uzunluk(pa) != uzunluk(pb) -> eğer { yanlış -> döndür }   # farklı sayıda parametre
        0 -> i
        i < uzunluk(pa) -> iken {
            değil birleştir(pa[i], pb[i]) -> eğer { yanlış -> döndür }
            i + 1 -> i
        }
        doğru -> döndür
    }
    yanlış -> döndür
}

# Hata mesajlarındaki yazımı. nehir.py'de bilinmeyen bir tür, bağlanmış olsa da
# kendi adıyla yazılır; ham_ad bunu, tür_adı çözülmüş hâlini verir.
işlev ham_ad(t) {
    bilinmeyen_mi(t) -> eğer {
        yok_mu(t) -> eğer { "yok" -> döndür }
        "henüz bilinmeyen tür" -> döndür
    }
    kayıt_mı(t) -> eğer { kayıt_adı(t) -> döndür }
    işlev_türü_mü(t) -> eğer {
        işlev_parçaları(t) -> parçalar
        [] -> adlar
        parçalar -> her (p) { adlar -> ekle(işlev_içi_ad(p)) }
        adlar -> sil(uzunluk(adlar) - 1) -> dönüş
        "işlev(" + birleş(adlar, ", ") + ") -> " + dönüş -> döndür
    }
    liste_mi(t) -> eğer {
        çöz(eleman_türü(t)) -> el
        bilinmeyen_mi(el) -> eğer { "boş liste" -> döndür }
        ham_ad(el) + " listesi" -> döndür
    }
    sözlük_mi(t) -> eğer {
        çöz(anahtar_kısmı(t)) -> a
        çöz(değer_kısmı(t)) -> v
        bilinmeyen_mi(a) veya bilinmeyen_mi(v) -> eğer { "boş sözlük" -> döndür }
        ham_ad(a) + " → " + ham_ad(v) + " sözlüğü" -> döndür
    }
    t -> döndür
}

# İşlev türünün yazımında bilinmeyen parça "?" diye yazılır.
işlev işlev_içi_ad(t) {
    çöz(t) -> t
    bilinmeyen_mi(t) ve değil yok_mu(t) -> eğer { "?" -> döndür }
    ham_ad(t) -> döndür
}

# nehir.py'de kabın içindeki henüz bilinmeyen tür "None" diye yazılır.
işlev bilinen_adı(t) {
    çöz(t) -> t
    bilinmeyen_mi(t) -> eğer { "None" -> döndür }
    ham_ad(t) -> döndür
}
işlev tür_adı(t) { ham_ad(çöz(t)) -> döndür }

işlev tür_listesi(türler) {
    [] -> adlar
    türler -> her (t) { adlar -> ekle(tür_adı(t)) }
    birleş(adlar, ", ") -> döndür
}
işlev ham_listesi(türler) {
    [] -> adlar
    türler -> her (t) { adlar -> ekle(ham_ad(t)) }
    birleş(adlar, ", ") -> döndür
}

# ── durum ──

[] -> ortak k_kod           # o anda derlenen gövdenin assembly satırları
[] -> k_işlev_kodu          # derlenmiş işlevlerin satırları, derlenme sırasıyla
[] -> k_metinler            # programdaki metinler, ilk görülme sırasıyla
{} -> k_metin_no            # metin -> k_metinler'deki sırası
[] -> k_ondalıklar          # ondalık sayıların yazımları (assembler ikiliye çevirir)
{} -> k_ondalık_no
[] -> k_küreseller          # üst düzey değişkenlerin adları, toplanma sırasıyla
{} -> k_küresel_etiket      # ad -> bellekteki yerinin etiketi (g0, g1, ...)
{} -> k_küresel_tür         # ad -> tür ("" henüz değer akmadı)
{} -> k_ortaklar            # işlevlerin de atayabildiği üst düzey değişkenler
[] -> k_tür_tanımları       # çalışma zamanı tür tanımları (yazdırma için)
{} -> k_tür_etiketi         # tanım alanları -> etiketi (t0, t1, ...)
0 -> ortak k_etiket_no      # son üretilen .L etiketinin numarası
0 -> ortak k_çatal          # o anda yığında bekleyen çatal değerlerinin sayısı

# İç içe döngüler (koşut listeler): devam ve çıkış etiketleri, girildiği andaki çatal derinliği
[] -> ortak k_döngü_devam
[] -> ortak k_döngü_son
[] -> ortak k_döngü_çatal

# İşlevler. Her işlev ilk çağrıldığı yerde, o çağrının argüman türleriyle derlenir.
{} -> k_işlev               # ad -> işlev düğümü
[] -> k_işlev_adları        # tanım sırasıyla
{} -> k_işlev_etiket        # ad -> f0, f1, ...
{} -> k_işlev_türler        # ad -> parametre türleri (ilk çağrıda belirlenir)
{} -> k_işlev_dönüş         # ad -> dönüş türü ("" henüz belli değil)
{} -> k_işlev_durum         # ad -> 0 derlenmedi, 1 derleniyor, 2 derlendi
{} -> k_işlev_sona          # ad -> gövdenin sonuna ulaşılabiliyor mu
{} -> k_işlev_örnekleri     # ad -> örneklerin anahtarları (ad, ad§1, ...); yalnızca birden çok örnekte
{} -> k_dönmeyen            # hiç geri dönmeyen işlevler (her yolu çık'a varır)
[] -> k_değer_işlevler      # değer olarak verilip henüz derlenmemiş işlevler

# Kayıtlar: alan adları ve türleri (tanımdan ya da kullanımdan öğrenilir)
{} -> k_kayıt_alanları      # ad -> [alan adları]
{} -> k_kayıt_türleri       # ad -> [alan türleri]
{} -> k_kayıt_etiketi       # ad ("" yok için) -> çalışma zamanı tanımının etiketi (kt0, ...)

# Hata ve uyarılar
"" -> ortak k_varsayılan_ipucu      # ipucusuz hatalara eklenecek ipucu
"" -> ortak k_değer_bağlamı         # derlenmekte olan, değer olarak verilmiş işlev
{} -> k_değer_yeri                  # işlev -> ilk kez değer olarak verildiği yer
[] -> k_uyarı_yeri
[] -> k_uyarı_mesajı
[] -> k_uyarı_ipucu
[] -> k_yazım_adayları
{} -> k_küresel_konum               # üst düzey değişken -> ilk atandığı yer
{} -> k_küresel_okundu
{} -> ortak k_yerel_konum
{} -> ortak k_yerel_okundu
[""] -> ortak k_yerel_sıra          # yerel değişkenler, oluşturulma sırasıyla
k_yerel_sıra -> sil(0)              # (bir metinle başlatılır ki eleman türü baştan belli olsun)

# Derlenmekte olan işlev ("" ise en üst düzey) ve onun yerel değişkenleri
"" -> ortak k_geçerli
{} -> ortak k_yerel_yer     # ad -> bellek adresi ([rbp+16], [rbp-8], ...)
{} -> ortak k_yerel_tür     # ad -> tür
0 -> ortak k_yerel_sayısı
{} -> ortak k_okunan        # bu işlevde okunan üst düzey değişkenler

# ── yardımcılar ──

işlev k_hata(mesaj, d) { k_hata_i(mesaj, d, "") }

# İpucu verilmemişse o anki varsayılan ipucu kullanılır. Değer olarak verilen bir işlev
# derlenirken çıkan hataya, işlevin değer olarak verildiği yer not olarak eklenir.
işlev k_hata_i(mesaj, d, ipucu) {
    ipucu == "" -> eğer { k_varsayılan_ipucu -> ipucu }
    k_değer_bağlamı != "" -> eğer {
        k_hata_not(mesaj, d, ipucu, k_değer_yeri[k_değer_bağlamı],
                   "'" + k_değer_bağlamı + "' burada değer olarak verildi; parametre türleri "
                   + "onu tutan değişken üzerinden yapılan çağrılardan çıkarıldı")
    }
    hata_ver(mesaj, d.dosya, d.satır, d.sütun, d.uzunluk, ipucu, İLGİSİZ, "")
}

işlev k_hata_not(mesaj, d, ipucu, ilgili, ilgili_not) {
    ipucu == "" -> eğer { k_varsayılan_ipucu -> ipucu }
    hata_ver(mesaj, d.dosya, d.satır, d.sütun, d.uzunluk, ipucu, ilgili, ilgili_not)
}

# ── yazım hatası önerileri ──

işlev karakterler(m) {
    [] -> l
    m -> her (k) { l -> ekle(k) }
    l -> döndür
}

işlev sırala(liste) {
    [] -> sonuç
    liste -> her (x) {
        sonuç -> ekle(x)
        uzunluk(sonuç) - 1 -> i
        i > 0 ve sonuç[i - 1] > x -> iken {
            sonuç[i - 1] -> sonuç[i]
            i - 1 -> i
        }
        x -> sonuç[i]
    }
    sonuç -> döndür
}

# Düzenleme (Levenshtein) uzaklığı.
işlev uzaklık(a, b) {
    karakterler(a) -> x
    karakterler(b) -> y
    aralık(0, uzunluk(y) + 1) -> önceki
    0 -> i
    i < uzunluk(x) -> iken {
        [i + 1] -> şimdiki
        0 -> j
        j < uzunluk(y) -> iken {
            önceki[j + 1] + 1 -> en_az
            şimdiki[j] + 1 < en_az -> eğer { şimdiki[j] + 1 -> en_az }
            önceki[j] -> değiştir
            x[i] != y[j] -> eğer { değiştir + 1 -> değiştir }
            değiştir < en_az -> eğer { değiştir -> en_az }
            şimdiki -> ekle(en_az)
            j + 1 -> j
        }
        şimdiki -> önceki
        i + 1 -> i
    }
    önceki[uzunluk(y)] -> döndür
}

# a[alo:ahi] ile b[blo:bhi] arasındaki eşleşen karakter sayısı; Python'daki
# difflib.SequenceMatcher'ın eşleşen bloklarının toplam uzunluğu. En uzun ortak parça
# (eşitlikte a'da, sonra b'de en soldaki) bulunur, sonra iki yanı için yinelenir.
işlev eşleşen(a, b, alo, ahi, blo, bhi) {
    alo -> bi
    blo -> bj
    0 -> bk
    alo -> i
    i < ahi -> iken {
        blo -> j
        j < bhi -> iken {
            0 -> k
            i + k < ahi ve j + k < bhi ve a[i + k] == b[j + k] -> iken { k + 1 -> k }
            k > bk -> eğer {
                i -> bi
                j -> bj
                k -> bk
            }
            j + 1 -> j
        }
        i + 1 -> i
    }
    bk == 0 -> eğer { 0 -> döndür }
    bk -> toplam
    alo < bi ve blo < bj -> eğer { toplam + eşleşen(a, b, alo, bi, blo, bj) -> toplam }
    bi + bk < ahi ve bj + bk < bhi -> eğer { toplam + eşleşen(a, b, bi + bk, ahi, bj + bk, bhi) -> toplam }
    toplam -> döndür
}

# Yazım hatası için "şunu mu demek istediniz" ipucu: difflib.get_close_matches(n=2,
# cutoff=0.7) gibi, benzerlik oranı 2*M/T en az 0,7 olan en iyi iki aday (eşitlikte
# sözlük sırasında büyük olan önce). Benzer ad yoksa "".
# Dosyaya özel adların sonundaki görünmez işaretlerin (U+2063) sayısı; özel değilse 0.
işlev gizli_eki(ad) {
    uzunluk(ad) -> i
    i > 0 -> iken {
        ad[i - 1] != karakter(8291) -> eğer { dur }
        i - 1 -> i
    }
    uzunluk(ad) - i -> döndür
}

"'_' ile başlayan adlar yalnızca tanımlandıkları dosyada geçerlidir" -> ÖZEL_AD_İPUCU

# Başka dosyalara özel adlar önerilmez.
işlev benzerler(ad, adaylar) {
    gizli_eki(ad) -> ad_eki
    [] -> süzülmüş
    adaylar -> her (x) { gizli_eki(x) == ad_eki -> eğer { süzülmüş -> ekle(x) } }
    süzülmüş -> adaylar
    karakterler(ad) -> a
    {} -> görülen
    [] -> uygun
    [] -> uygun_m
    [] -> uygun_t
    adaylar -> her (x) {
        x != ad ve değil var(görülen, x) -> eğer {
            1 -> görülen[x]
            karakterler(x) -> b
            eşleşen(a, b, 0, uzunluk(a), 0, uzunluk(b)) -> m
            uzunluk(a) + uzunluk(b) -> t
            20 * m >= 7 * t -> eğer {
                uygun -> ekle(x)
                uygun_m -> ekle(m)
                uygun_t -> ekle(t)
            }
        }
    }
    [] -> seçilen
    {} -> alındı
    0 -> tur
    tur < 2 -> iken {
        -1 -> en_iyi
        0 -> i
        i < uzunluk(uygun) -> iken {
            değil var(alındı, uygun[i]) -> eğer {
                en_iyi < 0 -> eğer { i -> en_iyi } değilse {
                    uygun_m[i] * uygun_t[en_iyi] -> sol
                    uygun_m[en_iyi] * uygun_t[i] -> sağ
                    sol > sağ veya (sol == sağ ve uygun[i] > uygun[en_iyi]) -> eğer { i -> en_iyi }
                }
            }
            i + 1 -> i
        }
        en_iyi < 0 -> eğer { dur }
        1 -> alındı[uygun[en_iyi]]
        seçilen -> ekle("'" + uygun[en_iyi] + "'")
        tur + 1 -> tur
    }
    uzunluk(seçilen) == 0 -> eğer { "" -> döndür }
    birleş(seçilen, " ya da ") + " mi demek istediniz?" -> döndür
}

işlev bilinen_değişkenler() {
    [] -> adlar
    k_küreseller -> her (ad) { k_küresel_tür[ad] != "" -> eğer { adlar -> ekle(ad) } }
    k_geçerli != "" -> eğer {
        k_yerel_tür -> her (ad) { k_yerel_tür[ad] != "" -> eğer { adlar -> ekle(ad) } }
    }
    adlar -> döndür
}

# ── uyarılar ──

işlev uyarı_ekle(d, mesaj, ipucu) {
    k_uyarı_yeri -> ekle(d)
    k_uyarı_mesajı -> ekle(mesaj)
    k_uyarı_ipucu -> ekle(ipucu)
}

# Yazım hatası uyarısının adayları: işlev, yerleşik işlev ve anahtar kelime adları, sıralı.
işlev yazım_adayları() {
    uzunluk(k_yazım_adayları) == 0 -> eğer {
        {} -> küme
        k_işlev_adları -> her (a) { 1 -> küme[a] }
        YERLEŞİK_ADLAR -> her (a) { 1 -> küme[a] }
        ANAHTARLAR -> her (a) { 1 -> küme[a] }
        anahtarlar(küme) -> sırala -> her (a) { k_yazım_adayları -> ekle(a) }
    }
    k_yazım_adayları -> döndür
}

# Hiç okunmayan bir değişken: yerelse ve aynı adlı üst düzey değişken varsa, büyük
# olasılıkla 'ortak' unutulmuştur; değilse bir işlev ya da anahtar kelimeye çok
# benziyorsa büyük olasılıkla yazım hatasıdır (`5 -> kere` yeni bir değişken oluşturur).
işlev okunmayanı_bildir(ad, d, yerel) {
    yerel ve var(k_küresel_etiket, ad) -> eğer {
        uyarı_ekle(d, "'" + ad + "' burada yerel bir değişken oluşturuyor ve hiç okunmuyor; "
                   + "aynı adlı üst düzey değişken değişmez",
                   "üst düzey değişkeni değiştirmek için onu 'ortak' ile tanımlayın:  değer -> ortak " + ad)
    } değilse {
        # Yanlış alarm vermemek için yalnızca çok yakın adlar sayılır.
        1 -> sınır
        uzunluk(ad) >= 8 -> eğer { 2 -> sınır }
        [] -> yakın
        uzunluk(ad) >= 4 -> eğer {
            yazım_adayları() -> her (a) {
                uzunluk(a) >= 3 ve uzunluk(yakın) < 2 -> eğer {
                    uzaklık(ad, a) <= sınır -> eğer { yakın -> ekle("'" + a + "'") }
                }
            }
        }
        uzunluk(yakın) > 0 -> eğer {
            uyarı_ekle(d, "'" + ad + "' yeni bir değişken olarak tanımlandı ama hiç okunmuyor",
                       birleş(yakın, " ya da ") + " mi demek istediniz?")
        }
    }
}

# Uyarıları kaynak sırasıyla (dosya, satır; eşitlikte eklenme sırası) yazar.
işlev uyarıları_yaz() {
    [] -> sıra
    0 -> i
    i < uzunluk(k_uyarı_yeri) -> iken {
        sıra -> ekle(i)
        uzunluk(sıra) - 1 -> j
        j > 0 ve önce_mi(i, sıra[j - 1]) -> iken {
            sıra[j - 1] -> sıra[j]
            j - 1 -> j
        }
        i -> sıra[j]
        i + 1 -> i
    }
    sıra -> her (u) {
        k_uyarı_yeri[u] -> d
        bildir("uyarı", k_uyarı_mesajı[u], d.dosya, d.satır, d.sütun, d.uzunluk, k_uyarı_ipucu[u])
    }
}

işlev önce_mi(a, b) {
    k_uyarı_yeri[a] -> x
    k_uyarı_yeri[b] -> y
    x.dosya < y.dosya veya (x.dosya == y.dosya ve x.satır < y.satır) -> döndür
}

işlev desteklenmiyor(ne, d) {
    a_dosyalar[d.dosya] + ":" + metne(d.satır) + ":" + metne(d.sütun) + ": henüz desteklenmiyor: " + ne -> uyar
    çık(3)
}

işlev yaz(satır) { k_kod -> ekle("    " + satır) }
işlev etiket_koy(etiket) { k_kod -> ekle(etiket + ":") }

# Türü sonradan belli olabilecek bir değerin tür tanımının adresi yazmaca (rsi ya
# da rdx) yüklenir. Etiket derlemenin sonunda konur; o zamana dek satırda işaret durur.
işlev tür_satırı(yazmaç, tür) { k_kod -> ekle("§TÜR§" + yazmaç + tür) }

# Hata verebilen çalışma zamanı işlemlerinden önce r15'e d'nin kaynak dosyası (üst yarı)
# ve satırı (alt yarı) yüklenir.
işlev komut(satır, d) {
    RİSKLİ -> var(satır) -> eğer { yaz("mov r15, " + metne(d.dosya * 4294967296 + d.satır)) }
    yaz(satır)
}

işlev yeni_etiket() {
    k_etiket_no + 1 -> k_etiket_no
    ".L" + metne(k_etiket_no) -> döndür
}

işlev metin_etiketi(m) {
    değil var(k_metin_no, m) -> eğer {
        uzunluk(k_metinler) -> k_metin_no[m]
        k_metinler -> ekle(m)
    }
    "m" + metne(k_metin_no[m]) -> döndür
}

# Türün çalışma zamanı tanımı: {kod, 1. parametre, 2. parametre}; kod 0 sayı, 1 metin,
# 2 liste (eleman), 3 sözlük (anahtar, değer).
# Hiç belli olmamış tür (boş listenin elemanı) sayı sayılır.
işlev tür_etiketi(tür) {
    çöz(tür) -> tür
    kayıtsı(tür) -> eğer { kayıt_etiketi(tür) -> döndür }
    "0, 0, 0" -> alanlar
    tür == "metin" -> eğer { "1, 0, 0" -> alanlar }
    tür == "ondalık" -> eğer { "6, 0, 0" -> alanlar }
    işlev_türü_mü(tür) -> eğer { "5, 0, 0" -> alanlar }
    liste_mi(tür) -> eğer { "2, " + tür_etiketi(eleman_türü(tür)) + ", 0" -> alanlar }
    sözlük_mi(tür) -> eğer {
        tür_etiketi(anahtar_kısmı(tür)) -> a
        "3, " + a + ", " + tür_etiketi(değer_kısmı(tür)) -> alanlar
    }
    değil var(k_tür_etiketi, alanlar) -> eğer {
        "t" + metne(uzunluk(k_tür_etiketi)) -> etiket       # kayıt tanımları (kt) ayrı sayılır
        etiket -> k_tür_etiketi[alanlar]
        k_tür_tanımları -> ekle(etiket + ": .quad " + alanlar)
    }
    k_tür_etiketi[alanlar] -> döndür
}

# Kaydın tanımı: {4, ad, alan sayısı, (alan adı, alan türü tanımı)...}. Etiket, alan
# türleri işlenmeden önce verilir ki kendine gönderme yapan kayıtlar onu bulabilsin;
# tanım satırı alanlarınkinden sonra eklenir. Türü hiç belli olmamış `yok` alansızdır.
işlev kayıt_etiketi(tür) {
    "" -> ad
    kayıt_mı(tür) -> eğer { kayıt_adı(tür) -> ad }
    değil var(k_kayıt_etiketi, ad) -> eğer {
        "kt" + metne(uzunluk(k_kayıt_etiketi)) -> etiket    # "k0" bir yazmaç adıdır
        etiket -> k_kayıt_etiketi[ad]
        "yok" -> görünen
        ad != "" -> eğer { ad -> görünen }
        ["4", metin_etiketi(görünen)] -> parçalar
        ad == "" -> eğer { parçalar -> ekle("0") } değilse {
            k_kayıt_alanları[ad] -> alanlar
            parçalar -> ekle(metne(uzunluk(alanlar)))
            0 -> i
            i < uzunluk(alanlar) -> iken {
                parçalar -> ekle(metin_etiketi(alanlar[i]))
                parçalar -> ekle(tür_etiketi(k_kayıt_türleri[ad][i]))
                i + 1 -> i
            }
        }
        k_tür_tanımları -> ekle(etiket + ": .quad " + birleş(parçalar, ", "))
    }
    k_kayıt_etiketi[ad] -> döndür
}

işlev sayı_olmalı(tür, ne, d) {
    çöz(tür) -> tür
    bilinmeyen_mi(tür) ve değil yok_mu(tür) -> eğer { "sayı" -> k_bağ[tür] } değilse {     # burada sayı olarak kullanılıyor
        tür != "sayı" -> eğer {
            "" -> ipucu
            işlev_türü_mü(tür) -> eğer { "bu bir işlevin kendisi; çağırmak için adının ardına (...) yazın" -> ipucu }
            k_hata_i(ne + " sayı olmalı, " + ham_ad(tür) + " bulundu", d, ipucu)
        }
    }
}

# Anahtarın türünü sözlüğünkiyle eşitler ve tür kodunu edx'e yükler.
işlev anahtarı_denetle(sözlük, anahtar, d) {
    anahtar != "sayı" ve anahtar != "metin" -> eğer {
        k_hata("sözlük anahtarı sayı ya da metin olmalı, " + ham_ad(anahtar) + " bulundu", d)
    }
    değil birleştir(anahtar_kısmı(sözlük), anahtar) -> eğer {
        k_hata("bu sözlüğün anahtarları " + bilinen_adı(anahtar_kısmı(sözlük)) + "; " + anahtar + " verildi", d)
    }
    anahtar == "sayı" -> eğer { yaz("mov edx, 0") } değilse { yaz("mov edx, 1") }
}

işlev yerleşik_mi(ad) { var(YERLEŞİK_ADLAR, ad) -> döndür }
işlev çağrılabilir(ad) {
    var(k_işlev, ad) veya var(k_kayıt_alanları, ad) veya var(YERLEŞİK_ADLAR, ad) -> döndür
}

# ── kayıtlar ──

# Kayıt tanımındaki tür yazımını türe çevirir.
işlev tür_çöz(t) {
    t.tür == "tür_liste" -> eğer { liste_türü(tür_çöz(t.çocuklar[0])) -> döndür }
    t.tür == "tür_sözlük" -> eğer {
        tür_çöz(t.çocuklar[0]) -> anahtar
        anahtar != "sayı" ve anahtar != "metin" -> eğer {
            k_hata("sözlük anahtarı sayı ya da metin olmalı, " + ham_ad(anahtar) + " bulundu", t.çocuklar[0])
        }
        sözlük_türü(anahtar, tür_çöz(t.çocuklar[1])) -> döndür
    }
    t.ad == "sayı" veya t.ad == "sayi" veya t.ad == "number" -> eğer { "sayı" -> döndür }
    t.ad == "metin" veya t.ad == "text" -> eğer { "metin" -> döndür }
    t.ad == "ondalık" veya t.ad == "ondalik" veya t.ad == "float" -> eğer { "ondalık" -> döndür }
    var(k_kayıt_alanları, t.ad) -> eğer { "@" + t.ad -> döndür }
    k_hata_i("'" + t.ad + "' adında bir tür yok", t, benzerler(t.ad, ["sayı", "metin", "ondalık"] + anahtarlar(k_kayıt_alanları)))
}

# Alanın kayıttaki sırası; tür çözülmüş olmalı.
işlev alan_sırası(tür, alan, d) {
    bilinmeyen_mi(tür) -> eğer {
        k_hata_i("'." + alan + "' alanına erişilen değerin türü henüz belli değil", d,
                 "kayıt tanımında alanın türünü yazmak bunu çözer:  kayıt Ad { alan: Tür }")
    }
    değil kayıt_mı(tür) -> eğer {
        k_hata("'." + alan + "': alanlara yalnızca kayıtlarda erişilir, " + ham_ad(tür) + " bulundu", d)
    }
    k_kayıt_alanları[kayıt_adı(tür)] -> alanlar
    0 -> i
    i < uzunluk(alanlar) -> iken {
        alanlar[i] == alan -> eğer { i -> döndür }
        i + 1 -> i
    }
    benzerler(alan, alanlar) -> ipucu
    ipucu == "" -> eğer { "alanları: " + birleş(alanlar, ", ") -> ipucu }
    k_hata_i("'" + kayıt_adı(tür) + "' kaydında '" + alan + "' adında bir alan yok", d, ipucu)
}

işlev alan_türü(tür, sıra) { k_kayıt_türleri[kayıt_adı(tür)][sıra] -> döndür }

işlev parametre_sayısı(f) { uzunluk(f.çocuklar) - 1 -> döndür }
işlev gövdesi(f) { f.çocuklar[uzunluk(f.çocuklar) - 1] -> döndür }
işlev hedefleri(d) { dilim(d.çocuklar, 1, uzunluk(d.çocuklar)) -> döndür }

# ── değişkenler ──

işlev yerel_mi(ad) { k_geçerli != "" ve var(k_yerel_yer, ad) -> döndür }
işlev değişken_var_mı(ad) { yerel_mi(ad) veya var(k_küresel_etiket, ad) -> döndür }

işlev değişken_adresi(ad) {
    yerel_mi(ad) -> eğer { k_yerel_yer[ad] -> döndür }
    "[rip+" + k_küresel_etiket[ad] + "]" -> döndür
}

işlev değişken_türü(ad) {
    yerel_mi(ad) -> eğer { k_yerel_tür[ad] -> döndür }
    k_küresel_tür[ad] -> döndür
}

işlev yerel_ekle(ad) {
    k_yerel_sayısı + 1 -> k_yerel_sayısı
    "[rbp-" + metne(8 * k_yerel_sayısı) + "]" -> k_yerel_yer[ad]
    "" -> k_yerel_tür[ad]
    k_yerel_sıra -> ekle(ad)
}

işlev okundu(ad) {
    yerel_mi(ad) -> eğer { 1 -> k_yerel_okundu[ad] } değilse { 1 -> k_küresel_okundu[ad] }
}

# İşlev içindeki atama yerel değişken oluşturur; tek istisna `ortak` ile tanımlanmış
# üst düzey değişkenlerdir.
işlev ata(ad, tür, d) {
    k_geçerli != "" ve değil var(k_yerel_yer, ad) ve değil var(k_ortaklar, ad) -> eğer {
        k_okunan -> var(ad) -> eğer {
            İLGİSİZ -> ilgili
            var(k_küresel_konum, ad) -> eğer { k_küresel_konum[ad] -> ilgili }
            k_hata_not("'" + ad + "' bu işlevde üst düzey değişken olarak okundu; ona burada atanamaz", d,
                       "işlevlerin değiştirebildiği değişkenler 'ortak' ile tanımlanır:  değer -> ortak " + ad,
                       ilgili, "'" + ad + "' burada tanımlanmış")
        }
        yerel_ekle(ad)
    }
    değil değişken_var_mı(ad) -> eğer { yerel_ekle(ad) }
    değişken_türü(ad) -> önceki
    önceki == "" -> eğer {
        yerel_mi(ad) -> eğer {
            tür -> k_yerel_tür[ad]
            d -> k_yerel_konum[ad]
        } değilse {
            tür -> k_küresel_tür[ad]
            d -> k_küresel_konum[ad]
        }
    } değilse {
        değil birleştir(önceki, tür) -> eğer {
            "" -> ipucu
            çöz(önceki) == "sayı" ve tür == "ondalık" -> eğer {
                "değişken ondalık olacaksa ilk değerini de ondalık yazın:  0.0" -> ipucu
            }
            k_hata_i("'" + ad + "' değişkeni " + ham_ad(önceki) + " türünde; " + tür_adı(tür) + " atanamaz", d, ipucu)
        }
    }
    yaz("mov " + değişken_adresi(ad) + ", rax")
}

# ── üst düzey değişkenler ──
# En üst düzeyde (iç içe bloklar dahil) atanan her ad küresel değişkendir;
# kod üretilmeden önce hepsi toplanır.

işlev küresel(ad) {
    değil var(k_küresel_etiket, ad) -> eğer {
        "g" + metne(uzunluk(k_küreseller)) -> k_küresel_etiket[ad]
        "" -> k_küresel_tür[ad]
        k_küreseller -> ekle(ad)
    }
}

işlev küreselleri_topla(deyimler) {
    deyimler -> her (d) {
        d.tür == "akış" -> eğer { hedeflerden_topla(hedefleri(d)) }
    }
}

işlev hedeflerden_topla(hedefler) {
    hedefler -> her (h) {
        h.tür == "hedef_ad" ve uzunluk(h.çocuklar) == 0 ve değil çağrılabilir(h.ad) -> eğer {
            küresel(h.ad)
        }
        h.tür == "eğer" -> eğer { h.çocuklar -> her (b) { küreselleri_topla(b.çocuklar) } }
        h.tür == "iken" -> eğer { küreselleri_topla(h.çocuklar[0].çocuklar) }
        h.tür == "ortak" -> eğer {
            küresel(h.ad)
            1 -> k_ortaklar[h.ad]
        }
        h.tür == "her" -> eğer {
            küresel(h.ad)
            küreselleri_topla(h.çocuklar[0].çocuklar)
        }
        h.tür == "çatal" -> eğer { h.çocuklar -> her (dal) { hedeflerden_topla(dal.çocuklar) } }
    }
}

# ── akış çözümlemesi ──
# Sözdizimine bakarak denetimin bir bloğun sonuna ulaşıp ulaşamayacağını bulur.
# Temkinlidir: emin olamadığı her yerde "ulaşabilir" der.

işlev dönmez(ad) {
    var(k_işlev, ad) -> eğer { var(k_dönmeyen, ad) -> döndür }
    (ad == "çık" veya ad == "cik" veya ad == "exit") ve değil var(k_kayıt_alanları, ad) -> döndür
}

işlev tamamlanır(deyimler) {
    deyimler -> her (d) { değil deyim_tamamlanır(d) -> eğer { yanlış -> döndür } }
    doğru -> döndür
}

işlev deyim_tamamlanır(d) {
    d.tür != "akış" -> eğer { yanlış -> döndür }       # dur, devam
    d.çocuklar[0] -> kaynak
    kaynak.tür == "çağrı" ve dönmez(kaynak.ad) -> eğer { yanlış -> döndür }
    hedefler_tamamlanır(hedefleri(d), kaynak) -> döndür
}

# `kaynak` zincirin başındaki ifadedir; çatal kollarında yoktur.
işlev hedefler_tamamlanır(hedefler, kaynak) {
    hedefler -> her (h) {
        h.tür == "döndür" -> eğer { yanlış -> döndür }
        h.tür == "hedef_ad" ve dönmez(h.ad) -> eğer { yanlış -> döndür }
        h.tür == "eğer" ve uzunluk(h.çocuklar) > 1 -> eğer {
            değil tamamlanır(h.çocuklar[0].çocuklar) ve değil tamamlanır(h.çocuklar[1].çocuklar) -> eğer {
                yanlış -> döndür
            }
        }
        h.tür == "iken" -> eğer {
            # `doğru -> iken { }` yalnızca içindeki bir 'dur' ile biter.
            kaynak != yok ve uzunluk(hedefler) == 1 -> eğer {
                kaynak.tür == "sayı" ve kaynak.sayı != 0 -> eğer {
                    değil içerir_mi(h.çocuklar[0].çocuklar, "dur", yanlış) -> eğer { yanlış -> döndür }
                }
            }
        }
        h.tür == "çatal" -> eğer {
            h.çocuklar -> her (dal) {
                değil hedefler_tamamlanır(dal.çocuklar, yok) -> eğer { yanlış -> döndür }
            }
        }
    }
    doğru -> döndür
}

# Blokta (iç içe bloklar dahil) 'döndür' hedefi ya da 'dur' deyimi var mı?
# 'dur' aranırken iç döngülere girilmez: oradaki 'dur' o döngüye aittir.
işlev içerir_mi(deyimler, aranan, döngülere_gir) {
    deyimler -> her (d) {
        d.tür == aranan -> eğer { doğru -> döndür }
        d.tür == "akış" -> eğer {
            hedefte_var(hedefleri(d), aranan) -> eğer { doğru -> döndür }
            alt_bloklarda_var(hedefleri(d), aranan, döngülere_gir) -> eğer { doğru -> döndür }
        }
    }
    yanlış -> döndür
}

işlev hedefte_var(hedefler, aranan) {
    hedefler -> her (h) {
        h.tür == aranan -> eğer { doğru -> döndür }
        h.tür == "çatal" -> eğer {
            h.çocuklar -> her (dal) { hedefte_var(dal.çocuklar, aranan) -> eğer { doğru -> döndür } }
        }
    }
    yanlış -> döndür
}

işlev alt_bloklarda_var(hedefler, aranan, döngülere_gir) {
    hedefler -> her (h) {
        h.tür == "eğer" -> eğer {
            h.çocuklar -> her (b) { içerir_mi(b.çocuklar, aranan, döngülere_gir) -> eğer { doğru -> döndür } }
        }
        (h.tür == "iken" veya h.tür == "her") ve döngülere_gir -> eğer {
            içerir_mi(h.çocuklar[0].çocuklar, aranan, döngülere_gir) -> eğer { doğru -> döndür }
        }
        h.tür == "çatal" -> eğer {
            h.çocuklar -> her (dal) {
                alt_bloklarda_var(dal.çocuklar, aranan, döngülere_gir) -> eğer { doğru -> döndür }
            }
        }
    }
    yanlış -> döndür
}

# Hiç dönmeyen işlevler: gövdesinin sonuna ulaşılamayan ve hiç 'döndür' içermeyen
# işlevler. Birbirlerini çağırabildikleri için küme, değişmeyene dek yeniden hesaplanır.
işlev dönmeyenleri_bul() {
    doğru -> değişti
    değişti -> iken {
        yanlış -> değişti
        k_işlev_adları -> her (ad) {
            gövdesi(k_işlev[ad]).çocuklar -> gövde
            değil var(k_dönmeyen, ad) ve değil içerir_mi(gövde, "döndür", doğru) ve değil tamamlanır(gövde) -> eğer {
                1 -> k_dönmeyen[ad]
                doğru -> değişti
            }
        }
    }
}

# ── işlevler ──

işlev çağır(ad, arg_düğümleri, d, akan) {
    # Akan değer (varsa) çağıran tarafından zaten yığına itilmiştir ve ilk argümandır.
    [] -> önceki
    akan != "" -> eğer { önceki -> ekle(akan) }
    çağır_öncekiyle(ad, arg_düğümleri, d, önceki, akan) -> döndür
}

# nesne.yöntem(...) çağrısının işlev adı: Kayıt.yöntem
işlev yöntem_adı(nesne_türü, yöntem, d) {
    çöz(nesne_türü) -> t
    değil kayıt_mı(t) -> eğer {
        k_hata("'." + yöntem + "(...)': yöntemler yalnızca kayıtlarda çağrılır, " + ham_ad(t) + " bulundu", d)
    }
    dilim(t, 1, uzunluk(t)) -> sahip
    sahip + "." + yöntem -> ad
    değil var(k_işlev, ad) -> eğer {
        [] -> yöntemler
        k_işlev_adları -> her (a) {
            dilim(a, 0, uzunluk(sahip) + 1) == sahip + "." -> eğer {
                yöntemler -> ekle(dilim(a, uzunluk(sahip) + 1, uzunluk(a)))
            }
        }
        benzerler(yöntem, yöntemler) -> ipucu
        ipucu == "" -> eğer {
            uzunluk(yöntemler) > 0 -> eğer { "yöntemleri: " + birleş(yöntemler, ", ") -> ipucu }
            değilse { "yöntem tanımı:  işlev " + sahip + "." + yöntem + "(nesne, ...) { ... }" -> ipucu }
        }
        k_hata_i("'" + sahip + "' kaydının '" + yöntem + "' adında bir yöntemi yok", d, ipucu)
    }
    ad -> döndür
}

# Türleri `önceki`de verilen değerler (sırayla) çağıran tarafından zaten yığına itilmiştir.
# `akan` boş değilse ilk değer akıştan gelmiştir (hata ipucu için).
işlev çağır_öncekiyle(ad, arg_düğümleri, d, önceki, akan) {
    [] + önceki -> türler
    arg_düğümleri -> her (a) {
        türler -> ekle(ifade_üret(a))
        yaz("push rax")
    }
    değişken_var_mı(ad) -> eğer {
        değişken_türü(ad) != "" -> eğer { değerle_çağır(ad, türler, d) -> döndür }
    }
    var(k_kayıt_alanları, ad) -> eğer {
        k_kayıt_alanları[ad] -> alanlar
        k_kayıt_türleri[ad] -> alan_türleri
        uzunluk(alanlar) != uzunluk(türler) -> eğer {
            k_hata_i("'" + ad + "' kaydının " + metne(uzunluk(alanlar)) + " alanı var, "
                     + metne(uzunluk(türler)) + " değer verildi", d, "tanımı: " + ad + "(" + birleş(alanlar, ", ") + ")")
        }
        0 -> i
        i < uzunluk(türler) -> iken {
            değil birleştir(alan_türleri[i], türler[i]) -> eğer {
                k_hata("'" + ad + "." + alanlar[i] + "' alanı " + tür_adı(alan_türleri[i]) + " türünde; "
                       + ham_ad(türler[i]) + " verildi", d)
            }
            i + 1 -> i
        }
        uzunluk(türler) -> boy
        boy < 1 -> eğer { 1 -> boy }
        yaz("mov edi, " + metne(8 * boy))
        komut("call __ayir", d)
        uzunluk(türler) - 1 -> sıra
        sıra >= 0 -> iken {
            yaz("pop rcx")
            yaz("mov [rax+" + metne(8 * sıra) + "], rcx")
            sıra - 1 -> sıra
        }
        "@" + ad -> döndür
    }
    değil var(k_işlev, ad) -> eğer {
        YERLEŞİK_ADLAR -> var(ad) -> eğer { yerleşik_çağır(ad, türler, d) -> döndür }
        değişken_var_mı(ad) -> eğer { k_hata("'" + ad + "' bir değişken, işlev değil", d) }
        benzerler(ad, k_işlev_adları + anahtarlar(YERLEŞİK_ADLAR)) -> ipucu
        ipucu == "" ve dilim(ad, 0, 1) == "_" -> eğer { ÖZEL_AD_İPUCU -> ipucu }
        k_hata_i("'" + ad + "' adında bir işlev yok", d, ipucu)
    }
    parametre_sayısı(k_işlev[ad]) -> beklenen
    # Çağrı tutmuyorsa ve ad yerleşik bir işlevin de adıysa, çağıran büyük olasılıkla
    # yerleşik olanı kastetmiştir; gölgeleyen tanım gösterilir.
    İLGİSİZ -> gölge
    yerleşik_mi(ad) -> eğer { k_işlev[ad] -> gölge }
    "yerleşik '" + ad + "' işlevini gölgeleyen tanım burada" -> gölge_notu
    uzunluk(türler) != beklenen -> eğer {
        [] -> parametre_adları
        0 -> i
        i < beklenen -> iken {
            parametre_adları -> ekle(k_işlev[ad].çocuklar[i].ad)
            i + 1 -> i
        }
        "tanımı: " + ad + "(" + birleş(parametre_adları, ", ") + ")" -> ipucu
        akan != "" -> eğer { ipucu + "; akıştan gelen değer ilk argüman sayılır" -> ipucu }
        k_hata_not("'" + ad + "' işlevi " + metne(beklenen) + " argüman bekliyor, "
                   + metne(uzunluk(türler)) + " verildi", d, ipucu, gölge, gölge_notu)
    }
    ad -> anahtar
    değil var(k_işlev_türler, ad) -> eğer { türler -> k_işlev_türler[ad] } değilse {
        örnek_seç(ad, türler, d, gölge, gölge_notu) -> anahtar
    }
    k_işlev_durum[anahtar] == 0 -> eğer { işlevi_derle(anahtar) }
    yaz("call " + k_işlev_etiket[anahtar])
    uzunluk(türler) > 0 -> eğer { yaz("add rsp, " + metne(8 * uzunluk(türler))) }
    k_işlev_dönüş[anahtar] == "" -> eğer {
        # Özyineleme: işlev hâlâ derleniyor ve henüz bir şey döndürmedi. Dönüş türü,
        # ilk 'döndür'de ya da sonucun kullanıldığı yerde belli olacak bir bilinmeyendir.
        yeni_tür_değişkeni() -> k_işlev_dönüş[anahtar]
    }
    k_işlev_dönüş[anahtar] -> döndür
}

# İki tür birleştirilebilir mi? birleştir'in tersine hiçbir bilinmeyeni bağlamaz.
işlev uyumlu(a, b) {
    çöz(a) -> a
    çöz(b) -> b
    a == b -> eğer { doğru -> döndür }
    bilinmeyen_mi(a) veya bilinmeyen_mi(b) -> eğer {
        a -> t
        b -> öteki
        değil bilinmeyen_mi(a) -> eğer {
            b -> t
            a -> öteki
        }
        yok_mu(t) ve değil bilinmeyen_mi(öteki) ve değil kayıt_mı(öteki) -> eğer { yanlış -> döndür }
        doğru -> döndür
    }
    liste_mi(a) ve liste_mi(b) -> eğer { uyumlu(eleman_türü(a), eleman_türü(b)) -> döndür }
    sözlük_mi(a) ve sözlük_mi(b) -> eğer {
        uyumlu(anahtar_kısmı(a), anahtar_kısmı(b)) ve uyumlu(değer_kısmı(a), değer_kısmı(b)) -> döndür
    }
    işlev_türü_mü(a) ve işlev_türü_mü(b) -> eğer {
        işlev_parçaları(a) -> pa
        işlev_parçaları(b) -> pb
        uzunluk(pa) != uzunluk(pb) -> eğer { yanlış -> döndür }
        0 -> i
        i < uzunluk(pa) -> iken {
            değil uyumlu(pa[i], pb[i]) -> eğer { yanlış -> döndür }
            i + 1 -> i
        }
        doğru -> döndür
    }
    yanlış -> döndür
}

# Bir işlev uyuşmayan türlerle de çağrılabilir: her tür imzası için ayrı bir örnek derlenir.
# Örneklerin anahtarları: ad (ilk örnek), ad§1, ad§2, ...; etiketleri f3, f3_1, f3_2, ...
# En çok EN_ÇOK_ÖRNEK örnek derlenir (f(x)'in f([x])'i çağırması gibi sonsuz üretime karşı).
32 -> EN_ÇOK_ÖRNEK

işlev görünen_ad(anahtar) { böl(anahtar, "§")[0] -> döndür }

işlev örnek_seç(ad, türler, d, gölge, gölge_notu) {
    değil var(k_işlev_örnekleri, ad) -> eğer { [ad] -> k_işlev_örnekleri[ad] }
    k_işlev_örnekleri[ad] -> örnekler
    örnekler -> her (anahtar) {
        k_işlev_türler[anahtar] -> önceki
        doğru -> uyar_mı
        0 -> i
        i < uzunluk(türler) -> iken {
            değil uyumlu(önceki[i], türler[i]) -> eğer { yanlış -> uyar_mı }
            i + 1 -> i
        }
        uyar_mı -> eğer {
            0 -> i
            i < uzunluk(türler) -> iken {
                değil birleştir(önceki[i], türler[i]) -> eğer {
                    k_hata_not("'" + ad + "' işlevi (" + tür_listesi(önceki) + ") ile çağrılmıştı; şimdi ("
                               + tür_listesi(türler) + ") veriliyor", d, "", gölge, gölge_notu)
                }
                i + 1 -> i
            }
            anahtar -> döndür
        }
    }
    uzunluk(örnekler) >= EN_ÇOK_ÖRNEK -> eğer {
        k_hata_not("'" + ad + "' işlevi " + metne(EN_ÇOK_ÖRNEK) + " farklı tür imzasıyla derlendi; daha fazlası derlenmez",
                   d, "işlev kendini her seferinde başka türde bir argümanla (örneğin [x]) mı çağırıyor?",
                   gölge, gölge_notu)
    }
    ad + "§" + metne(uzunluk(örnekler)) -> yeni
    k_işlev[ad] -> k_işlev[yeni]
    k_işlev_etiket[ad] + "_" + metne(uzunluk(örnekler)) -> k_işlev_etiket[yeni]
    türler -> k_işlev_türler[yeni]
    "" -> k_işlev_dönüş[yeni]
    0 -> k_işlev_durum[yeni]
    örnekler -> ekle(yeni)
    yeni -> döndür
}

# İşlev tutan bir değişken üzerinden çağrı; argümanlar yığına itilmiştir.
işlev değerle_çağır(ad, türler, d) {
    çöz(değişken_türü(ad)) -> tür
    bilinmeyen_mi(tür) ve değil yok_mu(tür) -> eğer {
        [] -> parametreler
        türler -> her (t) { parametreler -> ekle(yeni_tür_değişkeni()) }
        işlev_türü(parametreler, yeni_tür_değişkeni()) -> k_bağ[tür]
        çöz(tür) -> tür
    }
    değil işlev_türü_mü(tür) -> eğer {
        "" -> ipucu
        çağrılabilir(ad) -> eğer { "'" + ad + "' adlı değişken, aynı adlı işlevi gölgeliyor" -> ipucu }
        k_hata_i("'" + ad + "' bir değişken (" + ham_ad(tür) + "), işlev değil", d, ipucu)
    }
    işlev_parçaları(tür) -> parçalar
    uzunluk(parçalar) - 1 -> beklenen
    beklenen != uzunluk(türler) -> eğer {
        k_hata_i("'" + ad + "' " + metne(beklenen) + " argüman alan bir işlev tutuyor, "
                 + metne(uzunluk(türler)) + " verildi", d, "'" + ad + "' türü: " + ham_ad(tür))
    }
    0 -> i
    i < beklenen -> iken {
        değil birleştir(parçalar[i], türler[i]) -> eğer {
            k_hata_i("'" + ad + "' işlevinin " + metne(i + 1) + ". argümanı " + tür_adı(parçalar[i])
                     + " olmalı, " + ham_ad(türler[i]) + " verildi", d, "'" + ad + "' türü: " + ham_ad(tür))
        }
        i + 1 -> i
    }
    okundu(ad)
    k_geçerli != "" ve değil yerel_mi(ad) -> eğer { 1 -> k_okunan[ad] }
    yaz("mov rax, " + değişken_adresi(ad))
    yaz("call rax")
    uzunluk(türler) > 0 -> eğer { yaz("add rsp, " + metne(8 * uzunluk(türler))) }
    çöz(parçalar[beklenen]) -> döndür
}

# İşlevin adresini rax'e yükler ve türünü verir. Parametre türleri henüz belli değilse
# bilinmeyenlerle başlar; işlev en son derlenir (türleri o zamana dek öğrenilmiş olur).
işlev işlev_değeri(ad, d) {
    değil var(k_işlev_türler, ad) -> eğer {
        d -> k_değer_yeri[ad]
        [] -> türler
        0 -> i
        i < parametre_sayısı(k_işlev[ad]) -> iken {
            türler -> ekle(yeni_tür_değişkeni())
            i + 1 -> i
        }
        türler -> k_işlev_türler[ad]
        k_değer_işlevler -> ekle(ad)
    }
    k_işlev_dönüş[ad] == "" -> eğer { yeni_tür_değişkeni() -> k_işlev_dönüş[ad] }
    yaz("lea rax, [rip+" + k_işlev_etiket[ad] + "]")
    işlev_türü(k_işlev_türler[ad], k_işlev_dönüş[ad]) -> döndür
}

# Yerleşik işlevler; argümanları yığına itilmiştir. `ad` yazıldığı hâlidir.
işlev yerleşik_çağır(ad, türler, d) {
    YERLEŞİK_ADLAR[ad] -> asıl
    uzunluk(türler) -> n
    "" -> t0
    "" -> t1
    "" -> t2
    n > 0 -> eğer { türler[0] -> t0 }
    n > 1 -> eğer { türler[1] -> t1 }
    n > 2 -> eğer { türler[2] -> t2 }
    liste_mi(t0) -> ilk_liste
    sözlük_mi(t0) -> ilk_sözlük
    (asıl == "var" veya asıl == "sil") ve ilk_sözlük ve n == 2 -> eğer {
        yaz("pop rsi")
        yaz("pop rdi")
        anahtarı_denetle(t0, t1, d)
        asıl == "var" -> eğer {
            komut("call __sozluk_ara", d)
            yaz("not rax")              # dizin >= 0 ise 1, -1 ise 0
            yaz("shr rax, 63")
            "sayı" -> döndür
        }
        komut("call __sozluk_sil", d)
        çöz(değer_kısmı(t0)) -> döndür
    }
    asıl == "var" -> eğer { yanlış_argüman(ad, "sözlük, anahtar", türler, d) }
    asıl == "anahtarlar" veya asıl == "değerler" -> eğer {
        n != 1 veya değil ilk_sözlük -> eğer { yanlış_argüman(ad, "sözlük", türler, d) }
        yaz("pop rdi")
        asıl == "anahtarlar" -> eğer {
            yaz("mov esi, 16")
            komut("call __sozluk_liste", d)
            liste_türü(anahtar_kısmı(t0)) -> döndür
        }
        yaz("mov esi, 24")
        komut("call __sozluk_liste", d)
        liste_türü(değer_kısmı(t0)) -> döndür
    }
    asıl == "uzunluk" -> eğer {
        n != 1 veya değil (ilk_liste veya ilk_sözlük veya t0 == "metin") -> eğer {
            yanlış_argüman(ad, "liste, sözlük ya da metin", türler, d)
        }
        ilk_liste veya ilk_sözlük -> eğer {
            yaz("pop rax")
            yaz("mov rax, [rax]")
        } değilse {
            yaz("pop rdi")
            komut("call __metin_uzunluk", d)
        }
        "sayı" -> döndür
    }
    asıl == "oku" -> eğer {
        # Akan ya da verilen metin, satır sonu eklenmeden istem olarak yazılır.
        değil (n == 0 veya (n == 1 ve t0 == "metin")) -> eğer {
            yanlış_argüman(ad, "argümansız ya da istem metni", türler, d)
        }
        n == 1 -> eğer {
            yaz("pop rsi")
            yaz("mov rdx, [rsi-8]")
            komut("call __ham_yaz", d)
        }
        komut("call __oku", d)
        "metin" -> döndür
    }
    asıl == "dosya_oku" veya asıl == "dosya_var" veya asıl == "dosya_sil" -> eğer {
        n != 1 veya t0 != "metin" -> eğer { yanlış_argüman(ad, "dosya yolu", türler, d) }
        yaz("pop rdi")
        komut("call __" + asıl, d)
        asıl == "dosya_oku" -> eğer { "metin" -> döndür }
        "sayı" -> döndür
    }
    asıl == "dosya_yaz" veya asıl == "dosya_ekle" -> eğer {
        n != 2 veya t0 != "metin" veya t1 != "metin" -> eğer { yanlış_argüman(ad, "içerik, dosya yolu", türler, d) }
        yaz("pop rsi")
        yaz("pop rdi")
        # O_WRONLY | O_CREAT ve üstüne yazmak için O_TRUNC, eklemek için O_APPEND
        asıl == "dosya_yaz" -> eğer { yaz("mov edx, 577") } değilse { yaz("mov edx, 1089") }
        komut("call __dosya_yaz", d)
        "metin" -> döndür
    }
    asıl == "baytlar" veya asıl == "uyar" -> eğer {
        n != 1 veya t0 != "metin" -> eğer { yanlış_argüman(ad, "metin", türler, d) }
        yaz("pop rdi")
        asıl == "baytlar" -> eğer {
            komut("call __metin_baytlar", d)
            "[sayı]" -> döndür
        }
        komut("call __uyar", d)
        "metin" -> döndür
    }
    asıl == "komut_çalıştır" veya asıl == "dizin_listele" -> eğer {
        "dizin yolu" -> açıklama
        asıl == "komut_çalıştır" -> eğer { "komut" -> açıklama }
        n != 1 veya t0 != "metin" -> eğer { yanlış_argüman(ad, açıklama, türler, d) }
        yaz("pop rdi")
        asıl == "komut_çalıştır" -> eğer {
            komut("call __komut_calistir", d)
            "sayı" -> döndür
        }
        komut("call __dizin_listele", d)
        "[metin]" -> döndür
    }
    asıl == "metin_genişliği" -> eğer {
        n != 1 veya t0 != "metin" -> eğer { yanlış_argüman(ad, "metin", türler, d) }
        yaz("pop rdi")
        yaz("call __metin_genisligi")
        "sayı" -> döndür
    }
    asıl == "karakter" -> eğer {
        n != 1 veya t0 != "sayı" -> eğer { yanlış_argüman(ad, "karakter kodu", türler, d) }
        yaz("pop rdi")
        komut("call __karakter", d)
        "metin" -> döndür
    }
    asıl == "uçbirim_mi" veya asıl == "ortam_var" veya asıl == "dosya_hatası" -> eğer {
        "metin" -> beklenen
        "dosya yolu" -> açıklama
        "call __dosya_hata_kodu" -> komut_satırı
        asıl == "uçbirim_mi" -> eğer {
            "sayı" -> beklenen
            "dosya tanıtıcısı" -> açıklama
            "call __ucbirim_mi" -> komut_satırı
        }
        asıl == "ortam_var" -> eğer {
            "ortam değişkeninin adı" -> açıklama
            "call __ortam_var" -> komut_satırı
        }
        n != 1 veya t0 != beklenen -> eğer { yanlış_argüman(ad, açıklama, türler, d) }
        yaz("pop rdi")
        komut(komut_satırı, d)
        "sayı" -> döndür
    }
    asıl == "argümanlar" -> eğer {
        n != 0 -> eğer { yanlış_argüman(ad, "argümansız", türler, d) }
        komut("call __argumanlar", d)
        "[metin]" -> döndür
    }
    asıl == "çık" -> eğer {
        n != 1 veya t0 != "sayı" -> eğer { yanlış_argüman(ad, "çıkış kodu", türler, d) }
        yaz("pop rdi")
        yaz("call __cik")
        "sayı" -> döndür
    }
    asıl == "işletim_sistemi" -> eğer {
        n != 0 -> eğer { yanlış_argüman(ad, "argümansız", türler, d) }
        yaz("lea rax, [rip+__isletim_sistemi_adi]")
        "metin" -> döndür
    }
    asıl == "girdi_var" -> eğer {
        n != 0 -> eğer { yanlış_argüman(ad, "argümansız", türler, d) }
        komut("call __girdi_var", d)
        "sayı" -> döndür
    }
    asıl == "zaman" veya asıl == "tuş" veya asıl == "uçbirim_boyutu" veya asıl == "çöp_topla"
        veya asıl == "tuş_bırakma_var" -> eğer {
        n != 0 -> eğer { yanlış_argüman(ad, "argümansız", türler, d) }
        asıl == "tuş_bırakma_var" -> eğer {
            komut("call __tus_birakma_var", d)
            "sayı" -> döndür
        }
        asıl == "çöp_topla" -> eğer {
            komut("call __bellek_topla", d)
            "sayı" -> döndür
        }
        asıl == "zaman" -> eğer {
            komut("call __zaman", d)
            "sayı" -> döndür
        }
        asıl == "tuş" -> eğer {
            komut("call __tus", d)
            "metin" -> döndür
        }
        komut("call __ucbirim_boyutu", d)
        "[sayı]" -> döndür
    }
    asıl == "bekle" veya asıl == "rastgele" veya asıl == "rastgele_tohum" veya asıl == "tuş_kipi" -> eğer {
        {"bekle": "milisaniye", "rastgele": "üst sınır", "rastgele_tohum": "tohum",
         "tuş_kipi": "açmak için 1 (bırakmalarla 2), kapatmak için 0"} -> açıklamalar
        {"bekle": "call __bekle", "rastgele": "call __rastgele",
         "rastgele_tohum": "call __rastgele_tohum", "tuş_kipi": "call __tus_kipi"} -> çağrılar
        n != 1 veya t0 != "sayı" -> eğer { yanlış_argüman(ad, açıklamalar[asıl], türler, d) }
        yaz("pop rdi")
        komut(çağrılar[asıl], d)
        "sayı" -> döndür
    }
    asıl == "göster" -> eğer {
        n != 1 veya t0 != "metin" -> eğer { yanlış_argüman(ad, "metin", türler, d) }
        yaz("pop rdi")
        komut("call __goster", d)
        "metin" -> döndür
    }
    asıl == "metne" -> eğer {
        n != 1 veya (t0 != "sayı" ve t0 != "metin" ve t0 != "ondalık") -> eğer { yanlış_argüman(ad, "sayı", türler, d) }
        t0 == "sayı" -> eğer {
            yaz("pop rdi")
            komut("call __sayidan_metin", d)
        } değilse {
            t0 == "ondalık" -> eğer {
                yaz("pop rdi")
                komut("call __ondalik_metin", d)
            } değilse { yaz("pop rax") }
        }
        "metin" -> döndür
    }
    asıl == "sayıya" -> eğer {
        n != 1 veya (t0 != "sayı" ve t0 != "metin" ve t0 != "ondalık") -> eğer { yanlış_argüman(ad, "metin", türler, d) }
        t0 == "metin" -> eğer {
            yaz("pop rdi")
            komut("call __metinden_sayi", d)
        } değilse {
            t0 == "ondalık" -> eğer {       # sıfıra doğru kesilir
                yaz("pop rdi")
                komut("call __ondalik_tama", d)
            } değilse { yaz("pop rax") }
        }
        "sayı" -> döndür
    }
    asıl == "ondalığa" -> eğer {
        n != 1 veya (t0 != "sayı" ve t0 != "metin" ve t0 != "ondalık") -> eğer { yanlış_argüman(ad, "sayı ya da metin", türler, d) }
        t0 == "metin" -> eğer {
            yaz("pop rdi")
            komut("call __metinden_ondalik", d)
        } değilse {
            yaz("pop rax")
            t0 == "sayı" -> eğer {
                yaz("cvtsi2sd xmm0, rax")
                yaz("movq rax, xmm0")
            }
        }
        "ondalık" -> döndür
    }
    asıl == "yuvarla" veya asıl == "taban" veya asıl == "tavan" -> eğer {
        n != 1 veya (t0 != "sayı" ve t0 != "ondalık") -> eğer { yanlış_argüman(ad, "ondalık", türler, d) }
        t0 == "sayı" -> eğer { yaz("pop rax") } değilse {
            yaz("pop rdi")
            yaz("mov esi, " + metne(bul(["yuvarla", "taban", "tavan"], asıl)))
            komut("call __ondalik_yuvarla", d)
        }
        "sayı" -> döndür
    }
    asıl == "mutlak" -> eğer {
        n != 1 veya (t0 != "sayı" ve t0 != "ondalık") -> eğer { yanlış_argüman(ad, "sayı ya da ondalık", türler, d) }
        yaz("pop rax")
        t0 == "sayı" -> eğer {
            yaz("mov rcx, rax")
            yaz("neg rax")
            yaz("cmovl rax, rcx")
        } değilse { yaz("btr rax, 63") }
        t0 -> döndür
    }
    asıl == "karekök" veya asıl == "sin" veya asıl == "cos" veya asıl == "atan2" -> eğer {
        1 -> beklenen_sayı
        "sayı ya da ondalık" -> açıklama
        asıl == "atan2" -> eğer {
            2 -> beklenen_sayı
            "y, x" -> açıklama
        }
        n != beklenen_sayı -> eğer { yanlış_argüman(ad, açıklama, türler, d) }
        türler -> her (t) { t != "sayı" ve t != "ondalık" -> eğer { yanlış_argüman(ad, açıklama, türler, d) } }
        n == 2 -> eğer {
            yaz("pop rsi")
            t1 == "sayı" -> eğer {
                yaz("cvtsi2sd xmm0, rsi")
                yaz("movq rsi, xmm0")
            }
        }
        yaz("pop rdi")
        t0 == "sayı" -> eğer {
            yaz("cvtsi2sd xmm0, rdi")
            yaz("movq rdi, xmm0")
        }
        asıl == "karekök" -> eğer {
            yaz("movq xmm0, rdi")
            yaz("sqrtsd xmm0, xmm0")
            yaz("movq rax, xmm0")
        } değilse { yaz("call __ondalik_" + asıl) }
        "ondalık" -> döndür
    }
    asıl == "bit_ve" veya asıl == "bit_veya" veya asıl == "bit_yada" veya asıl == "sola_kaydır"
        veya asıl == "sağa_kaydır" -> eğer {
        n != 2 veya t0 != "sayı" veya t1 != "sayı" -> eğer { yanlış_argüman(ad, "sayı, sayı", türler, d) }
        yaz("pop rcx")
        yaz("pop rax")
        yaz({"bit_ve": "and rax, rcx", "bit_veya": "or rax, rcx", "bit_yada": "xor rax, rcx",
             "sola_kaydır": "call __sola_kaydir", "sağa_kaydır": "call __saga_kaydir"}[asıl])
        "sayı" -> döndür
    }
    asıl == "bit_değil" -> eğer {
        n != 1 veya t0 != "sayı" -> eğer { yanlış_argüman(ad, "sayı", türler, d) }
        yaz("pop rax")
        yaz("not rax")
        "sayı" -> döndür
    }
    "" -> liste_elemanı
    n == 1 ve liste_mi(t0) -> eğer { çöz(eleman_türü(t0)) -> liste_elemanı }
    (asıl == "en_küçük" veya asıl == "en_büyük") ve (liste_elemanı == "sayı" veya liste_elemanı == "ondalık") -> eğer {
        0 -> kip
        asıl == "en_büyük" -> eğer { 1 -> kip }
        liste_elemanı == "ondalık" -> eğer { kip + 2 -> kip }
        yaz("pop rdi")
        yaz("mov esi, " + metne(kip))
        komut("call __liste_en", d)
        liste_elemanı -> döndür
    }
    asıl == "en_küçük" veya asıl == "en_büyük" veya asıl == "sınırla" veya asıl == "üs" -> eğer {
        2 -> beklenen_sayı
        "iki sayı ya da bir sayı listesi" -> açıklama
        asıl == "sınırla" -> eğer {
            3 -> beklenen_sayı
            "değer, alt sınır, üst sınır" -> açıklama
        }
        asıl == "üs" -> eğer { "taban, üs" -> açıklama }
        n != beklenen_sayı -> eğer { yanlış_argüman(ad, açıklama, türler, d) }
        0 -> ondalık_sayısı
        türler -> her (t) {
            t != "sayı" ve t != "ondalık" -> eğer { yanlış_argüman(ad, açıklama, türler, d) }
            t == "ondalık" -> eğer { ondalık_sayısı + 1 -> ondalık_sayısı }
        }
        ["rax", "rcx", "rdx"] -> yazmaçlar
        asıl == "üs" -> eğer { ["rdi", "rsi"] -> yazmaçlar }
        n - 1 -> i
        i >= 0 -> iken {
            yaz("pop " + yazmaçlar[i])
            i - 1 -> i
        }
        ondalık_sayısı == 0 -> eğer {
            asıl == "üs" -> eğer { komut("call __us_sayi", d) } değilse {
                yaz("cmp rax, rcx")
                {"en_küçük": "cmovg rax, rcx", "en_büyük": "cmovl rax, rcx", "sınırla": "cmovl rax, rcx"} -> seçim
                yaz(seçim[asıl])
                asıl == "sınırla" -> eğer {
                    yaz("cmp rax, rdx")
                    yaz("cmovg rax, rdx")
                }
            }
            "sayı" -> döndür
        }
        0 -> i
        i < n -> iken {
            türler[i] == "sayı" -> eğer { yaz("cvtsi2sd xmm" + metne(i) + ", " + yazmaçlar[i]) }
            değilse { yaz("movq xmm" + metne(i) + ", " + yazmaçlar[i]) }
            i + 1 -> i
        }
        asıl == "üs" -> eğer {
            yaz("movq rdi, xmm0")
            yaz("movq rsi, xmm1")
            yaz("call __ondalik_us")
            "ondalık" -> döndür
        }
        asıl == "en_küçük" -> eğer { yaz("minsd xmm0, xmm1") } değilse { yaz("maxsd xmm0, xmm1") }
        asıl == "sınırla" -> eğer { yaz("minsd xmm0, xmm2") }
        yaz("movq rax, xmm0")
        "ondalık" -> döndür
    }
    asıl == "işaret" -> eğer {
        n != 1 veya (t0 != "sayı" ve t0 != "ondalık") -> eğer { yanlış_argüman(ad, "sayı ya da ondalık", türler, d) }
        yaz("pop rax")
        t0 == "sayı" -> eğer {
            yaz("xor ecx, ecx")
            yaz("test rax, rax")
            yaz("setg cl")
            yaz("sar rax, 63")
            yaz("or rax, rcx")
        } değilse {
            yaz("movq xmm0, rax")
            yaz("xorpd xmm1, xmm1")
            yaz("ucomisd xmm0, xmm1")
            yaz("seta al")
            yaz("setb cl")
            yaz("movzx eax, al")
            yaz("movzx ecx, cl")
            yaz("sub rax, rcx")
        }
        "sayı" -> döndür
    }
    ["tan", "atan", "üstel", "ln", "asin", "acos"] -> işlev_adları
    bul(işlev_adları, asıl) >= 0 -> eğer {
        n != 1 veya (t0 != "sayı" ve t0 != "ondalık") -> eğer { yanlış_argüman(ad, "sayı ya da ondalık", türler, d) }
        yaz("pop rdi")
        t0 == "sayı" -> eğer {
            yaz("cvtsi2sd xmm0, rdi")
            yaz("movq rdi, xmm0")
        }
        yaz("mov esi, " + metne(bul(işlev_adları, asıl)))
        yaz("call __ondalik_fonk")
        "ondalık" -> döndür
    }
    var(EKRAN_İŞLEVLERİ, asıl) -> eğer {
        EKRAN_İŞLEVLERİ[asıl] -> biçim      # [kısa biçim, uzun biçim, açıklama, yordam]
        birleş(türler, ",") -> verilen
        verilen != biçim[0] ve verilen != biçim[1] -> eğer { yanlış_argüman(ad, biçim[2], türler, d) }
        uzunluk(böl(biçim[1], ",")) -> sayısı
        biçim[1] == "" -> eğer { 0 -> sayısı }
        n < sayısı -> iken {
            yaz("push -1")
            n + 1 -> n
        }
        sayısı > 0 -> eğer { yaz("mov rdi, rsp") }
        komut("call " + biçim[3], d)
        sayısı > 0 -> eğer { yaz("add rsp, " + metne(8 * sayısı)) }
        "sayı" -> döndür
    }
    asıl == "sırala" -> eğer {
        "" -> eleman
        ilk_liste -> eğer { çöz(eleman_türü(t0)) -> eleman }
        n == 1 ve (eleman == "sayı" veya eleman == "metin" veya eleman == "ondalık") -> eğer {
            yaz("pop rdi")
            yaz("mov esi, " + metne(bul(["sayı", "metin", "ondalık"], eleman)))
            komut("call __liste_sirala", d)
            t0 -> döndür
        }
        n == 2 ve ilk_liste -> eğer {
            eleman_türü(t0) -> e_tür
            değil birleştir(t1, işlev_türü([e_tür, e_tür], "sayı")) -> eğer {
                k_hata("'" + ad + "' için karşılaştırma işlevi iki eleman alıp sayı vermeli "
                       + "(a, b'den önce gelecekse 1); " + ham_ad(t1) + " verildi", d)
            }
            yaz("pop rdx")
            yaz("pop rdi")
            yaz("mov esi, 3")
            komut("call __liste_sirala", d)
            t0 -> döndür
        }
        n == 1 ve eleman != "" ve değil bilinmeyen_mi(eleman) -> eğer {
            k_hata_i("'" + ad + "' " + ham_ad(eleman) + " elemanlarını kendiliğinden sıralayamaz", d,
                     "bir karşılaştırma işlevi verin:  sırala(liste, önce)   (önce(a, b): a, b'den önce gelecekse 1)")
        }
        yanlış_argüman(ad, "sayı, metin ya da ondalık listesi; başka listeler için bir karşılaştırma işlevi de", türler, d)
    }
    asıl == "ters_çevir" -> eğer {
        n != 1 veya değil ilk_liste -> eğer { yanlış_argüman(ad, "liste", türler, d) }
        yaz("pop rdi")
        komut("call __liste_ters", d)
        t0 -> döndür
    }
    asıl == "rgb" -> eğer {
        n != 3 veya t0 != "sayı" veya t1 != "sayı" veya t2 != "sayı" -> eğer {
            yanlış_argüman(ad, "kırmızı, yeşil, mavi (0-255)", türler, d)
        }
        yaz("pop rdx")
        yaz("pop rcx")
        yaz("pop rax")
        yaz("and eax, 255")
        yaz("shl eax, 16")
        yaz("and ecx, 255")
        yaz("shl ecx, 8")
        yaz("or eax, ecx")
        yaz("and edx, 255")
        yaz("or eax, edx")
        "sayı" -> döndür
    }
    asıl == "pi" -> eğer {
        n != 0 -> eğer { yanlış_argüman(ad, "argümansız", türler, d) }
        yaz("movabs rax, 0x400921FB54442D18")
        "ondalık" -> döndür
    }
    asıl == "ekle" -> eğer {
        n != 2 veya değil ilk_liste -> eğer { yanlış_argüman(ad, "liste, eleman", türler, d) }
        # nehir.py türlerin kimliğine bakar; burada aynı yazılmış türler aynı liste sayılır.
        t1 == t0 -> eğer { k_hata("bir liste kendi içine eklenemez", d) }
        değil birleştir(t0, liste_türü(t1)) -> eğer {
            k_hata(ham_ad(t0) + " içine " + ham_ad(t1) + " eklenemez", d)
        }
        yaz("pop rsi")
        yaz("pop rdi")
        komut("call __liste_ekle", d)
        t0 -> döndür
    }
    asıl == "dilim" -> eğer {
        n != 3 veya t1 != "sayı" veya t2 != "sayı" veya değil (ilk_liste veya t0 == "metin") -> eğer {
            yanlış_argüman(ad, "liste ya da metin, baş, son", türler, d)
        }
        yaz("pop rdx")
        yaz("pop rsi")
        yaz("pop rdi")
        ilk_liste -> eğer {
            komut("call __liste_dilim", d)
            t0 -> döndür
        }
        komut("call __metin_dilim", d)
        "metin" -> döndür
    }
    asıl == "bul" -> eğer {
        n == 2 ve t0 == "metin" ve t1 == "metin" -> eğer {
            yaz("pop rsi")
            yaz("pop rdi")
            komut("call __metin_bul", d)
            "sayı" -> döndür
        }
        n != 2 veya değil ilk_liste -> eğer {
            yanlış_argüman(ad, "metin, aranan metin  ya da  liste, aranan eleman", türler, d)
        }
        değil birleştir(t0, liste_türü(t1)) veya sözlük_içerir(t1) -> eğer {
            k_hata(ham_ad(t0) + " içinde " + ham_ad(t1) + " aranamaz", d)
        }
        yaz("pop rsi")
        yaz("pop rdi")
        tür_satırı("rdx", t1)
        komut("call __liste_bul", d)
        "sayı" -> döndür
    }
    asıl == "sil" -> eğer {
        n != 2 veya değil ilk_liste veya t1 != "sayı" -> eğer {
            yanlış_argüman(ad, "liste, dizin  ya da  sözlük, anahtar", türler, d)
        }
        yaz("pop rsi")
        yaz("pop rdi")
        komut("call __liste_sil", d)
        çöz(eleman_türü(t0)) -> döndür
    }
    asıl == "böl" -> eğer {
        n != 2 veya t0 != "metin" veya t1 != "metin" -> eğer { yanlış_argüman(ad, "metin, ayraç", türler, d) }
        yaz("pop rsi")
        yaz("pop rdi")
        komut("call __metin_bol", d)
        "[metin]" -> döndür
    }
    asıl == "birleş" -> eğer {
        n != 2 veya değil ilk_liste veya t1 != "metin" -> eğer { yanlış_argüman(ad, "metin listesi, ayraç", türler, d) }
        değil birleştir(t0, "[metin]") -> eğer { yanlış_argüman(ad, "metin listesi, ayraç", türler, d) }
        yaz("pop rsi")
        yaz("pop rdi")
        komut("call __liste_birles", d)
        "metin" -> döndür
    }
    # aralık
    n != 2 veya t0 != "sayı" veya t1 != "sayı" -> eğer { yanlış_argüman(ad, "sayı, sayı", türler, d) }
    yaz("pop rsi")
    yaz("pop rdi")
    komut("call __aralik", d)
    "[sayı]" -> döndür
}

işlev yanlış_argüman(ad, beklenen, türler, d) {
    k_hata("'" + ad + "' (" + beklenen + ") bekliyor; (" + ham_listesi(türler) + ") verildi", d)
}

# İşlevi, parametre türleri belli olduktan sonra ayrı bir tampona derler. Çağıranın
# derleme durumu saklanır ve sonra geri yüklenir.
işlev işlevi_derle(ad) {
    1 -> k_işlev_durum[ad]
    k_işlev[ad] -> f
    parametre_sayısı(f) -> n

    k_kod -> s_kod
    k_geçerli -> s_geçerli
    k_yerel_yer -> s_yerel_yer
    k_yerel_tür -> s_yerel_tür
    k_yerel_sayısı -> s_yerel_sayısı
    k_okunan -> s_okunan
    k_döngü_devam -> s_döngü_devam
    k_döngü_son -> s_döngü_son
    k_döngü_çatal -> s_döngü_çatal
    k_çatal -> s_çatal
    k_yerel_konum -> s_yerel_konum
    k_yerel_okundu -> s_yerel_okundu
    k_yerel_sıra -> s_yerel_sıra

    {} -> k_yerel_konum
    {} -> k_yerel_okundu
    [] -> k_yerel_sıra
    [] -> k_kod
    ad -> k_geçerli
    {} -> k_yerel_yer
    {} -> k_yerel_tür
    0 -> k_yerel_sayısı
    {} -> k_okunan
    [] -> k_döngü_devam
    [] -> k_döngü_son
    [] -> k_döngü_çatal
    0 -> k_çatal
    # Argümanlar soldan sağa itilir: ilk argüman en derinde durur.
    0 -> i
    i < n -> iken {
        f.çocuklar[i].ad -> p
        "[rbp+" + metne(16 + 8 * (n - 1 - i)) + "]" -> k_yerel_yer[p]
        k_işlev_türler[ad][i] -> k_yerel_tür[p]
        i + 1 -> i
    }
    gövdesi(f) -> gövde
    blok_üret(gövde)
    k_kod -> gövde_kodu
    k_yerel_sayısı -> yerel_sayısı
    k_yerel_sıra -> her (y) {
        değil var(k_yerel_okundu, y) ve var(k_yerel_konum, y) -> eğer { okunmayanı_bildir(y, k_yerel_konum[y], doğru) }
    }

    s_kod -> k_kod
    s_geçerli -> k_geçerli
    s_yerel_yer -> k_yerel_yer
    s_yerel_tür -> k_yerel_tür
    s_yerel_sayısı -> k_yerel_sayısı
    s_okunan -> k_okunan
    s_döngü_devam -> k_döngü_devam
    s_döngü_son -> k_döngü_son
    s_döngü_çatal -> k_döngü_çatal
    s_çatal -> k_çatal
    s_yerel_konum -> k_yerel_konum
    s_yerel_okundu -> k_yerel_okundu
    s_yerel_sıra -> k_yerel_sıra

    k_işlev_dönüş[ad] == "" -> eğer { "sayı" -> k_işlev_dönüş[ad] }    # hiç 'döndür' yok: 0 döner
    tamamlanır(gövde.çocuklar) -> k_işlev_sona[ad]
    2 -> k_işlev_durum[ad]

    k_işlev_kodu -> ekle("§BAŞLIK§" + ad)
    k_işlev_kodu -> ekle("    push rbp")
    k_işlev_kodu -> ekle("    mov rbp, rsp")
    yerel_sayısı > 0 -> eğer { k_işlev_kodu -> ekle("    sub rsp, " + metne(8 * yerel_sayısı)) }
    # Yığın taşmasın: sonu gelmeyen özyineleme, işlevin satırını gösteren bir hatayla durur.
    k_işlev[ad] -> tanım
    k_işlev_kodu -> ekle("    mov r15, " + metne(tanım.dosya * 4294967296 + tanım.satır))
    k_işlev_kodu -> ekle("    cmp rsp, [rip+__yigin_siniri]")
    k_işlev_kodu -> ekle("    jb __yigin_tasti")
    gövde_kodu -> her (s) { k_işlev_kodu -> ekle(s) }
    k_işlev_kodu -> ekle("    xor eax, eax")
    k_işlev_kodu -> ekle("    leave")
    k_işlev_kodu -> ekle("    ret")
}

# İşlevin etiket satırı; türler derlemenin sonunda kesinleşmiş olur.
işlev işlev_başlığı(ad) {
    k_işlev_etiket[ad] + ":    # işlev " + görünen_ad(ad) + "(" + tür_listesi(k_işlev_türler[ad]) + ") -> "
        + tür_adı(k_işlev_dönüş[ad]) -> döndür
}

# Bütün program derlendikten sonra dönüş türleri kesinleşir. Sonuna değer
# döndürmeden ulaşılabilen bir işlev 0 döndürür; bu yalnızca sayı için geçerlidir.
işlev dönüşleri_denetle() {
    [] -> anahtarlar_
    k_işlev_adları -> her (ad) {
        var(k_işlev_örnekleri, ad) -> eğer { anahtarlar_ + k_işlev_örnekleri[ad] -> anahtarlar_ }
        değilse { anahtarlar_ -> ekle(ad) }
    }
    anahtarlar_ -> her (anahtar) {
        görünen_ad(anahtar) -> ad
        k_işlev_durum[anahtar] == 2 -> eğer {
            çöz(k_işlev_dönüş[anahtar]) -> dönüş
            bilinmeyen_mi(dönüş) ve değil yok_mu(dönüş) -> eğer {   # yalnızca kendi sonucunu döndüren özyineleme
                "sayı" -> k_bağ[dönüş]
                "sayı" -> dönüş
            }
            k_işlev_sona[anahtar] ve dönüş != "sayı" ve değil kayıtsı(dönüş) -> eğer {
                k_hata_i("'" + ad + "' işlevi " + ham_ad(dönüş)
                         + " döndürüyor ama sonuna değer döndürmeden ulaşılabiliyor", k_işlev[ad],
                         "her yol bir değer döndürmeli ya da programı bitirmeli; yalnızca sayı ve kayıt "
                         + "döndüren işlevler sona ulaşabilir (0 ya da yok döner)")
            }
        }
    }
}

# ── deyimler ──

işlev blok_üret(b) { b.çocuklar -> her (d) { deyim_üret(d) } }

işlev döngü_gövdesi(b, devam_etiketi, son_etiketi) {
    k_döngü_devam -> ekle(devam_etiketi)
    k_döngü_son -> ekle(son_etiketi)
    k_döngü_çatal -> ekle(k_çatal)
    blok_üret(b)
    uzunluk(k_döngü_son) - 1 -> s
    k_döngü_devam -> sil(s)
    k_döngü_son -> sil(s)
    k_döngü_çatal -> sil(s)
}

işlev deyim_üret(d) {
    d.tür == "dur" veya d.tür == "devam" -> eğer {
        uzunluk(k_döngü_son) == 0 -> eğer { k_hata("'" + d.tür + "' yalnızca döngü içinde kullanılabilir", d) }
        uzunluk(k_döngü_son) - 1 -> s
        k_çatal > k_döngü_çatal[s] -> eğer {      # çatalların yığında bıraktıklarını at
            yaz("add rsp, " + metne(8 * (k_çatal - k_döngü_çatal[s])))
        }
        d.tür == "dur" -> eğer { yaz("jmp " + k_döngü_son[s]) } değilse { yaz("jmp " + k_döngü_devam[s]) }
    } değilse {
        d.tür != "akış" -> eğer { desteklenmiyor("'" + d.tür + "' deyimi", d) }
        d.çocuklar -> c
        uzunluk(c) -> n
        "" -> döngü_başı
        c[n - 1].tür == "iken" -> eğer {
            # Koşul her turda yeniden aktığı için tüm zincir döngünün içindedir.
            yeni_etiket() -> döngü_başı
            etiket_koy(döngü_başı)
        }
        ifade_üret(c[0]) -> tür
        1 -> i
        i < n -> iken {
            hedef_üret(c[i], tür, döngü_başı) -> tür
            i + 1 -> i
        }
        n > 1 -> eğer { atılan_sonucu_bildir(c[n - 1]) }
    }
}

# `16 -> taban` gibi bir satır değişkene atamaz: akan değer yerleşik işleve argüman olur ve
# sonuç atılır. Yan etkisi olmayan bir yerleşikte bu büyük olasılıkla bir yanlışlıktır.
işlev atılan_sonucu_bildir(h) {
    h.tür == "hedef_ad" ve uzunluk(h.çocuklar) == 0 ve değil var(k_işlev, h.ad)
        ve değil var(k_kayıt_alanları, h.ad) ve değil yerel_mi(h.ad) ve var(YERLEŞİK_ADLAR, h.ad) -> eğer {
        YERLEŞİK_ADLAR[h.ad] -> asıl
        var(SAF_YERLEŞİKLER, asıl) -> eğer {
            "bir değişkene atamak istediyseniz ona başka bir ad verin" -> ipucu
            asıl == "sırala" veya asıl == "ters_çevir" -> eğer {
                "'" + h.ad + "' yeni bir liste verir, asıl liste değişmez:  liste -> " + h.ad + " -> liste" -> ipucu
            }
            uyarı_ekle(h, "'" + h.ad + "' yerleşik bir işlev: akan değer ona argüman olur ve sonucu kullanılmıyor", ipucu)
        }
    }
}

işlev hedef_üret(h, tür, döngü_başı) { hedef_iç(h, çöz(tür), döngü_başı) -> döndür }

işlev hedef_iç(h, tür, döngü_başı) {
    h.tür == "yazdır" -> eğer {
        yaz("push rax")
        yaz("mov rdi, rax")
        tür_satırı("rsi", tür)
        yaz("call __yaz_deger")
        yaz("pop rax")              # değer akmaya devam eder
        tür -> döndür
    }
    h.tür == "döndür" -> eğer {
        k_geçerli == "" -> eğer { k_hata("'döndür' yalnızca işlev içinde kullanılabilir", h) }
        k_işlev_dönüş[k_geçerli] -> önceki
        önceki == "" -> eğer { tür -> k_işlev_dönüş[k_geçerli] } değilse {
            değil birleştir(önceki, tür) -> eğer {
                k_hata("'" + görünen_ad(k_geçerli) + "' işlevi hem " + ham_ad(önceki) + " hem " + tür_adı(tür)
                       + " döndürüyor", h)
            }
        }
        yaz("leave")
        yaz("ret")
        tür -> döndür
    }
    h.tür == "eğer" -> eğer {
        sayı_olmalı(tür, "'eğer' koşulu", h)
        yeni_etiket() -> öteki
        yeni_etiket() -> son
        yaz("test rax, rax")
        yaz("jz " + öteki)
        blok_üret(h.çocuklar[0])
        yaz("jmp " + son)
        etiket_koy(öteki)
        uzunluk(h.çocuklar) > 1 -> eğer { blok_üret(h.çocuklar[1]) }
        etiket_koy(son)
        tür -> döndür
    }
    h.tür == "iken" -> eğer {
        sayı_olmalı(tür, "'iken' koşulu", h)
        yeni_etiket() -> son
        yaz("test rax, rax")
        yaz("jz " + son)
        döngü_gövdesi(h.çocuklar[0], döngü_başı, son)
        yaz("jmp " + döngü_başı)
        etiket_koy(son)
        tür -> döndür
    }
    h.tür == "her" -> eğer {
        yeni_etiket() -> baş
        yeni_etiket() -> artır
        yeni_etiket() -> son
        tür == "metin" -> eğer {      # her karakter sırayla değişkene akar
            yaz("push rax")                 # [rsp+8] = metin
            yaz("push 0")                   # [rsp]   = sıradaki karakterin bayt konumu
            etiket_koy(baş)
            yaz("mov rsi, [rsp]")
            yaz("mov rdi, [rsp+8]")
            yaz("cmp rsi, [rdi-8]")
            yaz("jge " + son)
            komut("call __metin_karakter", h)
            yaz("mov [rsp], rdx")
            ata(h.ad, "metin", h)
        } değilse {
            sözlük_mi(tür) -> eğer {      # anahtarların o anki listesi üzerinde dönülür
                yaz("mov rdi, rax")
                yaz("mov esi, 16")
                komut("call __sozluk_liste", h)
                liste_türü(anahtar_kısmı(tür)) -> tür
            }
            değil liste_mi(tür) -> eğer {
                k_hata("'her' içine bir liste, sözlük ya da metin akmalı, " + ham_ad(tür) + " bulundu", h)
            }
            yaz("push rax")                 # [rsp+8] = liste
            yaz("push 0")                   # [rsp]   = dizin
            etiket_koy(baş)
            yaz("mov rsi, [rsp]")
            yaz("mov rdi, [rsp+8]")
            yaz("cmp rsi, [rdi]")
            yaz("jge " + son)
            komut("call __liste_al", h)
            ata(h.ad, çöz(eleman_türü(tür)), h)     # henüz bilinmiyorsa kullanımdan öğrenilir
        }
        döngü_gövdesi(h.çocuklar[0], artır, son)
        etiket_koy(artır)
        tür == "metin" -> eğer { yaz("jmp " + baş) } değilse {
            yaz("inc qword ptr [rsp]")
            yaz("jmp " + baş)
        }
        etiket_koy(son)
        yaz("add rsp, 16")
        tür -> döndür
    }
    h.tür == "eleman" -> eğer {
        yaz("push rax")                     # [rsp] = yazılacak değer
        ifade_üret(h.çocuklar[0]) -> kap
        değil (liste_mi(kap) veya sözlük_mi(kap)) -> eğer {
            k_hata("'[ ]' ile yalnızca liste ve sözlüklere yazılabilir, " + ham_ad(kap) + " bulundu", h)
        }
        yaz("push rax")
        ifade_üret(h.çocuklar[1]) -> dizin_türü
        yaz("mov rsi, rax")
        yaz("pop rdi")
        liste_mi(kap) -> eğer {
            sayı_olmalı(dizin_türü, "liste dizini", h)
            değil birleştir(kap, liste_türü(tür)) -> eğer { k_hata(ham_ad(kap) + " içine " + ham_ad(tür) + " akamaz", h) }
            yaz("mov rdx, [rsp]")
            komut("call __liste_koy", h)
        } değilse {
            anahtarı_denetle(kap, dizin_türü, h)
            değil birleştir(değer_kısmı(kap), tür) -> eğer {
                k_hata(ham_ad(kap) + " içine değer olarak " + ham_ad(tür) + " akamaz", h)
            }
            yaz("mov rcx, [rsp]")
            komut("call __sozluk_koy", h)
        }
        yaz("pop rax")
        tür -> döndür
    }
    h.tür == "yöntem_hedef" -> eğer {
        yaz("push rax")                     # akan değer
        ifade_üret(h.çocuklar[0]) -> nesne_türü
        yöntem_adı(nesne_türü, h.ad, h) -> ad
        yaz("mov rcx, [rsp]")               # yığında önce nesne, sonra akan değer
        yaz("mov [rsp], rax")
        yaz("push rcx")
        çağır_öncekiyle(ad, h.çocuklar[1].çocuklar, h, [nesne_türü, tür], "") -> döndür
    }
    h.tür == "alan_yaz" -> eğer {
        yaz("push rax")                     # [rsp] = yazılacak değer
        ifade_üret(h.çocuklar[0]) -> kt
        alan_sırası(kt, h.ad, h) -> sıra
        alan_türü(kt, sıra) -> at
        değil birleştir(at, tür) -> eğer {
            k_hata("'" + h.ad + "' alanı " + tür_adı(at) + " türünde; " + ham_ad(tür) + " atanamaz", h)
        }
        yaz("test rax, rax")
        komut("jz __yok_hatasi", h)
        yaz("mov rcx, [rsp]")
        yaz("mov [rax+" + metne(8 * sıra) + "], rcx")
        yaz("pop rax")
        tür -> döndür
    }
    h.tür == "çatal" -> eğer {
        # Aynı değer her kola ayrı ayrı akar; sonra olduğu gibi yoluna devam eder.
        h.çocuklar -> her (dal) {
            yaz("push rax")
            k_çatal + 1 -> k_çatal
            tür -> kol_türü
            dal.çocuklar -> her (alt) { hedef_üret(alt, kol_türü, "") -> kol_türü }
            k_çatal - 1 -> k_çatal
            yaz("pop rax")
        }
        tür -> döndür
    }
    h.tür == "ortak" -> eğer {
        k_geçerli != "" -> eğer {
            k_hata_i("'ortak' yalnızca en üst düzeyde, değişken tanımlanırken yazılır", h,
                     "'" + h.ad + "' zaten ortaksa işlev içinde doğrudan atanır:  değer -> " + h.ad)
        }
        çağrılabilir(h.ad) -> eğer { k_hata("'" + h.ad + "' bir işlev ya da kayıt adı; değişken adı olamaz", h) }
        ata(h.ad, tür, h)
        tür -> döndür
    }
    h.tür == "hedef_ad" -> eğer {
        # İşlevse akan değer ilk argüman olur, değilse değişkene atanır. Parametreler
        # ve yerel değişkenler aynı adlı işlevleri gölgeler.
        uzunluk(h.çocuklar) > 0 veya (değil yerel_mi(h.ad) ve çağrılabilir(h.ad)) -> eğer {
            yaz("push rax")
            [] -> arg_düğümleri
            uzunluk(h.çocuklar) > 0 -> eğer { h.çocuklar[0].çocuklar -> arg_düğümleri }
            # Yan etkisiz bir yerleşik büyük olasılıkla değişken sanılmıştır (`"a" -> taban`);
            # `5 -> uyar` gibi bir çağrıda ise niyet bellidir, bu ipucu yanıltır.
            uzunluk(h.çocuklar) == 0 ve yerleşik_mi(h.ad) ve değil var(k_işlev, h.ad)
                ve var(SAF_YERLEŞİKLER, YERLEŞİK_ADLAR[h.ad]) -> eğer {
                "'" + h.ad + "' yerleşik bir işlevdir; akan değer ona argüman olur. "
                    + "Değişkene başka bir ad verin" -> k_varsayılan_ipucu
            }
            çağır(h.ad, arg_düğümleri, h, tür) -> sonuç
            "" -> k_varsayılan_ipucu
            sonuç -> döndür
        }
        ata(h.ad, tür, h)
        tür -> döndür
    }
    desteklenmiyor("'" + h.tür + "' hedefi", h)
}

# ── ifadeler ──
# Her ifadenin sonucu rax'te kalır; işlev, ifadenin (çözülmüş) türünü verir.

işlev ifade_üret(e) { çöz(ifade_iç(e)) -> döndür }

işlev ifade_iç(e) {
    e.tür == "sayı" -> eğer {
        yaz("mov rax, " + metne(e.sayı))
        "sayı" -> döndür
    }
    e.tür == "ondalık" -> eğer {
        değil var(k_ondalık_no, e.ad) -> eğer {
            uzunluk(k_ondalıklar) -> k_ondalık_no[e.ad]
            k_ondalıklar -> ekle(e.ad)
        }
        yaz("mov rax, [rip+d" + metne(k_ondalık_no[e.ad]) + "]")
        "ondalık" -> döndür
    }
    e.tür == "metin" -> eğer {
        yaz("lea rax, [rip+" + metin_etiketi(e.ad) + "]")
        "metin" -> döndür
    }
    e.tür == "değişken" -> eğer {
        değişken_var_mı(e.ad) -> eğer {
            değişken_türü(e.ad) == "" -> eğer {
                k_hata_i("'" + e.ad + "' değişkenine henüz bir değer akmadı", e,
                         "değişken, programın daha aşağısında tanımlanıyor")
            }
            okundu(e.ad)
            k_geçerli != "" ve değil yerel_mi(e.ad) -> eğer { 1 -> k_okunan[e.ad] }
            yaz("mov rax, " + değişken_adresi(e.ad))
            değişken_türü(e.ad) -> döndür
        }
        k_işlev -> var(e.ad) -> eğer { işlev_değeri(e.ad, e) -> döndür }
        k_kayıt_alanları -> var(e.ad) -> eğer {
            k_hata_i("'" + e.ad + "' bir kayıt; kayıtlar değer olarak verilemez", e,
                     "kaydı kuran bir işlev tanımlayın:  işlev yeni(...) { " + e.ad + "(...) -> döndür }")
        }
        YERLEŞİK_ADLAR -> var(e.ad) -> eğer {
            k_hata_i("'" + e.ad + "' yerleşik bir işlev; yerleşik işlevler değer olarak verilemez", e,
                     "onu çağıran bir işlev tanımlayın:  işlev benim_" + e.ad + "(x) { x -> " + e.ad + " -> döndür }")
        }
        benzerler(e.ad, bilinen_değişkenler()) -> ipucu
        ipucu == "" ve dilim(e.ad, 0, 1) == "_" -> eğer { ÖZEL_AD_İPUCU -> ipucu }
        k_hata_i("'" + e.ad + "' adında bir değişken yok", e, ipucu)
    }
    e.tür == "çağrı" -> eğer { çağır(e.ad, e.çocuklar, e, "") -> döndür }
    e.tür == "yok" -> eğer {
        yaz("xor eax, eax")
        yeni_tür_değişkeni() -> t
        1 -> k_yok[t]
        t -> döndür
    }
    e.tür == "yöntem" -> eğer {
        ifade_üret(e.çocuklar[0]) -> nesne_türü
        yöntem_adı(nesne_türü, e.ad, e) -> ad
        yaz("push rax")
        dilim(e.çocuklar, 1, uzunluk(e.çocuklar)) -> yöntem_argümanları
        çağır_öncekiyle(ad, yöntem_argümanları, e, [nesne_türü], "") -> döndür
    }
    e.tür == "alan" -> eğer {
        ifade_üret(e.çocuklar[0]) -> kt
        alan_sırası(kt, e.ad, e) -> sıra
        yaz("test rax, rax")
        komut("jz __yok_hatasi", e)
        yaz("mov rax, [rax+" + metne(8 * sıra) + "]")
        alan_türü(kt, sıra) -> döndür
    }
    e.tür == "liste" -> eğer {
        uzunluk(e.çocuklar) -> n
        n < 4 -> eğer { 4 -> n }
        yaz("mov edi, " + metne(n))
        komut("call __liste_yeni", e)
        yaz("push rax")
        liste_türü(yeni_tür_değişkeni()) -> tür
        e.çocuklar -> her (eleman) {
            ifade_üret(eleman) -> et
            değil birleştir(tür, liste_türü(et)) -> eğer {
                k_hata("listenin elemanları aynı türde olmalı: " + bilinen_adı(eleman_türü(tür)) + " ve "
                       + ham_ad(et) + " karışmış", e)
            }
            yaz("mov rsi, rax")
            yaz("mov rdi, [rsp]")
            komut("call __liste_ekle", e)
        }
        yaz("pop rax")
        tür -> döndür
    }
    e.tür == "sözlük" -> eğer {
        komut("call __sozluk_yeni", e)
        yaz("push rax")
        sözlük_türü(yeni_tür_değişkeni(), yeni_tür_değişkeni()) -> tür
        0 -> i
        i < uzunluk(e.çocuklar) -> iken {
            e.çocuklar[i] -> anahtar
            e.çocuklar[i + 1] -> değer
            ifade_üret(anahtar) -> at
            yaz("push rax")
            ifade_üret(değer) -> vt
            yaz("mov rcx, rax")
            yaz("pop rsi")
            yaz("mov rdi, [rsp]")
            anahtarı_denetle(tür, at, anahtar)
            değil birleştir(değer_kısmı(tür), vt) -> eğer {
                k_hata("sözlüğün değerleri aynı türde olmalı: " + bilinen_adı(değer_kısmı(tür)) + " ve "
                       + ham_ad(vt) + " karışmış", değer)
            }
            komut("call __sozluk_koy", e)
            i + 2 -> i
        }
        yaz("pop rax")
        tür -> döndür
    }
    e.tür == "dizin" -> eğer {
        ifade_üret(e.çocuklar[0]) -> kap
        kap == "sayı" -> eğer { k_hata("'[ ]' ile yalnızca liste, sözlük ve metinlere erişilebilir", e) }
        yaz("push rax")
        ifade_üret(e.çocuklar[1]) -> dizin_türü
        yaz("mov rsi, rax")
        yaz("pop rdi")
        sözlük_mi(kap) -> eğer {
            anahtarı_denetle(kap, dizin_türü, e)
            komut("call __sozluk_al", e)
            değer_kısmı(kap) -> döndür       # henüz bilinmiyorsa kullanıldığı yerden anlaşılır
        }
        değil liste_mi(kap) ve kap != "metin" -> eğer {
            k_hata("'[ ]' ile yalnızca liste, sözlük ve metinlere erişilebilir, " + ham_ad(kap) + " bulundu", e)
        }
        sayı_olmalı(dizin_türü, "dizin", e)
        kap == "metin" -> eğer {
            komut("call __metin_al", e)
            "metin" -> döndür
        }
        komut("call __liste_al", e)
        eleman_türü(kap) -> döndür
    }
    e.tür == "tekli" -> eğer {
        ifade_üret(e.çocuklar[0]) -> işlenen
        işlenen == "ondalık" ve e.ad == "-" -> eğer {
            yaz("btc rax, 63")      # işaret biti
            "ondalık" -> döndür
        }
        sayı_olmalı(işlenen, "'" + e.ad + "' işlecinin işleneni", e)
        e.ad == "-" -> eğer { yaz("neg rax") } değilse {
            yaz("test rax, rax")
            yaz("sete al")
            yaz("movzx eax, al")
        }
        "sayı" -> döndür
    }
    e.tür == "ikili" -> eğer { ikili_üret(e) -> döndür }
    desteklenmiyor("'" + e.tür + "' ifadesi", e)
}

# rax ve rcx'teki işlenenlerden en az biri ondalık; sayı olan ondalığa çevrilir.
işlev ondalık_ikili(iş, sol_türü, sağ_türü, e) {
    sol_türü == "sayı" -> eğer { yaz("cvtsi2sd xmm0, rax") } değilse { yaz("movq xmm0, rax") }
    sağ_türü == "sayı" -> eğer { yaz("cvtsi2sd xmm1, rcx") } değilse { yaz("movq xmm1, rcx") }
    iş == "/" veya iş == "%" -> eğer {
        sağ_türü == "sayı" -> eğer { yaz("test rcx, rcx") } değilse {
            yaz("mov rdx, rcx")
            yaz("btr rdx, 63")      # 0.0 da -0.0 da sıfırdır
            yaz("test rdx, rdx")
        }
        komut("jz __sifira_bolme", e)
    }
    {"+": "addsd", "-": "subsd", "*": "mulsd", "/": "divsd"} -> komutlar
    var(komutlar, iş) -> eğer {
        yaz(komutlar[iş] + " xmm0, xmm1")
        yaz("movq rax, xmm0")
        "ondalık" -> döndür
    }
    iş == "%" -> eğer {
        yaz("movq rdi, xmm0")
        yaz("movq rsi, xmm1")
        yaz("call __ondalik_kalan")
        "ondalık" -> döndür
    }
    # Karşılaştırmalar: nan hiçbir şeye eşit, küçük ya da büyük değildir.
    iş == "<" veya iş == "<=" -> eğer { yaz("ucomisd xmm1, xmm0") } değilse { yaz("ucomisd xmm0, xmm1") }
    iş == "==" -> eğer {
        yaz("sete al")
        yaz("setnp cl")
        yaz("and al, cl")
    } değilse {
        iş == "!=" -> eğer {
            yaz("setne al")
            yaz("setp cl")
            yaz("or al, cl")
        } değilse {
            iş == "<" veya iş == ">" -> eğer { yaz("seta al") } değilse { yaz("setae al") }
        }
    }
    yaz("movzx eax, al")
    "sayı" -> döndür
}

işlev ikili_üret(e) {
    e.ad -> iş
    e.çocuklar[0] -> sol
    e.çocuklar[1] -> sağ
    iş == "ve" veya iş == "veya" -> eğer {
        # Kısa devre: sonuç her zaman 0 veya 1.
        yeni_etiket() -> son
        sayı_olmalı(ifade_üret(sol), "'" + iş + "' işlecinin sol tarafı", e)
        yaz("test rax, rax")
        yaz("setne al")
        yaz("movzx eax, al")
        iş == "ve" -> eğer { yaz("jz " + son) } değilse { yaz("jnz " + son) }
        sayı_olmalı(ifade_üret(sağ), "'" + iş + "' işlecinin sağ tarafı", e)
        yaz("test rax, rax")
        yaz("setne al")
        yaz("movzx eax, al")
        etiket_koy(son)
        "sayı" -> döndür
    }
    ifade_üret(sol) -> sol_türü
    yaz("push rax")
    ifade_üret(sağ) -> sağ_türü
    yaz("mov rcx, rax")
    yaz("pop rax")
    (iş == "==" veya iş == "!=") ve (kayıtsı(sol_türü) veya kayıtsı(sağ_türü) veya işlev_türü_mü(sol_türü)) -> eğer {
        # Kayıtlar ve işlevler kimlikleriyle karşılaştırılır: aynı kayıt (ya da işlev) mi?
        değil birleştir(sol_türü, sağ_türü) -> eğer {
            k_hata(ham_ad(sol_türü) + " ile " + ham_ad(sağ_türü) + " karşılaştırılamaz", e)
        }
        yaz("cmp rax, rcx")
        yaz(KARŞILAŞTIRMA[iş] + " al")
        yaz("movzx eax, al")
        "sayı" -> döndür
    }
    # Türü henüz bilinmeyen bir işlenen türünü öbür işlenenden ya da işleçten alır.
    bilinmeyen_mi(sol_türü) veya bilinmeyen_mi(sağ_türü) -> eğer {
        iş == "+" veya var(KARŞILAŞTIRMA, iş) -> eğer {
            bilinmeyen_mi(sol_türü) ve bilinmeyen_mi(sağ_türü) -> eğer {
                k_hata_i("'" + iş + "' işlecinin iki tarafının da türü henüz belli değil", e,
                         "kabın içine önce bir değer akmalı")
            }
            birleştir(sol_türü, sağ_türü)
            çöz(sol_türü) -> sol_türü
            çöz(sağ_türü) -> sağ_türü
        }
    }
    sol_türü == "metin" ve sağ_türü == "metin" ve (iş == "+" veya var(KARŞILAŞTIRMA, iş)) -> eğer {
        yaz("mov rdi, rax")
        yaz("mov rsi, rcx")
        iş == "+" -> eğer {
            komut("call __metin_birlestir", e)
            "metin" -> döndür
        }
        yaz("call __metin_karsilastir")
        yaz("test rax, rax")        # işaretli sonuç 0 ile karşılaştırılır
        yaz(KARŞILAŞTIRMA[iş] + " al")
        yaz("movzx eax, al")
        "sayı" -> döndür
    }
    liste_mi(sol_türü) ve liste_mi(sağ_türü) ve (iş == "+" veya iş == "==" veya iş == "!=") -> eğer {
        değil birleştir(sol_türü, sağ_türü) veya (iş != "+" ve sözlük_içerir(sol_türü)) -> eğer {
            " karşılaştırılamaz" -> ne
            iş == "+" -> eğer { " birleştirilemez" -> ne }
            k_hata(ham_ad(sol_türü) + " ile " + ham_ad(sağ_türü) + ne, e)
        }
        yaz("mov rdi, rax")
        yaz("mov rsi, rcx")
        iş == "+" -> eğer {
            komut("call __liste_birlestir", e)
            sol_türü -> döndür
        }
        tür_satırı("rdx", sol_türü)
        yaz("call __deger_esit")
        iş == "!=" -> eğer { yaz("xor eax, 1") }
        "sayı" -> döndür
    }
    sözlük_mi(sol_türü) ve sözlük_mi(sağ_türü) ve (iş == "==" veya iş == "!=") -> eğer {
        k_hata("sözlükler '==' ve '!=' ile karşılaştırılamaz", e)
    }
    liste_mi(sol_türü) ve iş == "+" -> eğer {
        k_hata_i("listeye '+' ile eleman eklenemez", e, "eleman eklemek için:  liste -> ekle(eleman)")
    }
    iş == "+" ve (sol_türü == "metin" veya sağ_türü == "metin")
        ve (sol_türü == "sayı" veya sağ_türü == "sayı" veya sol_türü == "ondalık" veya sağ_türü == "ondalık") -> eğer {
        k_hata_i("metin ile sayı doğrudan toplanamaz", e, "sayıyı önce metne çevirin:  \"a\" + metne(5)")
    }
    sol_türü == "ondalık" veya sağ_türü == "ondalık" -> eğer {
        # Türü bilinmeyen işlenen ondalıktır; sayı ile ondalık karışırsa sayı ondalığa çevrilir.
        bilinmeyen_mi(sol_türü) ve değil yok_mu(sol_türü) -> eğer { "ondalık" -> k_bağ[sol_türü] }
        bilinmeyen_mi(sağ_türü) ve değil yok_mu(sağ_türü) -> eğer { "ondalık" -> k_bağ[sağ_türü] }
        çöz(sol_türü) -> sol_türü
        çöz(sağ_türü) -> sağ_türü
        (sol_türü == "sayı" veya sol_türü == "ondalık") ve (sağ_türü == "sayı" veya sağ_türü == "ondalık") -> eğer {
            ondalık_ikili(iş, sol_türü, sağ_türü, e) -> döndür
        }
    }
    sayı_olmalı(sol_türü, "'" + iş + "' işlecinin sol tarafı", e)
    sayı_olmalı(sağ_türü, "'" + iş + "' işlecinin sağ tarafı", e)
    iş == "+" -> eğer { yaz("add rax, rcx")   "sayı" -> döndür }
    iş == "-" -> eğer { yaz("sub rax, rcx")   "sayı" -> döndür }
    iş == "*" -> eğer { yaz("imul rax, rcx")   "sayı" -> döndür }
    iş == "/" -> eğer {
        komut("call __sayi_bol", e)
        "sayı" -> döndür
    }
    iş == "%" -> eğer {
        komut("call __sayi_kalan", e)
        "sayı" -> döndür
    }
    yaz("cmp rax, rcx")
    yaz(KARŞILAŞTIRMA[iş] + " al")
    yaz("movzx eax, al")
    "sayı" -> döndür
}

# ── program ──

# Metnin UTF-8 baytları ve sonundaki sıfır, assembly'nin `.byte` yazımıyla.
işlev bayt_satırı(m) {
    [] -> parçalar
    m -> baytlar -> her (b) { parçalar -> ekle(metne(b)) }
    parçalar -> ekle("0")
    "    .byte " + birleş(parçalar, ", ") -> döndür
}

# Ağacın kökünden bütün assembly metnini üretir. `çalışma_zamanı`, calisma_zamani.s
# dosyasının içeriğidir.
işlev üret(kök, çalışma_zamanı) {
    # Önce bütün kayıt türleri oluşturulur, sonra alan türleri çözülür; böylece
    # kayıtlar kendilerine ve birbirlerine gönderme yapabilir.
    kök.çocuklar -> her (d) {
        d.tür == "kayıt" -> eğer {
            [] -> alanlar
            [] -> türler
            d.çocuklar -> her (a) {
                alanlar -> ekle(a.ad)
                türler -> ekle(yeni_tür_değişkeni())
            }
            alanlar -> k_kayıt_alanları[d.ad]
            türler -> k_kayıt_türleri[d.ad]
        }
    }
    kök.çocuklar -> her (d) {
        d.tür == "kayıt" -> eğer {
            0 -> i
            d.çocuklar -> her (a) {
                uzunluk(a.çocuklar) > 0 -> eğer { tür_çöz(a.çocuklar[0]) -> k_bağ[k_kayıt_türleri[d.ad][i]] }
                i + 1 -> i
            }
        }
    }
    kök.çocuklar -> her (d) {
        d.tür == "kullan" -> eğer { desteklenmiyor("'" + d.tür + "'", d) }
        d.tür == "işlev" -> eğer {
            d -> k_işlev[d.ad]
            "f" + metne(uzunluk(k_işlev_adları)) -> k_işlev_etiket[d.ad]
            "" -> k_işlev_dönüş[d.ad]
            0 -> k_işlev_durum[d.ad]
            k_işlev_adları -> ekle(d.ad)
        }
    }
    dönmeyenleri_bul()
    küreselleri_topla(kök.çocuklar)

    k_kod -> ekle("nehir_ana:")
    yaz("push rbp")
    yaz("mov rbp, rsp")
    kök.çocuklar -> her (d) { d.tür != "işlev" ve d.tür != "kayıt" -> eğer { deyim_üret(d) } }
    yaz("leave")
    yaz("ret")
    # Değer olarak verilip hiç doğrudan çağrılmamış işlevler en son derlenir. Derlenen
    # işlevler yenilerini ekleyebilir.
    uzunluk(k_değer_işlevler) > 0 -> iken {
        k_değer_işlevler -> sil(0) -> ad
        k_işlev_durum[ad] == 0 -> eğer {
            ad -> k_değer_bağlamı
            işlevi_derle(ad)
            "" -> k_değer_bağlamı
        }
    }
    dönüşleri_denetle()
    k_küreseller -> her (ad) {
        değil var(k_küresel_okundu, ad) ve var(k_küresel_konum, ad) -> eğer {
            okunmayanı_bildir(ad, k_küresel_konum[ad], yanlış)
        }
    }
    # Modüller kitaplıktır; her işlevlerinin kullanılması beklenmez. Ana dosyada çok sayıda
    # çağrılmayan işlev varsa (dosyanın kendisi bir kitaplıksa) tek bir özet uyarı verilir.
    [] -> çağrılmayan
    k_işlev_adları -> her (ad) {
        değil var(k_işlev_türler, ad) ve k_işlev[ad].dosya == 0 -> eğer { çağrılmayan -> ekle(ad) }
    }
    uzunluk(çağrılmayan) > 3 -> eğer {
        uyarı_ekle(k_işlev[çağrılmayan[0]], metne(uzunluk(çağrılmayan)) + " işlev hiç çağrılmıyor ve derlenmedi: '"
                   + çağrılmayan[0] + "', '" + çağrılmayan[1] + "', '" + çağrılmayan[2] + "' ve "
                   + metne(uzunluk(çağrılmayan) - 3) + " işlev daha",
                   "bu dosya bir kitaplıksa (örneğin motor/motor.nehir), onu 'kullan' ile kullanan programı derleyin")
    } değilse {
        çağrılmayan -> her (ad) { uyarı_ekle(k_işlev[ad], "'" + ad + "' işlevi hiç çağrılmıyor; derlenmedi", "") }
    }

    # Ertelenen satırlar (tür tanımları, işlev başlıkları) son sırayla çözülür.
    [] -> kod
    k_kod + k_işlev_kodu -> her (s) {
        dilim(s, 0, 5) == "§TÜR§" -> eğer {
            kod -> ekle("    lea " + dilim(s, 5, 8) + ", [rip+" + tür_etiketi(dilim(s, 8, uzunluk(s))) + "]")
        } değilse {
            dilim(s, 0, 8) == "§BAŞLIK§" -> eğer {
                kod -> ekle(işlev_başlığı(dilim(s, 8, uzunluk(s))))
            } değilse {
                kod -> ekle(s)
            }
        }
    }
    [".intel_syntax noprefix", ".global _start", ".section .text"] + gözetle(kod) -> satırlar
    çalışma_zamanı -> böl("YIGIN_BOYUTU") -> birleş(YIĞIN_BOYUTU) -> çz
    satırlar -> ekle(çz)
    satırlar -> ekle("    .section .rodata")
    satırlar -> ekle("    .balign 8")
    [] -> dosya_etiketleri
    a_dosyalar -> her (yol) { dosya_etiketleri -> ekle(metin_etiketi(yol)) }
    satırlar -> ekle("__dosyalar: .quad " + birleş(dosya_etiketleri, ", "))

    satırlar -> ekle("    .section .rodata")
    0 -> i
    k_metinler -> her (m) {
        satırlar -> ekle("    .balign 8")
        satırlar -> ekle("    .quad " + metne(uzunluk(baytlar(m))))
        satırlar -> ekle("m" + metne(i) + ":")
        satırlar -> ekle(bayt_satırı(m))
        i + 1 -> i
    }
    # Küresel değişkenler çalışma zamanının .bss'inden hemen sonra gelir; çöp toplayıcı
    # __kokler_bas ile __kokler_son arasını kök sayar.
    satırlar -> ekle("    .section .bss")
    k_küreseller -> her (ad) { satırlar -> ekle(k_küresel_etiket[ad] + ": .skip 8    # " + ad) }
    satırlar -> ekle("__kokler_son:")
    uzunluk(k_tür_tanımları) > 0 -> eğer {
        satırlar -> ekle("    .section .rodata")
        satırlar -> ekle("    .balign 8")
        satırlar + k_tür_tanımları -> satırlar
    }
    uzunluk(k_ondalıklar) > 0 -> eğer {
        satırlar -> ekle("    .section .rodata")
        satırlar -> ekle("    .balign 8")
        0 -> i
        k_ondalıklar -> her (yazım) {
            satırlar -> ekle("d" + metne(i) + ": .double " + yazım)
            i + 1 -> i
        }
    }
    birleş(satırlar, "\n") + "\n" -> döndür
}
