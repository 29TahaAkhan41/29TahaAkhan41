# Bir Nehir dosyasının sözcüklerini döker.
#
#   kullanım: sozcuk_dok <dosya.nehir>
#
# Çıktısı `nehir.py <dosya> --sözcükler` ile bire bir aynıdır.

kullan "sozcukleyici.nehir"

işlev ana() {
    argümanlar() -> a
    uzunluk(a) != 1 -> eğer {
        "kullanım: sozcuk_dok <dosya.nehir>" -> uyar
        çık(2)
    }
    a[0] -> l_dosya
    kaynağı_oku(l_dosya) -> okuma_hatası
    okuma_hatası != "" -> eğer {
        konumsuz_bildir("hata", "dosya okunamadı: " + okuma_hatası, l_dosya)
        çık(1)
    }
    l_okunan -> sözcükle
    dök()
}

ana()
