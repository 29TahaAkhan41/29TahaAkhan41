# Bir Nehir dosyasının sözcüklerini döker.
#
#   kullanım: sozcuk_dok <dosya.nehir>
#
# Çıktısı `nehir.py <dosya> --sözcükler` ile bire bir aynıdır.

kullan "sozcukleyici.nehir"

işlev ana() {
    argümanlar() -> a
    uzunluk(a) != 1 -> eğer {
        "kullanım: sozcuk_dok <dosya.nehir>" -> uyar
        çık(2)
    }
    a[0] -> l_dosya
    değil dosya_var(l_dosya) -> eğer {
        l_dosya + ": hata: dosya okunamadı" -> uyar
        çık(1)
    }
    l_dosya -> dosya_oku -> sözcükle
    dök()
}

ana()
