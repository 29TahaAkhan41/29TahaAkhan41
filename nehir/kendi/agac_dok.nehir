# Bir Nehir dosyasının sözdizimi ağacını döker.
#
#   kullanım: agac_dok <dosya.nehir>
#
# Çıktısı `nehir.py <dosya> --ağaç` ile bire bir aynıdır.

kullan "ayristirici.nehir"

işlev ana() {
    argümanlar() -> a
    uzunluk(a) != 1 -> eğer {
        "kullanım: agac_dok <dosya.nehir>" -> uyar
        çık(2)
    }
    a[0] -> l_dosya
    kaynağı_oku(l_dosya) -> okuma_hatası
    okuma_hatası != "" -> eğer {
        konumsuz_bildir("hata", "dosya okunamadı: " + okuma_hatası, l_dosya)
        çık(1)
    }
    l_okunan -> sözcükle
    program() -> ağaç_dök("")
}

ana()
