# Nehir ile yazılmış Nehir derleyicisi: kaynak dosyadan assembly üretir.
#
#   kullanım: derle <dosya.nehir> <çıktı.s> [calisma_zamani.s]
#
# Çıktısı `nehir.py <dosya> --asm -o <çıktı.s>` ile bayt bayt aynıdır. Henüz
# taşınmamış bir yapıyla karşılaşırsa "henüz desteklenmiyor" der ve 3 ile çıkar.
# Assembly'yi çalıştırılabilir dosyaya çevirmek için:
#   as -o program.o program.s && ld -o program program.o

kullan "kod_uretici.nehir"

işlev ana() {
    argümanlar() -> a
    uzunluk(a) < 2 veya uzunluk(a) > 3 -> eğer {
        "kullanım: derle <dosya.nehir> <çıktı.s> [calisma_zamani.s]" -> uyar
        çık(2)
    }
    "calisma_zamani.s" -> çalışma_zamanı_yolu
    uzunluk(a) == 3 -> eğer { a[2] -> çalışma_zamanı_yolu }
    a[0] -> l_dosya
    değil dosya_var(çalışma_zamanı_yolu) -> eğer {
        konumsuz_bildir("hata", "çalışma zamanı okunamadı: dosya bulunamadı", çalışma_zamanı_yolu)
        çık(1)
    }
    kaynağı_oku(l_dosya) -> okuma_hatası
    okuma_hatası != "" -> eğer {
        konumsuz_bildir("hata", "dosya okunamadı: " + okuma_hatası, l_dosya)
        çık(1)
    }
    doğru -> a_modül_yükle
    l_okunan -> sözcükle
    program() -> üret(dosya_oku(çalışma_zamanı_yolu)) -> assembly
    uyarıları_yaz()
    assembly -> dosya_yaz(a[1])
}

ana()
