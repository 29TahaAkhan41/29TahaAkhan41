# Nehir ayrıştırıcısı — Nehir ile yazılmış.
#
# nehir.py içindeki `Ayrıştırıcı` sınıfının karşılığıdır: sözcükleyicinin ürettiği
# sözcüklerden sözdizimi ağacını kurar. Kendi kendini derleyen derleyicinin ikinci aşaması.
#
#   kullan "ayristirici.nehir"
#   "program.nehir" -> l_dosya
#   l_dosya -> dosya_oku -> sözcükle
#   program() -> ağaç

kullan "sozcukleyici.nehir"

# ── ağaç ──
# Bütün düğümler tek bir kayıt türündendir. `tür` düğümün ne olduğunu söyler; `ad`
# ve `sayı` düğüme özgü yükü (değişken adı, işleç, sayının değeri) taşır.
#
#   İfadeler:  sayı  metin  değişken  çağrı  liste  sözlük  dizin  alan  yok  tekli  ikili
#   Deyimler:  akış (ilk çocuk kaynak ifade, sonrakiler hedefler)  dur  devam  kullan
#   Hedefler:  yazdır  döndür  hedef_ad  ortak  eleman  alan_yaz  eğer  iken  her  çatal (çocukları: dal)
#   Tanımlar:  işlev (çocukları: param..., blok)   kayıt (çocukları: alan_tanımı)
#   Türler:    tür_adı  tür_liste  tür_sözlük

kayıt Düğüm {
    tür: metin, ad: metin, sayı: sayı, çocuklar: [Düğüm],
    satır: sayı, sütun: sayı, uzunluk: sayı, dosya: sayı
}

# ── durum ──

0 -> ortak a_k            # sıradaki sözcüğün dizini
[] -> a_dosyalar          # derlemedeki dosyalar, numaralarına göre (0 ana dosya)
{} -> a_yüklenen          # yüklenmiş dosyalar (normalleştirilmiş yol)
yanlış -> ortak a_modül_yükle   # `kullan` modülü yüklesin mi, yoksa düğüm olarak mı kalsın
[] -> a_işlevler    # işlev düğümleri, tanımlanma sırasıyla
[] -> a_kayıtlar    # kayıt düğümleri
{} -> a_adlar       # tanımlı ad -> "işlev" ya da "kayıt"
{} -> a_ad_düğümü   # tanımlı ad -> tanımının düğümü (ad çakışmasında "ilk tanım burada")

# ── yardımcılar ──

# "İlgili ikinci bir yer yok" anlamında kullanılan düğüm.
Düğüm("", "", 0, [], 0, 0, 0, 0) -> İLGİSİZ

# Hatayı (ve varsa ilgili ikinci yeri bir not olarak) yazar ve derlemeyi bitirir.
işlev hata_ver(mesaj, dosya, satır, sütun, boy, ipucu, ilgili, ilgili_not) {
    bildir("hata", mesaj, dosya, satır, sütun, boy, ipucu)
    ilgili != İLGİSİZ -> eğer {
        bildir("not", ilgili_not, ilgili.dosya, ilgili.satır, ilgili.sütun, ilgili.uzunluk, "")
    }
    çık(1)
}

işlev hata_düğümde(mesaj, d, ipucu) { hata_ver(mesaj, d.dosya, d.satır, d.sütun, d.uzunluk, ipucu, İLGİSİZ, "") }

# k. sözcüğün konumunda hata verir.
işlev hata_sözcükte(mesaj, k) { hata_sözcükte_i(mesaj, k, "") }
işlev hata_sözcükte_i(mesaj, k, ipucu) {
    hata_ver(mesaj, s_dosya[k], s_satır[k], s_sütun[k], s_uzunluk[k], ipucu, İLGİSİZ, "")
}

# Konumu k. sözcükten alan, çocuksuz yeni bir düğüm.
işlev düğüm(tür, ad, k) {
    Düğüm(tür, ad, 0, [], s_satır[k], s_sütun[k], s_uzunluk[k], s_dosya[k]) -> döndür
}

işlev bulunan() {
    s_tür[a_k] == "SON" -> eğer { "dosya sonu" -> döndür }
    "'" + s_yazım[a_k] + "'" -> döndür
}

# Sıradaki sözcük bu türde mi? `değer` boş değilse değeri de tutmalı.
işlev bak(tür, değer) {
    s_tür[a_k] == tür ve (değer == "" veya s_değer[a_k] == değer) -> döndür
}

# Sıradaki sözcük uyuyorsa onu tüketir.
işlev al(tür, değer) {
    bak(tür, değer) -> eğer {
        a_k + 1 -> a_k
        doğru -> döndür
    }
    yanlış -> döndür
}

# Sıradaki sözcük uymak zorundadır; tüketir ve dizinini verir.
işlev bekle(tür, değer) {
    a_k -> k
    al(tür, değer) -> eğer { k -> döndür }
    tür -> beklenen
    tür == "AD" -> eğer { "bir ad" -> beklenen }
    değer != "" -> eğer { "'" + değer + "'" -> beklenen }
    hata_sözcükte(beklenen + " bekleniyordu, " + bulunan() + " bulundu", a_k)
}

# Ardıl '(' ve '[' yalnızca aynı satırdaysa önceki ifadeye bağlanır; böylece
# yeni satırda '[' ya da '(' ile başlayan deyim ayrı kalır.
işlev aynı_satırda(değer) { bak("İŞLEÇ", değer) ve değil s_yeni[a_k] -> döndür }

# Bu hedeflerden sonra akış devam etmez.
işlev sonlandıran_mı(tür) {
    tür == "eğer" veya tür == "iken" veya tür == "her" veya tür == "döndür" -> döndür
}

# ── tanımlar ──

# Yeni bir işlev ya da kayıt adı. Yerleşik bir işlevle aynı olabilir; o zaman
# programın kendi tanımı yerleşik olanı gölgeler.
işlev yeni_ad(k) {
    s_değer[k] -> ad
    a_adlar -> var(ad) -> eğer {
        a_ad_düğümü[ad] -> ilk
        hata_ver("'" + ad + "' adı zaten bir " + a_adlar[ad] + " için kullanılmış",
                 s_dosya[k], s_satır[k], s_sütun[k], s_uzunluk[k], "", ilk, "ilk tanım burada")
    }
    ad -> döndür
}

# Tür adı:  sayı | metin | KayıtAdı | [Tür] | {Tür: Tür}
işlev tür_ifadesi() {
    a_k -> k
    al("İŞLEÇ", "[") -> eğer {
        düğüm("tür_liste", "", k) -> d
        d.çocuklar -> ekle(tür_ifadesi())
        bekle("İŞLEÇ", "]")
        d -> döndür
    }
    al("İŞLEÇ", "{") -> eğer {
        düğüm("tür_sözlük", "", k) -> d
        d.çocuklar -> ekle(tür_ifadesi())
        bekle("İŞLEÇ", ":")
        d.çocuklar -> ekle(tür_ifadesi())
        bekle("İŞLEÇ", "}")
        d -> döndür
    }
    al("AD", "") -> eğer { düğüm("tür_adı", s_değer[k], k) -> döndür }
    hata_sözcükte_i("bir tür bekleniyordu, " + bulunan() + " bulundu", k,
                    "türler: sayı, metin, bir kayıt adı, [Tür], {Tür: Tür}")
}

# kayıt Ad { alan, alan: Tür, ... }
işlev kayıt_tanımı() {
    bekle("ANAHTAR", "kayıt")
    bekle("AD", "") -> ad_k
    yeni_ad(ad_k) -> ad
    bekle("İŞLEÇ", "{")
    düğüm("kayıt", ad, ad_k) -> kayıt_d
    {} -> görülen
    değil bak("İŞLEÇ", "}") -> iken {
        bekle("AD", "") -> alan_k
        s_değer[alan_k] -> alan_adı
        görülen -> var(alan_adı) -> eğer {
            hata_sözcükte("'" + ad + "' kaydında '" + alan_adı + "' alanı iki kez tanımlanmış", alan_k)
        }
        1 -> görülen[alan_adı]
        düğüm("alan_tanımı", alan_adı, alan_k) -> alan_d
        al("İŞLEÇ", ":") -> eğer { alan_d.çocuklar -> ekle(tür_ifadesi()) }
        kayıt_d.çocuklar -> ekle(alan_d)
        değil al("İŞLEÇ", ",") -> eğer { dur }
    }
    bekle("İŞLEÇ", "}")
    "kayıt" -> a_adlar[ad]
    kayıt_d -> a_ad_düğümü[ad]
    a_kayıtlar -> ekle(kayıt_d)
}

işlev işlev_tanımı() {
    bekle("ANAHTAR", "işlev")
    bekle("AD", "") -> ad_k
    yeni_ad(ad_k) -> ad
    bekle("İŞLEÇ", "(")
    düğüm("işlev", ad, ad_k) -> işlev_d
    {} -> görülen
    yanlış -> yinelenen
    değil bak("İŞLEÇ", ")") -> eğer {
        doğru -> iken {
            bekle("AD", "") -> p_k
            görülen -> var(s_değer[p_k]) -> eğer { doğru -> yinelenen }
            1 -> görülen[s_değer[p_k]]
            işlev_d.çocuklar -> ekle(düğüm("param", s_değer[p_k], ad_k))
            değil al("İŞLEÇ", ",") -> eğer { dur }
        }
    }
    bekle("İŞLEÇ", ")")
    yinelenen -> eğer {
        hata_sözcükte("'" + ad + "' işlevinde aynı parametre adı iki kez kullanılmış", ad_k)
    }
    "işlev" -> a_adlar[ad]      # gövdeden önce kaydedilir: işlev kendini çağırabilir
    işlev_d -> a_ad_düğümü[ad]
    a_işlevler -> ekle(işlev_d)
    işlev_d.çocuklar -> ekle(blok(ad_k))
}

# ── deyimler ──

# { deyim* } — blok düğümü, konumunu ait olduğu yapıdan (konum_k) alır.
işlev blok(konum_k) {
    bekle("İŞLEÇ", "{") -> açılış
    düğüm("blok", "", konum_k) -> b
    değil bak("İŞLEÇ", "}") -> iken {
        bak("ANAHTAR", "işlev") -> eğer {
            hata_sözcükte("işlevler yalnızca en üst düzeyde tanımlanabilir", a_k)
        }
        bak("SON", "") -> eğer { hata_sözcükte_i("bu blok kapatılmamış", açılış, "eşleşen '}' eksik") }
        b.çocuklar -> ekle(deyim())
    }
    bekle("İŞLEÇ", "}")
    b -> döndür
}

işlev deyim() {
    a_k -> k
    al("ANAHTAR", "dur") -> eğer { düğüm("dur", "", k) -> döndür }
    al("ANAHTAR", "devam") -> eğer { düğüm("devam", "", k) -> döndür }
    düğüm("akış", "", k) -> d
    d.çocuklar -> ekle(ifade())
    zincir(d)
    d -> döndür
}

# Sıfır ya da daha çok '-> hedef'; hedefler d'nin çocuklarına eklenir.
işlev zincir(d) {
    al("İŞLEÇ", "->") -> iken {
        hedef() -> h
        d.çocuklar -> ekle(h)
        sonlandıran_mı(h.tür) -> eğer { dur }
    }
}

işlev hedef() {
    a_k -> k
    al("ANAHTAR", "yazdır") -> eğer { düğüm("yazdır", "", k) -> döndür }
    al("ANAHTAR", "döndür") -> eğer { düğüm("döndür", "", k) -> döndür }
    al("ANAHTAR", "ortak") -> eğer {
        bekle("AD", "") -> ad_k
        düğüm("ortak", s_değer[ad_k], ad_k) -> döndür
    }
    al("ANAHTAR", "eğer") -> eğer {
        düğüm("eğer", "", k) -> d
        d.çocuklar -> ekle(blok(k))
        al("ANAHTAR", "değilse") -> eğer { d.çocuklar -> ekle(blok(k)) }
        d -> döndür
    }
    al("ANAHTAR", "iken") -> eğer {
        düğüm("iken", "", k) -> d
        d.çocuklar -> ekle(blok(k))
        d -> döndür
    }
    al("ANAHTAR", "her") -> eğer {
        bekle("İŞLEÇ", "(")
        bekle("AD", "") -> değişken_k
        bekle("İŞLEÇ", ")")
        düğüm("her", s_değer[değişken_k], k) -> d
        d.çocuklar -> ekle(blok(k))
        d -> döndür
    }
    al("İŞLEÇ", "(") -> eğer {
        düğüm("çatal", "", k) -> d
        d.çocuklar -> ekle(dal(k))
        al("İŞLEÇ", "|") -> iken { d.çocuklar -> ekle(dal(k)) }
        bekle("İŞLEÇ", ")")
        d -> döndür
    }
    al("AD", "") -> eğer {
        aynı_satırda("(") -> eğer {
            düğüm("hedef_ad", s_değer[k], k) -> d
            düğüm("argümanlar", "", k) -> arg_d
            argüman_listesi(arg_d)
            d.çocuklar -> ekle(arg_d)
            d -> döndür
        }
        değil (aynı_satırda("[") veya bak("İŞLEÇ", ".")) -> eğer {
            düğüm("hedef_ad", s_değer[k], k) -> döndür
        }
        # a[i].x[j] gibi bir hedefte son erişim yazılacak yerdir; öncekiler okunur.
        düğüm("değişken", s_değer[k], k) -> kap
        kap -> son
        doğru -> iken {
            al("İŞLEÇ", ".") -> eğer {
                bekle("AD", "") -> alan_k
                düğüm("alan", s_değer[alan_k], alan_k) -> son
                son.çocuklar -> ekle(kap)
            } değilse {
                bekle("İŞLEÇ", "[") -> köşe_k
                düğüm("dizin", "", köşe_k) -> son
                son.çocuklar -> ekle(kap)
                son.çocuklar -> ekle(ifade())
                bekle("İŞLEÇ", "]")
            }
            değil (aynı_satırda("[") veya bak("İŞLEÇ", ".")) -> eğer { dur }
            son -> kap
        }
        son.tür == "alan" -> eğer {
            "alan_yaz" -> son.tür
            son -> döndür
        }
        "eleman" -> son.tür
        s_satır[k] -> son.satır
        s_sütun[k] -> son.sütun
        s_uzunluk[k] -> son.uzunluk
        son -> döndür
    }
    hata_sözcükte_i("'->' sonrasında bir hedef bekleniyordu, " + bulunan() + " bulundu", k,
                    "hedef olabilenler: değişken, işlev, yazdır, döndür, eğer, iken, her, ( çatal )")
}

# Çatalın bir kolu:  hedef (-> hedef)*
işlev dal(konum_k) {
    düğüm("dal", "", konum_k) -> d
    hedef() -> h
    d.çocuklar -> ekle(h)
    değil sonlandıran_mı(h.tür) -> eğer { zincir(d) }
    d.çocuklar -> her (x) {
        x.tür == "iken" veya x.tür == "her" -> eğer {
            hata_düğümde("çatalın kolunda '" + x.tür + "' kullanılamaz", x, "")
        }
    }
    d -> döndür
}

# ── ifadeler ──
# Öncelik düşükten yükseğe: veya, ve, değil, karşılaştırma, + -, * / %, tekli eksi

# ( ifade, ... ) — ifadeler d'nin çocuklarına eklenir.
işlev argüman_listesi(d) {
    bekle("İŞLEÇ", "(")
    ifade_listesi(d, ")")
    bekle("İŞLEÇ", ")")
}

işlev ifade_listesi(d, kapanış) {
    değil bak("İŞLEÇ", kapanış) -> eğer {
        d.çocuklar -> ekle(ifade())
        al("İŞLEÇ", ",") -> iken { d.çocuklar -> ekle(ifade()) }
    }
}

işlev ikili(işleç, sol, sağ, k) {
    düğüm("ikili", işleç, k) -> d
    d.çocuklar -> ekle(sol)
    d.çocuklar -> ekle(sağ)
    d -> döndür
}

işlev ifade() {
    ve_ifadesi() -> sol
    doğru -> iken {
        a_k -> k
        değil al("ANAHTAR", "veya") -> eğer { dur }
        ikili("veya", sol, ve_ifadesi(), k) -> sol
    }
    sol -> döndür
}

işlev ve_ifadesi() {
    değil_ifadesi() -> sol
    doğru -> iken {
        a_k -> k
        değil al("ANAHTAR", "ve") -> eğer { dur }
        ikili("ve", sol, değil_ifadesi(), k) -> sol
    }
    sol -> döndür
}

işlev değil_ifadesi() {
    a_k -> k
    al("ANAHTAR", "değil") -> eğer {
        düğüm("tekli", "değil", k) -> d
        d.çocuklar -> ekle(değil_ifadesi())
        d -> döndür
    }
    karşılaştırma() -> döndür
}

# Bir öncelik düzeyi: alt düzeyin ifadelerini bu düzeyin işleçleriyle soldan
# birleştirir. `alt` bir işlevdir; her düzey bir alttakini verir.
işlev ikili_düzey(alt, işleçler) {
    alt() -> sol
    doğru -> iken {
        a_k -> k
        değil (s_tür[k] == "İŞLEÇ" ve var(işleçler, s_değer[k])) -> eğer { dur }
        s_değer[k] == "-" ve s_yeni[k] -> eğer { dur }   # satır başındaki '-' yeni bir deyimin eksi işaretidir
        a_k + 1 -> a_k
        ikili(s_değer[k], sol, alt(), k) -> sol
    }
    sol -> döndür
}

işlev karşılaştırma() {
    ikili_düzey(toplama, {"==": 1, "!=": 1, "<": 1, ">": 1, "<=": 1, ">=": 1}) -> döndür
}
işlev toplama() { ikili_düzey(çarpma, {"+": 1, "-": 1}) -> döndür }
işlev çarpma() { ikili_düzey(tekli, {"*": 1, "/": 1, "%": 1}) -> döndür }

işlev tekli() {
    a_k -> k
    al("İŞLEÇ", "-") -> eğer {
        düğüm("tekli", "-", k) -> d
        d.çocuklar -> ekle(tekli())
        d -> döndür
    }
    ardıl() -> döndür
}

# birincil ifadenin ardından gelen [dizin] ve .alan erişimleri
işlev ardıl() {
    birincil() -> e
    doğru -> iken {
        a_k -> k
        aynı_satırda("[") -> eğer {
            a_k + 1 -> a_k
            düğüm("dizin", "", k) -> d
            d.çocuklar -> ekle(e)
            d.çocuklar -> ekle(ifade())
            bekle("İŞLEÇ", "]")
            d -> e
            devam
        }
        al("İŞLEÇ", ".") -> eğer {
            bekle("AD", "") -> alan_k
            düğüm("alan", s_değer[alan_k], alan_k) -> d
            d.çocuklar -> ekle(e)
            d -> e
            devam
        }
        dur
    }
    e -> döndür
}

işlev birincil() {
    a_k -> k
    al("SAYI", "") -> eğer {
        düğüm("sayı", "", k) -> d
        sayıya(s_değer[k]) -> d.sayı
        d -> döndür
    }
    al("ONDALIK", "") -> eğer { düğüm("ondalık", s_değer[k], k) -> döndür }
    al("METİN", "") -> eğer { düğüm("metin", s_değer[k], k) -> döndür }
    al("ANAHTAR", "doğru") -> eğer {
        düğüm("sayı", "", k) -> d
        1 -> d.sayı
        d -> döndür
    }
    al("ANAHTAR", "yanlış") -> eğer { düğüm("sayı", "", k) -> döndür }
    al("ANAHTAR", "yok") -> eğer { düğüm("yok", "", k) -> döndür }
    al("AD", "") -> eğer {
        aynı_satırda("(") -> eğer {
            düğüm("çağrı", s_değer[k], k) -> d
            argüman_listesi(d)
            d -> döndür
        }
        düğüm("değişken", s_değer[k], k) -> döndür
    }
    al("İŞLEÇ", "(") -> eğer {
        ifade() -> iç
        bekle("İŞLEÇ", ")")
        iç -> döndür
    }
    al("İŞLEÇ", "[") -> eğer {
        düğüm("liste", "", k) -> d
        ifade_listesi(d, "]")
        bekle("İŞLEÇ", "]")
        d -> döndür
    }
    al("İŞLEÇ", "{") -> eğer {
        düğüm("sözlük", "", k) -> d
        değil bak("İŞLEÇ", "}") -> iken {
            d.çocuklar -> ekle(ifade())
            bekle("İŞLEÇ", ":")
            d.çocuklar -> ekle(ifade())
            değil al("İŞLEÇ", ",") -> eğer { dur }
        }
        bekle("İŞLEÇ", "}")
        d -> döndür
    }
    hata_sözcükte_i("bir ifade bekleniyordu, " + bulunan() + " bulundu", k, ifade_ipucu(k))
}

# Bir ifadenin beklendiği yerde başka dillerden kalma bir alışkanlık varsa ne yapılacağı.
işlev ifade_ipucu(k) {
    s_tür[k] != "ANAHTAR" -> eğer { "" -> döndür }
    s_değer[k] -> a
    s_yazım[k] -> y
    a == "yazdır" veya a == "döndür" veya a == "eğer" veya a == "iken" veya a == "her" -> eğer {
        "değer" -> kaynak
        "" -> blok_kalıbı
        a == "her" -> eğer {
            "liste" -> kaynak
            " (x) { ... }" -> blok_kalıbı
        }
        a == "eğer" veya a == "iken" -> eğer {
            "koşul" -> kaynak
            " { ... }" -> blok_kalıbı
        }
        "'" + y + "' bir hedeftir; değer ona soldan akar:  " + kaynak + " -> " + y + blok_kalıbı -> döndür
    }
    a == "ortak" -> eğer { "'" + y + "' bir hedefin başına yazılır:  değer -> " + y + " ad" -> döndür }
    a == "kullan" veya a == "işlev" veya a == "kayıt" -> eğer {
        "'" + y + "' yalnızca dosyanın en üst düzeyinde kullanılabilir" -> döndür
    }
    a == "değilse" -> eğer { "'" + y + "' yalnızca bir 'eğer' bloğunun hemen ardından gelebilir" -> döndür }
    "" -> döndür
}

# ── program ──

# Bütün dosyayı ayrıştırır. Kök düğümün çocukları: önce kayıtlar, sonra işlevler,
# sonra üst düzey deyimler. a_modül_yükle doğruysa `kullan` edilen modüller o noktada
# yüklenir: işlevleri ve kayıtları ortak listelere girer, üst düzey deyimleri araya
# eklenir. Değilse (ağaç dökümünde) `kullan` yalnızca bir düğüm olarak kalır.
işlev program() {
    uzunluk(a_dosyalar) == 0 -> eğer {
        a_dosyalar -> ekle(l_dosya)
        1 -> a_yüklenen[normal_yol(ayraçları_düzelt(l_dosya))]
    }
    Düğüm("program", "", 0, [], 0, 0, 0, 0) -> kök
    üst_düzey() -> deyimler
    a_kayıtlar + a_işlevler + deyimler -> kök.çocuklar
    kök -> döndür
}

# Sıradaki sözcükten dosyanın SON'una dek üst düzeyi ayrıştırır; deyimleri verir.
işlev üst_düzey() {
    [] -> deyimler
    değil bak("SON", "") -> iken {
        bak("ANAHTAR", "işlev") -> eğer {
            işlev_tanımı()
            devam
        }
        bak("ANAHTAR", "kayıt") -> eğer {
            kayıt_tanımı()
            devam
        }
        a_k -> k
        al("ANAHTAR", "kullan") -> eğer {
            bekle("METİN", "") -> yol_k
            a_modül_yükle -> eğer { deyimler + modül_yükle(s_değer[yol_k], yol_k) -> deyimler } değilse {
                deyimler -> ekle(düğüm("kullan", s_değer[yol_k], yol_k))
            }
            devam
        }
        deyimler -> ekle(deyim())
    }
    deyimler -> döndür
}

# ── modüller ──

# Modülü yükler ve üst düzey deyimlerini verir. Yol, `kullan` yazan dosyanın dizinine
# göredir. Her modül bir kez yüklenir; modüller birbirini karşılıklı kullanabilir.
işlev modül_yükle(ad, k) {
    normal_yol(yol_birleştir(dizin_adı(ayraçları_düzelt(a_dosyalar[s_dosya[k]])), ayraçları_düzelt(ad))) -> yol
    a_yüklenen -> var(yol) -> eğer { [] -> döndür }
    1 -> a_yüklenen[yol]
    kaynağı_oku(yol) -> okuma_hatası
    okuma_hatası != "" -> eğer {
        hata_sözcükte_i("'" + yol + "' modülü okunamadı: " + okuma_hatası, k,
                        "yol, 'kullan' yazan dosyanın bulunduğu dizine göredir")
    }

    a_k -> saklı_k
    l_dosya -> saklı_dosya
    yol -> l_dosya
    uzunluk(a_dosyalar) -> l_dosya_no
    a_dosyalar -> ekle(yol)
    uzunluk(s_tür) -> a_k                # modülün sözcükleri listelerin sonuna eklenir
    l_okunan -> sözcükle
    üst_düzey() -> deyimler
    saklı_k -> a_k
    saklı_dosya -> l_dosya
    deyimler -> döndür
}

# Windows'ta yollarda '\' de ayraçtır; yol işlemlerinden önce '/'ye çevrilir.
işlev ayraçları_düzelt(yol) {
    işletim_sistemi() == "windows" -> eğer { yol -> böl("\\") -> birleş("/") -> döndür }
    yol -> döndür
}

# Yol işlemleri (Python'un posixpath.dirname, join ve normpath'inin karşılıkları)

işlev dizin_adı(yol) {
    -1 -> son
    0 -> i
    yol -> her (k) {
        k == "/" -> eğer { i -> son }
        i + 1 -> i
    }
    dilim(yol, 0, son + 1) -> baş
    # Sondaki '/'ler atılır; yalnızca '/'den oluşuyorsa (kök) olduğu gibi kalır.
    uzunluk(baş) -> n
    n > 0 -> eğer {
        doğru -> hep_ayraç
        baş -> her (k) { k != "/" -> eğer { yanlış -> hep_ayraç } }
        değil hep_ayraç -> eğer {
            n > 0 ve baş[n - 1] == "/" -> iken { n - 1 -> n }
            dilim(baş, 0, n) -> baş
        }
    }
    baş -> döndür
}

işlev yol_birleştir(a, b) {
    dilim(b, 0, 1) == "/" -> eğer { b -> döndür }
    a == "" -> eğer { b -> döndür }
    dilim(a, uzunluk(a) - 1, uzunluk(a)) == "/" -> eğer { a + b -> döndür }
    a + "/" + b -> döndür
}

işlev normal_yol(yol) {
    yol == "" -> eğer { "." -> döndür }
    0 -> başta
    dilim(yol, 0, 1) == "/" -> eğer {
        1 -> başta
        dilim(yol, 0, 2) == "//" ve dilim(yol, 0, 3) != "///" -> eğer { 2 -> başta }
    }
    [] -> parçalar
    yol -> böl("/") -> her (p) {
        p == "" veya p == "." -> eğer { devam }
        p != ".." veya (başta == 0 ve uzunluk(parçalar) == 0)
            veya (uzunluk(parçalar) > 0 ve parçalar[uzunluk(parçalar) - 1] == "..") -> eğer {
            parçalar -> ekle(p)
        } değilse {
            uzunluk(parçalar) > 0 -> eğer { parçalar -> sil(uzunluk(parçalar) - 1) }
        }
    }
    birleş(parçalar, "/") -> sonuç
    başta == 1 -> eğer { "/" + sonuç -> sonuç }
    başta == 2 -> eğer { "//" + sonuç -> sonuç }
    sonuç == "" -> eğer { "." -> döndür }
    sonuç -> döndür
}

# ── döküm ──
# Ağacı girintili satırlara döker (nehir.py --ağaç ile aynı biçim):
#   tür "ad" sayı @satır:sütun:uzunluk

işlev ağaç_dök(d, girinti) {
    girinti + d.tür + " \"" + kaçır(d.ad) + "\" " + metne(d.sayı)
        + " @" + metne(d.satır) + ":" + metne(d.sütun) + ":" + metne(d.uzunluk) -> yazdır
    d.çocuklar -> her (ç) { ağaç_dök(ç, girinti + "  ") }
}
