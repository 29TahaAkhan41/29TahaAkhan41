{
    "Format": "2.0.0",
    "Changes": [
        // 1) Harita dosyasini oyuna yukle
        {
            "Action": "Load",
            "Target": "Maps/{{ModId}}_Koy",
            "FromFile": "assets/Cinarkoy.tmx"
        },

        // 2) Koyu yeni bir konum olarak kaydet
        {
            "Action": "EditData",
            "Target": "Data/Locations",
            "Entries": {
                "{{ModId}}_Koy": {
                    "DisplayName": "{{i18n: konum.ad}}",
                    "DefaultArrivalTile": { "X": 10, "Y": 22 },
                    "CreateOnLoad": {
                        "MapPath": "Maps/{{ModId}}_Koy"
                    }
                }
            }
        },

        // 3) Vagon agina "Cinarkoy" duragini ekle (gidis)
        {
            "Action": "EditData",
            "Target": "Data/Minecarts",
            "TargetField": [ "Default", "Destinations" ],
            "Entries": {
                "{{ModId}}_Koy": {
                    "Id": "{{ModId}}_Koy",
                    "DisplayName": "{{i18n: konum.ad}}",
                    "TargetLocation": "{{ModId}}_Koy",
                    "TargetTile": { "X": 6, "Y": 22 },
                    "TargetDirection": "down"
                }
            }
        },

        // 4) Koydeki vagona tiklaninca vagon menusunu ac (donus)
        {
            "Action": "EditMap",
            "Target": "Maps/{{ModId}}_Koy",
            "MapTiles": [
                {
                    "Position": { "X": 6, "Y": 20 },
                    "Layer": "Buildings",
                    "SetProperties": {
                        "Action": "MinecartTransport Default {{ModId}}_Koy"
                    }
                }
            ]
        },

        // 5) Otobus duragina, ciftlik cikisindaki yolun ust kenarina, cime tabela koy (yuruyerek gidis)
        {
            "Action": "EditMap",
            "Target": "Maps/BusStop",
            "FromFile": "assets/Tabela.tmx",
            "ToArea": { "X": 14, "Y": 21, "Width": 1, "Height": 2 },
            "PatchMode": "Overlay"
        },
        {
            "Action": "EditMap",
            "Target": "Maps/BusStop",
            "MapTiles": [
                {
                    "Position": { "X": 14, "Y": 22 },
                    "Layer": "Buildings",
                    "SetProperties": {
                        "Action": "Warp 10 22 {{ModId}}_Koy"
                    }
                }
            ]
        },

        // 6) Koydeki tabelaya tiklaninca otobus duragina don
        {
            "Action": "EditMap",
            "Target": "Maps/{{ModId}}_Koy",
            "MapTiles": [
                {
                    "Position": { "X": 10, "Y": 21 },
                    "Layer": "Buildings",
                    "SetProperties": {
                        "Action": "Warp 12 24 BusStop"
                    }
                }
            ]
        }
    ]
}
